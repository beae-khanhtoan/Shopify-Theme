{% doc %}
  Renders a semantic button or link using the global button variant contract.
{% enddoc %}

{% if block.settings.link != blank %}
  <a class="button button--{{ block.settings.style }}" href="{{ block.settings.link }}"{% if block.settings.open_in_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %} {{ block.shopify_attributes }}>
    {{ block.settings.label | escape }}
  </a>
{% else %}
  <button class="button button--{{ block.settings.style }}" type="button" {{ block.shopify_attributes }}>
    {{ block.settings.label | escape }}
  </button>
{% endif %}

{% stylesheet %}
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding-inline: 1.25rem;
    border-radius: var(--radius-buttons-inputs);
    font: inherit;
    text-decoration: none;
    cursor: pointer;
  }
  .button--primary { background: var(--color-primary-button); color: var(--color-on-primary-button); }
  .button--secondary { background: var(--color-secondary-button); color: var(--color-on-secondary-button); }
  .button--tertiary { background: transparent; color: var(--color-foreground); border: var(--border-width) solid currentColor; }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.button.name",
  "settings": [
    { "type": "text", "id": "label", "label": "t:blocks.button.label", "default": "Button" },
    { "type": "url", "id": "link", "label": "t:blocks.common.link" },
    { "type": "select", "id": "style", "label": "t:blocks.button.style", "options": [
      { "value": "primary", "label": "Primary" }, { "value": "secondary", "label": "Secondary" }, { "value": "tertiary", "label": "Tertiary" }
    ], "default": "primary" },
    { "type": "checkbox", "id": "open_in_new_tab", "label": "t:blocks.common.open_new_tab", "default": false, "visible_if": "{{ block.settings.link != blank }}" }
  ],
  "presets": [{ "name": "t:blocks.button.name" }]
}
{% endschema %}
