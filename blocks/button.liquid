{% doc %}
  Renders a semantic button or link using the global button variant contract.
{% enddoc %}

{% if block.settings.link != blank %}
  <a class="button button--{{ block.settings.style }}" style="--button-icon-size: {% if block.settings.icon_size == 'custom' %}{{ block.settings.icon_size_custom }}px{% else %}1em{% endif %}" href="{{ block.settings.link }}"{% if block.settings.open_in_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %} {{ block.shopify_attributes }}>
    {% if block.settings.show_icon and block.settings.icon_position == 'left' %}<span class="button__icon" aria-hidden="true">{% if block.settings.icon == 'account' %}{{ 'icon-account.svg' | inline_asset_content }}{% else %}{{ 'icon-cart.svg' | inline_asset_content }}{% endif %}</span>{% endif %}
    <span>{{ block.settings.label | escape }}</span>
    {% if block.settings.show_icon and block.settings.icon_position == 'right' %}<span class="button__icon" aria-hidden="true">{% if block.settings.icon == 'account' %}{{ 'icon-account.svg' | inline_asset_content }}{% else %}{{ 'icon-cart.svg' | inline_asset_content }}{% endif %}</span>{% endif %}
  </a>
{% else %}
  <button class="button button--{{ block.settings.style }}" style="--button-icon-size: {% if block.settings.icon_size == 'custom' %}{{ block.settings.icon_size_custom }}px{% else %}1em{% endif %}" type="button" {{ block.shopify_attributes }}>
    {% if block.settings.show_icon and block.settings.icon_position == 'left' %}<span class="button__icon" aria-hidden="true">{% if block.settings.icon == 'account' %}{{ 'icon-account.svg' | inline_asset_content }}{% else %}{{ 'icon-cart.svg' | inline_asset_content }}{% endif %}</span>{% endif %}
    <span>{{ block.settings.label | escape }}</span>
    {% if block.settings.show_icon and block.settings.icon_position == 'right' %}<span class="button__icon" aria-hidden="true">{% if block.settings.icon == 'account' %}{{ 'icon-account.svg' | inline_asset_content }}{% else %}{{ 'icon-cart.svg' | inline_asset_content }}{% endif %}</span>{% endif %}
  </button>
{% endif %}

{% stylesheet %}
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding-inline: 1.25rem;
    border-radius: var(--radius-buttons-inputs);
    font: inherit;
    text-decoration: none;
    cursor: pointer;
  }
  .button__icon { display: inline-flex; width: var(--button-icon-size); height: var(--button-icon-size); }
  .button__icon svg { width: 100%; height: 100%; stroke-width: var(--icon-stroke-width); }
  .button--primary { background: var(--color-primary-button); color: var(--color-on-primary-button); }
  .button--secondary { background: var(--color-secondary-button); color: var(--color-on-secondary-button); }
  .button--tertiary { background: transparent; color: var(--color-foreground); border: var(--border-width) solid currentColor; }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.button.name",
  "settings": [
    { "type": "text", "id": "label", "label": "t:blocks.button.label", "default": "Button" },
    { "type": "url", "id": "link", "label": "t:blocks.common.link" },
    { "type": "select", "id": "style", "label": "t:blocks.button.style", "options": [
      { "value": "primary", "label": "Primary" }, { "value": "secondary", "label": "Secondary" }, { "value": "tertiary", "label": "Tertiary" }
    ], "default": "primary" },
    { "type": "checkbox", "id": "show_icon", "label": "t:blocks.button.show_icon", "default": false },
    { "type": "select", "id": "icon", "label": "t:blocks.button.icon", "options": [{ "value": "account", "label": "Account" }, { "value": "cart", "label": "Cart" }], "default": "cart", "visible_if": "{{ block.settings.show_icon }}" },
    { "type": "select", "id": "icon_position", "label": "t:blocks.button.icon_position", "options": [{ "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }], "default": "right", "visible_if": "{{ block.settings.show_icon }}" },
    { "type": "select", "id": "icon_size", "label": "t:blocks.button.icon_size", "options": [{ "value": "inherit", "label": "Inherit" }, { "value": "custom", "label": "Custom" }], "default": "inherit", "visible_if": "{{ block.settings.show_icon }}" },
    { "type": "range", "id": "icon_size_custom", "label": "t:blocks.button.icon_size_custom", "min": 12, "max": 32, "step": 1, "unit": "px", "default": 18, "visible_if": "{{ block.settings.show_icon and block.settings.icon_size == 'custom' }}" },
    { "type": "checkbox", "id": "open_in_new_tab", "label": "t:blocks.common.open_new_tab", "default": false, "visible_if": "{{ block.settings.link != blank }}" }
  ],
  "presets": [{ "name": "t:blocks.button.name" }]
}
{% endschema %}
