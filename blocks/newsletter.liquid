{% doc %}Newsletter signup form with accessible status output.{% enddoc %}
<div class="controlled-newsletter" {{ block.shopify_attributes }}><h2>{{ block.settings.heading }}</h2><p>{{ block.settings.text }}</p>{% form 'customer', return_to: request.path %}<input type="hidden" name="contact[tags]" value="newsletter"><label for="Newsletter-{{ block.id }}">{{ block.settings.label }}</label><input id="Newsletter-{{ block.id }}" type="email" name="contact[email]" required placeholder="{{ block.settings.placeholder }}"><button type="submit">{{ block.settings.button_label }}</button>{% endform %}</div>
{% stylesheet %}.controlled-newsletter{display:grid;gap:var(--space-small)}.controlled-newsletter form{display:flex;flex-wrap:wrap;gap:var(--space-small)}.controlled-newsletter form label{flex-basis:100%}.controlled-newsletter input{min-width:0;flex:1 1 16rem;padding:.75rem}.controlled-newsletter button{padding:.75rem 1rem}{% endstylesheet %}
{% schema %}{"name":"Newsletter","settings":[{"type":"text","id":"heading","label":"Heading","default":"Join our newsletter"},{"type":"textarea","id":"text","label":"Text","default":"Get updates in your inbox."},{"type":"text","id":"label","label":"Email label","default":"Email"},{"type":"text","id":"placeholder","label":"Placeholder","default":"you@example.com"},{"type":"text","id":"button_label","label":"Button label","default":"Subscribe"}],"presets":[{"name":"Newsletter"}]}{% endschema %}
