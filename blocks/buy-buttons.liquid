{% doc %}Purchase controls composed around the parent product form context.{% enddoc %}
{% if product != blank %}<div class="commerce-buy-buttons" {{ block.shopify_attributes }}>{% if product.available %}<button class="button button--{{ block.settings.button_style }}" type="submit" name="add">{{ block.settings.add_to_cart_label }}</button>{% else %}<button class="button" type="button" disabled>Sold out</button>{% endif %}</div>{% endif %}
{% stylesheet %}.commerce-buy-buttons { display: grid; gap: var(--space-small); }.commerce-buy-buttons .button { width: 100%; }{% endstylesheet %}
{% schema %}{"name":"t:blocks.commerce.buy_buttons_name","settings":[{"type":"text","id":"add_to_cart_label","label":"Add to cart label","default":"Add to cart"},{"type":"select","id":"button_style","label":"Button style","options":[{"value":"primary","label":"Primary"},{"value":"secondary","label":"Secondary"},{"value":"tertiary","label":"Tertiary"}],"default":"primary"},{"type":"checkbox","id":"show_dynamic_checkout","label":"Show dynamic checkout","default":false}],"presets":[{"name":"t:blocks.commerce.buy_buttons_name"}]}{% endschema %}
