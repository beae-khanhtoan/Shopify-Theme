{% doc %}Two controlled content columns with a responsive stack.{% enddoc %}
<div class="composition-split-content composition-split-content--{{ block.settings.ratio }}" {{ block.shopify_attributes }}><div>{{ block.settings.left }}</div><div>{{ block.settings.right }}</div></div>
{% stylesheet %}.composition-split-content{display:grid;grid-template-columns:var(--split-columns,1fr 1fr);gap:var(--space-large)}.composition-split-content--one_two{--split-columns:1fr 2fr}.composition-split-content--two_one{--split-columns:2fr 1fr}@media(max-width:767.98px){.composition-split-content{grid-template-columns:1fr}}{% endstylesheet %}
{% schema %}{"name":"Split content","settings":[{"type":"select","id":"ratio","label":"Ratio","options":[{"value":"equal","label":"Equal"},{"value":"one_two","label":"1:2"},{"value":"two_one","label":"2:1"}],"default":"equal"},{"type":"richtext","id":"left","label":"Left content","default":"<p>Left content</p>"},{"type":"richtext","id":"right","label":"Right content","default":"<p>Right content</p>"}],"presets":[{"name":"Split content"}]}{% endschema %}
