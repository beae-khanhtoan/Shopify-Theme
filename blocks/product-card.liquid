{% doc %}Commerce product card. Reads the current product context only.{% enddoc %}
{% if product != blank %}
  <article class="commerce-product-card commerce-product-card--{{ block.settings.color_type }} commerce-product-card--scheme-{{ block.settings.color_scheme }}" {{ block.shopify_attributes }}>
    <a class="commerce-product-card__media" href="{{ product.url }}">
      {% if product.featured_image %}{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: product.featured_image.alt | default: product.title }}{% else %}<div class="commerce-product-card__placeholder" aria-hidden="true"></div>{% endif %}
    </a>
    <div class="commerce-product-card__content">
      {% if block.settings.show_ranking and product.metafields.reviews.rating.value != blank %}<span class="commerce-product-card__rating" aria-label="{{ product.metafields.reviews.rating.value }} out of 5">{{ product.metafields.reviews.rating.value }}/5</span>{% endif %}
      <a class="card-title-text commerce-product-card__title" href="{{ product.url }}">{{ product.title | escape }}</a>
      {% if product.available == false %}<span class="commerce-product-card__status">Sold out</span>{% endif %}
      <span class="card-price-text commerce-product-card__price">{{ product.price | money }}</span>
    </div>
  </article>
{% endif %}
{% stylesheet %}.commerce-product-card { min-width: 0; overflow: hidden; }.commerce-product-card__media { display: block; aspect-ratio: 4 / 5; overflow: hidden; }.commerce-product-card__media img { width: 100%; height: 100%; object-fit: cover; display: block; }.commerce-product-card__placeholder { width: 100%; height: 100%; background: var(--color-background-2); }.commerce-product-card__content { display: grid; gap: var(--space-small); min-width: 0; padding-block-start: var(--space-small); }.commerce-product-card__title { overflow-wrap: anywhere; }.commerce-product-card__status { color: var(--color-muted); }{% endstylesheet %}
{% schema %}{"name":"t:blocks.commerce.product_card_name","settings":[{"type":"header","content":"Content"},{"type":"checkbox","id":"show_ranking","label":"Show ranking","default":false},{"type":"header","content":"Color"},{"type":"select","id":"color_type","label":"Color type","options":[{"value":"inherit","label":"Inherit"},{"value":"color_scheme","label":"Color scheme"}],"default":"inherit"},{"type":"color_scheme","id":"color_scheme","label":"Color scheme","default":"scheme-1","visible_if":"{{ block.settings.color_type == 'color_scheme' }}"}],"presets":[{"name":"t:blocks.commerce.product_card_name"}]}{% endschema %}
