{% doc %}Share controls for the current page with native-share fallback and copy feedback.{% enddoc %}
{% assign share_url = request.origin | append: request.path %}{% if block.settings.target == 'custom' and block.settings.custom_target != blank %}{% assign share_url = block.settings.custom_target %}{% endif %}
{% assign share_title = page_title | default: shop.name %}
<div class="navigation-share navigation-share--{{ block.settings.orientation }}" style="--share-gap: {{ block.settings.gap }}px; --share-align: {{ block.settings.alignment }}; --share-padding-top: {{ block.settings.padding_top }}px; --share-padding-bottom: {{ block.settings.padding_bottom }}px; --share-padding-left: {{ block.settings.padding_left }}px; --share-padding-right: {{ block.settings.padding_right }}px; --share-padding-top-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_top_mobile }}{% else %}{{ block.settings.padding_top }}{% endif %}px; --share-padding-bottom-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_bottom_mobile }}{% else %}{{ block.settings.padding_bottom }}{% endif %}px; --share-padding-left-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_left_mobile }}{% else %}{{ block.settings.padding_left }}{% endif %}px; --share-padding-right-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_right_mobile }}{% else %}{{ block.settings.padding_right }}{% endif %}px;" {{ block.shopify_attributes }}>
  <button class="button button--{{ block.settings.button_variant }}" type="button" data-share-button data-share-url="{{ share_url | escape }}" data-share-title="{{ share_title | escape }}"><span aria-hidden="true">↗</span><span data-share-label>{{ block.settings.visible_label }}</span></button>
  {% if block.settings.show_copy_link %}<button class="navigation-share__copy" type="button" data-copy-share data-share-url="{{ share_url | escape }}"><span data-copy-label>Copy link</span></button>{% endif %}
  <span class="navigation-share__status" data-share-status role="status" aria-live="polite"></span>
</div>
{% javascript %}
  (() => {
    const root = document.currentScript?.previousElementSibling;
    if (!root || root.dataset.shareReady) return;
    root.dataset.shareReady = 'true';
    const status = root.querySelector('[data-share-status]');
    const share = async (url, title) => {
      if (navigator.share) { await navigator.share({ url, title }); return; }
      await navigator.clipboard.writeText(url);
      status.textContent = 'Link copied';
    };
    root.querySelector('[data-share-button]')?.addEventListener('click', async (event) => {
      const button = event.currentTarget;
      try { await share(button.dataset.shareUrl, button.dataset.shareTitle); } catch (error) { status.textContent = 'Unable to share'; }
    });
    root.querySelector('[data-copy-share]')?.addEventListener('click', async (event) => {
      try { await navigator.clipboard.writeText(event.currentTarget.dataset.shareUrl); status.textContent = 'Link copied'; } catch (error) { status.textContent = 'Unable to copy'; }
    });
  })();
{% endjavascript %}
{% stylesheet %}.navigation-share { display: flex; flex-wrap: wrap; align-items: center; justify-content: var(--share-align); gap: var(--share-gap); padding: var(--share-padding-top) var(--share-padding-right) var(--share-padding-bottom) var(--share-padding-left); }.navigation-share button { font: inherit; cursor: pointer; }.navigation-share--stack { flex-direction: column; align-items: var(--share-align); }.navigation-share__copy { display: inline-flex; min-height: 2.75rem; align-items: center; padding-inline: 1.25rem; border: 1px solid currentColor; border-radius: var(--radius-buttons-inputs); background: transparent; color: inherit; }.navigation-share__status { min-width: 8rem; min-height: 1.25em; } @media (max-width: 767.98px) { .navigation-share { padding: var(--share-padding-top-mobile) var(--share-padding-right-mobile) var(--share-padding-bottom-mobile) var(--share-padding-left-mobile); } .navigation-share--stack { align-items: start; } }{% endstylesheet %}
