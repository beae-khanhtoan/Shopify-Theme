{% doc %}Share controls for the current page with native-share fallback and copy feedback.{% enddoc %}
{% assign share_url = request.origin | append: request.path %}{% if block.settings.target == 'custom' and block.settings.custom_target != blank %}{% assign share_url = block.settings.custom_target %}{% endif %}
{% assign share_title = page_title | default: shop.name %}{% if block.settings.title_source == 'site_name' %}{% assign share_title = shop.name %}{% elsif block.settings.title_source == 'product_title' and product != blank %}{% assign share_title = product.title %}{% endif %}
<div class="navigation-share navigation-share--{{ block.settings.orientation }} navigation-share--mobile-behavior-{{ block.settings.mobile_behavior }} navigation-share--icon-{{ block.settings.icon }} navigation-share--title-{{ block.settings.title_source }}{% if block.settings.show_social_channels %} navigation-share--social{% endif %}{% if block.settings.mobile_stack %} navigation-share--mobile-stack{% endif %}" style="--share-gap: {{ block.settings.gap }}px; --share-align: {{ block.settings.alignment }}; --share-padding-top: {{ block.settings.padding_top }}px; --share-padding-bottom: {{ block.settings.padding_bottom }}px; --share-padding-left: {{ block.settings.padding_left }}px; --share-padding-right: {{ block.settings.padding_right }}px; --share-padding-top-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_top_mobile }}{% else %}{{ block.settings.padding_top }}{% endif %}px; --share-padding-bottom-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_bottom_mobile }}{% else %}{{ block.settings.padding_bottom }}{% endif %}px; --share-padding-left-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_left_mobile }}{% else %}{{ block.settings.padding_left }}{% endif %}px; --share-padding-right-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_right_mobile }}{% else %}{{ block.settings.padding_right }}{% endif %}px;" data-copied-label="{{ block.settings.copied_label | escape }}" data-error-label="{{ block.settings.error_label | escape }}" {{ block.shopify_attributes }}>
  {% if block.settings.show_native_share %}<button class="button button--{{ block.settings.button_variant }}" type="button" data-share-button data-share-url="{{ share_url | escape }}" data-share-title="{{ share_title | escape }}">{% unless block.settings.icon == 'none' %}<span class="navigation-share__icon" aria-hidden="true">{% if block.settings.icon == 'link' %}<svg viewBox="0 0 24 24" focusable="false"><path d="M10.6 13.4a4 4 0 0 0 5.7 0l2.1-2.1a4 4 0 0 0-5.7-5.7l-1.2 1.2m1.9 3.1a4 4 0 0 0-5.7 0l-2.1 2.1a4 4 0 0 0 5.7 5.7l1.2-1.2" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"/></svg>{% elsif block.settings.icon == 'send' %}➤{% else %}<svg viewBox="0 0 24 24" focusable="false"><circle cx="18" cy="5" r="2" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="6" cy="12" r="2" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="18" cy="19" r="2" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="m7.8 11 8.4-5m-8.4 7 8.4 5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.8"/></svg>{% endif %}</span>{% endunless %}<span data-share-label>{{ block.settings.visible_label }}</span></button>{% endif %}
  {% if block.settings.show_copy_link %}<button class="navigation-share__copy" type="button" data-copy-share data-share-url="{{ share_url | escape }}"><span data-copy-label>Copy link</span></button>{% endif %}
  {% if block.settings.show_email %}<a class="navigation-share__copy" href="mailto:?subject={{ share_title | url_encode }}&body={{ share_url | url_encode }}">Email</a>{% endif %}
  {% if block.settings.show_social_channels %}
    {% assign share_facebook = settings.social_facebook %}{% assign share_instagram = settings.social_instagram %}
    {% if share_facebook == blank and request.design_mode %}{% assign share_facebook = '#' %}{% endif %}{% if share_instagram == blank and request.design_mode %}{% assign share_instagram = '#' %}{% endif %}
    <div class="navigation-share__social-channels" aria-label="Social sharing links">
      {% if share_facebook != blank %}<a class="navigation-share__copy" href="{{ share_facebook }}"{% if share_facebook != '#' %} target="_blank" rel="noopener noreferrer"{% endif %}>Facebook</a>{% endif %}
      {% if share_instagram != blank %}<a class="navigation-share__copy" href="{{ share_instagram }}"{% if share_instagram != '#' %} target="_blank" rel="noopener noreferrer"{% endif %}>Instagram</a>{% endif %}
    </div>
  {% endif %}
  {% if block.settings.target == 'custom' and block.settings.custom_target != blank %}<a class="navigation-share__target" href="{{ share_url | escape }}" target="_blank" rel="noopener noreferrer">{{ share_url | escape }}</a>{% endif %}
  <span class="navigation-share__status" data-share-status role="status" aria-live="polite"></span>
</div>
{% javascript %}
  (() => {
    const root = document.currentScript?.previousElementSibling;
    if (!root || root.dataset.shareReady) return;
    root.dataset.shareReady = 'true';
    const status = root.querySelector('[data-share-status]');
    const share = async (url, title) => {
      if (navigator.share) { await navigator.share({ url, title }); return; }
      await navigator.clipboard.writeText(url);
      status.textContent = root.dataset.copiedLabel;
    };
    root.querySelector('[data-share-button]')?.addEventListener('click', async (event) => {
      const button = event.currentTarget;
      try { await share(button.dataset.shareUrl, button.dataset.shareTitle); } catch (error) { status.textContent = 'Unable to share'; }
    });
    root.querySelector('[data-copy-share]')?.addEventListener('click', async (event) => {
      try { await navigator.clipboard.writeText(event.currentTarget.dataset.shareUrl); status.textContent = root.dataset.copiedLabel; } catch (error) { status.textContent = root.dataset.errorLabel; }
    });
  })();
{% endjavascript %}
{% stylesheet %}.navigation-share { box-sizing: border-box; display: flex; flex-wrap: wrap; align-items: center; justify-content: var(--share-align); gap: var(--share-gap); width: 100%; max-width: 100%; min-width: 0; overflow: hidden; padding: var(--share-padding-top) var(--share-padding-right) var(--share-padding-bottom) var(--share-padding-left); }.navigation-share button { box-sizing: border-box; flex: 0 1 auto; max-width: 100%; min-width: 0; font: inherit; cursor: pointer; overflow-wrap: anywhere; }.navigation-share .button--secondary { border: 1px solid var(--color-secondary-button); background: var(--color-secondary-button); color: var(--color-secondary-button-label, var(--color-on-secondary-button)); }.navigation-share .button--secondary:hover { background: var(--color-secondary-button-hover, var(--color-secondary-button)); }.navigation-share .button--tertiary { border: 0; background: transparent; color: var(--color-tertiary-button-label, var(--color-foreground)); text-decoration: underline; text-underline-offset: .2em; }.navigation-share .button--tertiary:hover { background: var(--color-tertiary-button-hover, transparent); }.navigation-share--stack, .navigation-share--mobile-stack { flex-direction: column; align-items: var(--share-align); }.navigation-share__copy,.navigation-share__target { display: inline-flex; min-width: 0; max-width: 100%; min-height: 2.75rem; align-items: center; padding-inline: 1.25rem; border: 1px solid currentColor; border-radius: var(--radius-buttons-inputs); background: transparent; color: inherit; text-decoration: none; overflow-wrap: anywhere; }.navigation-share__social-channels { display: inline-flex; flex-wrap: wrap; gap: var(--share-gap); max-width: 100%; }.navigation-share__icon { display: inline-flex; width: 1em; height: 1em; align-items: center; justify-content: center; }.navigation-share__icon svg { display: block; width: 100%; height: 100%; }.navigation-share__status { min-width: 0; min-height: 1.25em; } @media (max-width: 767.98px) { .navigation-share { padding: var(--share-padding-top-mobile) var(--share-padding-right-mobile) var(--share-padding-bottom-mobile) var(--share-padding-left-mobile); } .navigation-share--stack, .navigation-share--mobile-stack { align-items: start; } .navigation-share--mobile-behavior-stack { flex-direction: column; align-items: var(--share-align); } .navigation-share--mobile-behavior-scroll { flex-wrap: nowrap; overflow-x: auto; } }{% endstylesheet %}
{% schema %}{"name":"t:blocks.navigation.share_name","settings":[{"type":"header","content":"Source"},{"type":"select","id":"target","label":"URL","options":[{"value":"current_page","label":"Current page"},{"value":"custom","label":"Custom target"}],"default":"current_page"},{"type":"url","id":"custom_target","label":"Custom target","visible_if":"{{ block.settings.target == 'custom' }}"},{"type":"header","content":"Content"},{"type":"select","id":"title_source","label":"Title","options":[{"value":"current_page","label":"Current page title"},{"value":"site_name","label":"Store name"},{"value":"product_title","label":"Product title"}],"default":"current_page"},{"type":"checkbox","id":"show_native_share","label":"Native share","default":true},{"type":"checkbox","id":"show_copy_link","label":"Copy link","default":true},{"type":"checkbox","id":"show_email","label":"Email","default":false},{"type":"checkbox","id":"show_social_channels","label":"Social channels","default":false},{"type":"text","id":"visible_label","label":"Visible label","default":"Share"},{"type":"text","id":"copied_label","label":"Copied state","default":"Link copied"},{"type":"text","id":"error_label","label":"Error state","default":"Unable to copy"},{"type":"header","content":"Appearance"},{"type":"select","id":"button_variant","label":"Button variant","options":[{"value":"primary","label":"Primary"},{"value":"secondary","label":"Secondary"},{"value":"tertiary","label":"Tertiary"}],"default":"secondary"},{"type":"select","id":"icon","label":"Icon","options":[{"value":"share","label":"Share"},{"value":"link","label":"Link"},{"value":"send","label":"Send"},{"value":"none","label":"None"}],"default":"share"},{"type":"header","content":"Layout"},{"type":"select","id":"orientation","label":"Orientation","options":[{"value":"inline","label":"Inline"},{"value":"stack","label":"Stack"}],"default":"inline"},{"type":"range","id":"gap","label":"Gap","min":0,"max":64,"step":1,"unit":"px","default":8},{"type":"select","id":"alignment","label":"Alignment","options":[{"value":"start","label":"Start"},{"value":"center","label":"Center"},{"value":"end","label":"End"}],"default":"start"},{"type":"select","id":"mobile_behavior","label":"Mobile behavior","options":[{"value":"wrap","label":"Wrap"},{"value":"stack","label":"Stack"},{"value":"scroll","label":"Scroll"}],"default":"wrap"},{"type":"checkbox","id":"mobile_stack","label":"Mobile stack","default":false},{"type":"header","content":"Padding"},{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":100,"step":1,"unit":"px","default":0},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":100,"step":1,"unit":"px","default":0},{"type":"range","id":"padding_left","label":"Left padding","min":0,"max":100,"step":1,"unit":"px","default":0},{"type":"range","id":"padding_right","label":"Right padding","min":0,"max":100,"step":1,"unit":"px","default":0},{"type":"checkbox","id":"customize_mobile_padding","label":"Customize mobile padding","default":false},{"type":"range","id":"padding_top_mobile","label":"Mobile top padding","min":0,"max":100,"step":1,"unit":"px","default":0,"visible_if":"{{ block.settings.customize_mobile_padding }}"},{"type":"range","id":"padding_bottom_mobile","label":"Mobile bottom padding","min":0,"max":100,"step":1,"unit":"px","default":0,"visible_if":"{{ block.settings.customize_mobile_padding }}"},{"type":"range","id":"padding_left_mobile","label":"Mobile left padding","min":0,"max":100,"step":1,"unit":"px","default":0,"visible_if":"{{ block.settings.customize_mobile_padding }}"},{"type":"range","id":"padding_right_mobile","label":"Mobile right padding","min":0,"max":100,"step":1,"unit":"px","default":0,"visible_if":"{{ block.settings.customize_mobile_padding }}"}],"presets":[{"category":"Block Navigation & Utility","name":"t:blocks.navigation.share_name"}]}{% endschema %}
