{% doc %}Two-column split layout with explicit ratio and mobile order.{% enddoc %}
{% assign column_template = '1fr 1fr' %}{% if block.settings.ratio == 'one_two' %}{% assign column_template = '1fr 2fr' %}{% elsif block.settings.ratio == 'two_one' %}{% assign column_template = '2fr 1fr' %}{% endif %}
<div class="block-columns block-columns--{{ block.settings.mobile_order }}" style="--columns-template: {{ column_template }}; --columns-gap: {{ block.settings.gap }}px; --columns-gap-mobile: {{ block.settings.gap_mobile }}px; --columns-vertical: {{ block.settings.vertical_alignment }};" {{ block.shopify_attributes }}>{% content_for 'blocks' %}</div>
{% stylesheet %}.block-columns { display: grid; grid-template-columns: var(--columns-template); gap: var(--columns-gap); align-items: var(--columns-vertical); width: 100%; min-width: 0; overflow: hidden; }.block-columns > * { min-width: 0; max-width: 100%; }.block-columns--right-first > :first-child { order: 2; }.block-columns--right-first > :last-child { order: 1; } @media (max-width: 767.98px) { .block-columns { grid-template-columns: minmax(0, 1fr); gap: var(--columns-gap-mobile); } }{% endstylesheet %}
{% schema %}
{"name":"t:blocks.columns.name","blocks":[{"type":"heading"},{"type":"text"},{"type":"eyebrow"},{"type":"button"},{"type":"image"},{"type":"video"},{"type":"icon"},{"type":"header"}],"settings":[{"type":"select","id":"ratio","label":"t:blocks.layout.ratio","options":[{"value":"equal","label":"Equal"},{"value":"one_two","label":"1:2"},{"value":"two_one","label":"2:1"}],"default":"equal"},{"type":"range","id":"gap","label":"t:blocks.layout.gap","min":0,"max":80,"step":4,"unit":"px","default":24},{"type":"range","id":"gap_mobile","label":"t:blocks.layout.mobile_gap","min":0,"max":64,"step":4,"unit":"px","default":16},{"type":"select","id":"mobile_order","label":"t:blocks.layout.mobile_order","options":[{"value":"left-first","label":"Left first"},{"value":"right-first","label":"Right first"}],"default":"left-first"},{"type":"select","id":"vertical_alignment","label":"t:blocks.layout.vertical_alignment","options":[{"value":"start","label":"Start"},{"value":"center","label":"Center"},{"value":"end","label":"End"},{"value":"stretch","label":"Stretch"}],"default":"stretch"}],"presets":[{"name":"t:blocks.columns.name"}]}
{% endschema %}
