{% doc %}Storefront search form with an accessible label, query-preserving submit and clear control.{% enddoc %}
{% assign search_value = search.terms | default: '' %}
<div class="navigation-search navigation-search--{{ block.settings.alignment }} navigation-search--{{ block.settings.source }} navigation-search--{{ block.settings.result_route }} navigation-search--{{ block.settings.input_variant }} navigation-search--radius-{{ block.settings.radius }}" data-query-parameter="{{ block.settings.query_parameter }}" data-max-results="{{ block.settings.max_results }}" data-include-products="{{ block.settings.include_products }}" data-include-articles="{{ block.settings.include_articles }}" data-include-pages="{{ block.settings.include_pages }}" data-icon="{{ block.settings.icon }}" data-color-scheme="{{ block.settings.color_scheme }}" style="--search-gap: {{ block.settings.gap }}px; --search-padding-top: {{ block.settings.padding_top }}px; --search-padding-bottom: {{ block.settings.padding_bottom }}px; --search-padding-left: {{ block.settings.padding_left }}px; --search-padding-right: {{ block.settings.padding_right }}px; --search-padding-top-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_top_mobile }}{% else %}{{ block.settings.padding_top }}{% endif %}px; --search-padding-bottom-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_bottom_mobile }}{% else %}{{ block.settings.padding_bottom }}{% endif %}px; --search-padding-left-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_left_mobile }}{% else %}{{ block.settings.padding_left }}{% endif %}px; --search-padding-right-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_right_mobile }}{% else %}{{ block.settings.padding_right }}{% endif %}px;" {{ block.shopify_attributes }}>
  <form action="{{ routes.search_url }}" method="get" class="navigation-search__form" role="search">
    <input type="hidden" name="options[prefix]" value="last">
    <label class="visually-hidden" for="NavigationSearch-{{ block.id }}">{{ block.settings.input_label }}</label>
    <input id="NavigationSearch-{{ block.id }}" type="search" name="q" value="{{ search_value | escape }}" placeholder="{{ block.settings.placeholder | escape }}" autocomplete="{% if block.settings.source == 'predictive' %}off{% else %}on{% endif %}" autocapitalize="off" spellcheck="false">
    {% if search_value != blank %}<button type="reset" class="navigation-search__clear" aria-label="Clear search">×</button>{% endif %}
    <button class="button button--{{ block.settings.button_variant }}" type="submit">{% if block.settings.icon == 'none' %}{% elsif block.settings.icon == 'search_alt' %}<span aria-hidden="true">🔎</span>{% else %}<span aria-hidden="true">⌕</span>{% endif %}<span>{{ block.settings.submit_label }}</span></button>
  </form>
  <p class="navigation-search__status" role="status" aria-live="polite">{% if search.performed and search.results_count == 0 %}{{ block.settings.no_result_message }}{% endif %}</p>
</div>
{% stylesheet %}.navigation-search { box-sizing: border-box; width: 100%; max-width: 100%; min-width: 0; overflow: hidden; padding: var(--search-padding-top) var(--search-padding-right) var(--search-padding-bottom) var(--search-padding-left); }.navigation-search--start .navigation-search__form { margin-inline-end: auto; }.navigation-search--center .navigation-search__form { margin-inline: auto; }.navigation-search--end .navigation-search__form { margin-inline-start: auto; }.navigation-search__form { box-sizing: border-box; display: flex; align-items: center; gap: var(--search-gap); width: min(100%, 640px); max-width: 100%; min-width: 0; overflow: hidden; }.navigation-search__form input[type='hidden'] { display: none; }.navigation-search__form input[type='search'] { box-sizing: border-box; flex: 1 1 auto; width: 100%; min-width: 0; max-width: 100%; border: 1px solid currentColor; border-radius: var(--radius-buttons-inputs); padding: .75rem 1rem; background: transparent; color: inherit; }.navigation-search__form > .button { box-sizing: border-box; flex: 0 0 auto; width: auto; max-width: none; min-width: max-content; overflow-wrap: normal; white-space: nowrap; }.navigation-search--filled .navigation-search__form input[type='search'] { background: var(--color-background); }.navigation-search--minimal .navigation-search__form input[type='search'] { border-color: transparent; border-bottom-color: currentColor; border-radius: 0; }.navigation-search--radius-small .navigation-search__form input[type='search'] { border-radius: .25rem; }.navigation-search--radius-large .navigation-search__form input[type='search'] { border-radius: 1rem; }.navigation-search--radius-pill .navigation-search__form input[type='search'] { border-radius: 999px; }.navigation-search__clear { box-sizing: border-box; flex: 0 0 2rem; width: 2rem; margin-inline-start: -3rem; border: 0; background: transparent; color: inherit; cursor: pointer; }.navigation-search__status { min-height: 1.25em; margin: .5rem 0 0; }.visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; } @media (max-width: 767.98px) { .navigation-search { padding: var(--search-padding-top-mobile) var(--search-padding-right-mobile) var(--search-padding-bottom-mobile) var(--search-padding-left-mobile); }.navigation-search__form { width: min(100%, 640px); } }{% endstylesheet %}
{% schema %}{"name":"t:blocks.navigation.search_name","settings":[{"type":"header","content":"Content"},{"type":"text","id":"input_label","label":"Input label","default":"Search products"},{"type":"text","id":"placeholder","label":"Placeholder","default":"Search"},{"type":"text","id":"submit_label","label":"Submit label","default":"Search"},{"type":"header","content":"Results"},{"type":"select","id":"source","label":"Search source","options":[{"value":"predictive","label":"Predictive search"},{"value":"standard","label":"Standard search"}],"default":"predictive"},{"type":"select","id":"result_route","label":"Result route","options":[{"value":"search","label":"Search page"},{"value":"collection","label":"Collection results"}],"default":"search"},{"type":"text","id":"query_parameter","label":"Query parameter","default":"q"},{"type":"range","id":"max_results","label":"Max results","min":4,"max":20,"step":1,"default":8},{"type":"checkbox","id":"include_products","label":"Products","default":true},{"type":"checkbox","id":"include_articles","label":"Articles","default":true},{"type":"checkbox","id":"include_pages","label":"Pages","default":true},{"type":"text","id":"no_result_message","label":"No result message","default":"No results found."},{"type":"header","content":"Appearance"},{"type":"select","id":"input_variant","label":"Input variant","options":[{"value":"outline","label":"Outline"},{"value":"filled","label":"Filled"},{"value":"minimal","label":"Minimal"}],"default":"outline"},{"type":"select","id":"button_variant","label":"Button variant","options":[{"value":"primary","label":"Primary"},{"value":"secondary","label":"Secondary"}],"default":"primary"},{"type":"select","id":"icon","label":"Icon","options":[{"value":"search","label":"Search"},{"value":"search_alt","label":"Search plus"},{"value":"none","label":"None"}],"default":"search"},{"type":"color_scheme","id":"color_scheme","label":"Color scheme"},{"type":"header","content":"Layout"},{"type":"select","id":"alignment","label":"Alignment","options":[{"value":"start","label":"Start"},{"value":"center","label":"Center"},{"value":"end","label":"End"}],"default":"start"},{"type":"select","id":"radius","label":"Radius","options":[{"value":"small","label":"Small"},{"value":"medium","label":"Medium"},{"value":"large","label":"Large"},{"value":"pill","label":"Pill"}],"default":"medium"},{"type":"range","id":"gap","label":"Gap","min":0,"max":64,"step":1,"unit":"px","default":8},{"type":"header","content":"Padding"},{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":100,"step":1,"unit":"px","default":0},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":100,"step":1,"unit":"px","default":0},{"type":"range","id":"padding_left","label":"Left padding","min":0,"max":100,"step":1,"unit":"px","default":0},{"type":"range","id":"padding_right","label":"Right padding","min":0,"max":100,"step":1,"unit":"px","default":0},{"type":"checkbox","id":"customize_mobile_padding","label":"Customize mobile padding","default":false},{"type":"range","id":"padding_top_mobile","label":"Mobile top padding","min":0,"max":100,"step":1,"unit":"px","default":0,"visible_if":"{{ block.settings.customize_mobile_padding }}"},{"type":"range","id":"padding_bottom_mobile","label":"Mobile bottom padding","min":0,"max":100,"step":1,"unit":"px","default":0,"visible_if":"{{ block.settings.customize_mobile_padding }}"},{"type":"range","id":"padding_left_mobile","label":"Mobile left padding","min":0,"max":100,"step":1,"unit":"px","default":0,"visible_if":"{{ block.settings.customize_mobile_padding }}"},{"type":"range","id":"padding_right_mobile","label":"Mobile right padding","min":0,"max":100,"step":1,"unit":"px","default":0,"visible_if":"{{ block.settings.customize_mobile_padding }}"}],"presets":[{"name":"t:blocks.navigation.search_name"}]}{% endschema %}
