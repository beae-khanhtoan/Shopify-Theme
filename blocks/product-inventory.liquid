{% doc %}Inventory status read from the selected or first available variant.{% enddoc %}
{% if product != blank and block.settings.show_inventory %}{% assign inventory_variant = product.selected_or_first_available_variant %}{% if inventory_variant.inventory_management and inventory_variant.inventory_quantity > 0 %}<p class="commerce-inventory commerce-inventory--available" {{ block.shopify_attributes }}>In stock{% if block.settings.show_quantity %}: {{ inventory_variant.inventory_quantity }}{% endif %}</p>{% elsif inventory_variant.available == false %}<p class="commerce-inventory commerce-inventory--sold-out" {{ block.shopify_attributes }}>Sold out</p>{% endif %}{% endif %}
{% stylesheet %}.commerce-inventory { margin: 0; color: var(--color-muted); }.commerce-inventory--available { color: var(--color-success, currentColor); }.commerce-inventory--sold-out { color: var(--color-error, currentColor); }{% endstylesheet %}
{% schema %}{"name":"t:blocks.commerce.product_inventory_name","settings":[{"type":"checkbox","id":"show_inventory","label":"Show inventory status","default":true},{"type":"checkbox","id":"show_quantity","label":"Show quantity","default":false}],"presets":[{"name":"t:blocks.commerce.product_inventory_name"}]}{% endschema %}
