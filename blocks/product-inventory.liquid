{% doc %}Inventory signal from the selected variant and Shopify inventory policy.{% enddoc %}
{% if product != blank %}
  {% assign inventory_variant = product.selected_or_first_available_variant %}
  {% assign inventory_quantity = inventory_variant.inventory_quantity | default: 0 %}
  {% assign threshold = block.settings.low_inventory_threshold %}
  {% if inventory_variant.inventory_management and inventory_quantity > 0 %}
    {% assign inventory_state = 'available' %}{% if threshold > 0 and inventory_quantity <= threshold %}{% assign inventory_state = 'low' %}{% endif %}
    <div class="commerce-inventory commerce-inventory--{{ inventory_state }} commerce-inventory--font-{{ block.settings.font }} commerce-inventory--size-{{ block.settings.font_size }} commerce-inventory--spacing-{{ block.settings.letter_spacing }} commerce-inventory--color-{{ block.settings.low_inventory_text_color }}" style="--inventory-padding-top: {{ block.settings.padding_top }}px; --inventory-padding-bottom: {{ block.settings.padding_bottom }}px; --inventory-padding-top-mobile: {{ block.settings.padding_top_mobile }}px; --inventory-padding-bottom-mobile: {{ block.settings.padding_bottom_mobile }}px;" {{ block.shopify_attributes }}>
      <span class="commerce-inventory__message">{% if inventory_state == 'low' %}Only {{ inventory_quantity }} left{% else %}In stock{% endif %}</span>
      {% if inventory_state == 'low' and block.settings.show_low_inventory_quantity %}<span class="commerce-inventory__quantity">{{ inventory_quantity }} available</span>{% endif %}
      {% if inventory_state == 'low' and block.settings.show_low_inventory_progress_bar %}<progress class="commerce-inventory__progress" max="{{ threshold }}" value="{{ inventory_quantity }}">{{ inventory_quantity }}</progress>{% endif %}
    </div>
  {% elsif inventory_variant.available == false %}
    <p class="commerce-inventory commerce-inventory--out" {{ block.shopify_attributes }}>Out of stock</p>
  {% elsif inventory_variant.inventory_management == blank %}
    <p class="commerce-inventory commerce-inventory--untracked" {{ block.shopify_attributes }}>Available</p>
  {% endif %}
{% endif %}
{% stylesheet %}.commerce-inventory { display: grid; gap: .25rem; margin: 0; padding-block: var(--inventory-padding-top, 0px) var(--inventory-padding-bottom, 0px); color: var(--color-foreground); }.commerce-inventory--low { color: var(--color-accent); }.commerce-inventory--color-text.commerce-inventory--low { color: var(--color-foreground); }.commerce-inventory--font-accent { font-family: var(--font-accent-family); }.commerce-inventory--size-sm { font-size: .875rem; }.commerce-inventory--size-lg { font-size: 1.125rem; }.commerce-inventory--spacing-wide { letter-spacing: .06em; }.commerce-inventory--out { color: var(--color-muted); }.commerce-inventory__progress { width: 100%; height: .35rem; accent-color: currentColor; } @media (max-width: 767.98px) { .commerce-inventory { padding-block: var(--inventory-padding-top-mobile, var(--inventory-padding-top, 0px)) var(--inventory-padding-bottom-mobile, var(--inventory-padding-bottom, 0px)); } }{% endstylesheet %}
{% schema %}{"name":"t:blocks.commerce.product_inventory_name","settings":[{"type":"range","id":"low_inventory_threshold","label":"Low inventory threshold","info":"A value of 0 always shows In stock.","min":0,"max":100,"step":1,"default":10},{"type":"checkbox","id":"show_low_inventory_quantity","label":"Show low inventory quantity","default":true},{"type":"checkbox","id":"show_low_inventory_progress_bar","label":"Show low inventory progress bar","default":false},{"type":"select","id":"font","label":"Font","options":[{"value":"body","label":"Body"},{"value":"accent","label":"Accent"}],"default":"body"},{"type":"select","id":"font_size","label":"Font size","options":[{"value":"sm","label":"Small"},{"value":"md","label":"Medium"},{"value":"lg","label":"Large"}],"default":"md"},{"type":"select","id":"letter_spacing","label":"Letter spacing","options":[{"value":"normal","label":"Normal"},{"value":"wide","label":"Wide"}],"default":"normal"},{"type":"select","id":"low_inventory_text_color","label":"Low inventory text color","options":[{"value":"text","label":"Text"},{"value":"accent","label":"Accent"}],"default":"text"},{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":100,"step":1,"unit":"px","default":0},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":100,"step":1,"unit":"px","default":0},{"type":"checkbox","id":"customize_mobile_padding","label":"Custom mobile padding","default":false},{"type":"range","id":"padding_top_mobile","label":"Mobile top padding","min":0,"max":100,"step":1,"unit":"px","default":0,"visible_if":"{{ block.settings.customize_mobile_padding }}"},{"type":"range","id":"padding_bottom_mobile","label":"Mobile bottom padding","min":0,"max":100,"step":1,"unit":"px","default":0,"visible_if":"{{ block.settings.customize_mobile_padding }}"}],"presets":[{"name":"t:blocks.commerce.product_inventory_name"}]}{% endschema %}
