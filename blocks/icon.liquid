{% doc %}
  Renders a library or merchant-uploaded icon with local sizing and spacing.
{% enddoc %}

{% capture icon_markup %}
  {% if block.settings.source == 'custom' and block.settings.custom_icon != blank %}
    {{ block.settings.custom_icon | image_url: width: 256 | image_tag: alt: '', loading: 'lazy' }}
  {% elsif block.settings.icon == 'account' %}
    {{ 'icon-account.svg' | inline_asset_content }}
  {% elsif block.settings.icon == 'arrow_right' %}
    <span aria-hidden="true">→</span>
  {% else %}
    {{ 'icon-cart.svg' | inline_asset_content }}
  {% endif %}
{% endcapture %}

{% if block.settings.link != blank %}<a class="icon" style="--icon-width: {{ block.settings.icon_width }}px; --icon-width-mobile: {% if block.settings.customize_mobile %}{{ block.settings.icon_width_mobile }}{% else %}{{ block.settings.icon_width }}{% endif %}px; --icon-padding: {{ block.settings.icon_padding }}px; --icon-padding-mobile: {% if block.settings.customize_mobile %}{{ block.settings.icon_padding_mobile }}{% else %}{{ block.settings.icon_padding }}{% endif %}px; --icon-outer-padding: {{ block.settings.padding_top }}px {{ block.settings.padding_right }}px {{ block.settings.padding_bottom }}px {{ block.settings.padding_left }}px; --icon-outer-padding-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_top_mobile }}px {{ block.settings.padding_right_mobile }}px {{ block.settings.padding_bottom_mobile }}px {{ block.settings.padding_left_mobile }}px{% else %}{{ block.settings.padding_top }}px {{ block.settings.padding_right }}px {{ block.settings.padding_bottom }}px {{ block.settings.padding_left }}px{% endif %};" href="{{ block.settings.link }}"{% if block.settings.open_in_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %} {{ block.shopify_attributes }}>{% else %}<span class="icon" style="--icon-width: {{ block.settings.icon_width }}px; --icon-width-mobile: {% if block.settings.customize_mobile %}{{ block.settings.icon_width_mobile }}{% else %}{{ block.settings.icon_width }}{% endif %}px; --icon-padding: {{ block.settings.icon_padding }}px; --icon-padding-mobile: {% if block.settings.customize_mobile %}{{ block.settings.icon_padding_mobile }}{% else %}{{ block.settings.icon_padding }}{% endif %}px; --icon-outer-padding: {{ block.settings.padding_top }}px {{ block.settings.padding_right }}px {{ block.settings.padding_bottom }}px {{ block.settings.padding_left }}px; --icon-outer-padding-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_top_mobile }}px {{ block.settings.padding_right_mobile }}px {{ block.settings.padding_bottom_mobile }}px {{ block.settings.padding_left_mobile }}px{% else %}{{ block.settings.padding_top }}px {{ block.settings.padding_right }}px {{ block.settings.padding_bottom }}px {{ block.settings.padding_left }}px{% endif %};" aria-hidden="true" {{ block.shopify_attributes }}>{% endif %}
  {{ icon_markup }}
{% if block.settings.link != blank %}</a>{% else %}</span>{% endif %}

{% stylesheet %}
  .icon { box-sizing: border-box; display: inline-flex; align-items: center; justify-content: center; width: var(--icon-width); max-width: 100%; padding: var(--icon-outer-padding); color: inherit; text-decoration: none; }
  .icon svg, .icon img, .icon > span { display: block; box-sizing: border-box; width: 100%; height: auto; padding: var(--icon-padding); stroke-width: var(--icon-stroke-width); }
  @media (max-width: 767.98px) { .icon { width: var(--icon-width-mobile); padding: var(--icon-outer-padding-mobile); } .icon svg, .icon img, .icon > span { padding: var(--icon-padding-mobile); } }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.icon.name",
  "settings": [
    {
      "type": "header",
      "content": "Source"
    },
    {
      "type": "select",
      "id": "source",
      "label": "Source",
      "options": [
        {
          "value": "library",
          "label": "Library"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "library"
    },
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "options": [
        {
          "value": "arrow_right",
          "label": "Arrow-right"
        },
        {
          "value": "account",
          "label": "Account"
        },
        {
          "value": "cart",
          "label": "Cart"
        }
      ],
      "default": "arrow_right",
      "visible_if": "{{ block.settings.source == 'library' }}"
    },
    {
      "type": "image_picker",
      "id": "custom_icon",
      "label": "Custom icon",
      "visible_if": "{{ block.settings.source == 'custom' }}"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Open link in new tab",
      "default": false,
      "visible_if": "{{ block.settings.link != blank }}"
    },
    {
      "type": "header",
      "content": "Size"
    },
    {
      "type": "range",
      "id": "icon_width",
      "label": "Icon width",
      "min": 12,
      "max": 96,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "icon_padding",
      "label": "Icon padding",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "customize_mobile",
      "label": "Custom for mobile",
      "default": false
    },
    {
      "type": "range",
      "id": "icon_width_mobile",
      "label": "Mobile icon width",
      "min": 12,
      "max": 96,
      "step": 1,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ block.settings.customize_mobile }}"
    },
    {
      "type": "range",
      "id": "icon_padding_mobile",
      "label": "Mobile icon padding",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.customize_mobile }}"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "Right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "customize_mobile_padding",
      "label": "Custom padding mobile",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "label": "Mobile left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "label": "Mobile right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    }
  ],
  "presets": [
    {
      "category": "Block Basic",
      "name": "t:blocks.icon.name"
    }
  ]
}
{% endschema %}
