{% doc %}
  Renders a video with controlled autoplay, loop and ratio behavior.
{% enddoc %}

{% if block.settings.video != blank %}
  <div class="video video--{{ block.settings.ratio }}" {{ block.shopify_attributes }}>
    {{ block.settings.video | video_tag: autoplay: block.settings.autoplay, loop: block.settings.loop, muted: block.settings.autoplay, controls: true }}
  </div>
{% endif %}

{% stylesheet %}
  .video { overflow: hidden; }
  .video video { display: block; width: 100%; height: 100%; object-fit: cover; }
  .video--square, .video--portrait, .video--landscape, .video--wide { aspect-ratio: 16 / 9; }
  .video--square { aspect-ratio: 1 / 1; }
  .video--portrait { aspect-ratio: 3 / 4; }
  .video--landscape { aspect-ratio: 4 / 3; }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.video.name",
  "settings": [
    { "type": "video", "id": "video", "label": "t:blocks.video.source" },
    { "type": "checkbox", "id": "autoplay", "label": "t:blocks.video.autoplay", "default": false },
    { "type": "checkbox", "id": "loop", "label": "t:blocks.video.loop", "default": false },
    { "type": "select", "id": "ratio", "label": "t:blocks.common.ratio", "options": [
      { "value": "adapt", "label": "Adapt" }, { "value": "square", "label": "Square" }, { "value": "portrait", "label": "Portrait" }, { "value": "landscape", "label": "Landscape" }, { "value": "wide", "label": "Wide" }
    ], "default": "adapt" }
  ],
  "presets": [{ "name": "t:blocks.video.name" }]
}
{% endschema %}
