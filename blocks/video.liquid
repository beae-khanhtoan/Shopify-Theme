e"},{"type":"header","content":"Desktop"},{"type":"select","id":"width_desktop","label":"Width","options":[{"value":"fit","label":"Fit"},{"value":"fill","label":"Fill"},{"value":"custom","label":"Custom"}],"default":"fill"},{"type":"range","id":"width_custom_desktop","label":"Custom width","min":1,"max":100,"step":1,"unit":"%","default":100,"visible_if":"{{ block.settings.width_desktop == 'custom' }}"},{"type":"checkbox","id":"limit_width_desktop","label":"Limit width","default":false},{"type":"range","id":"max_width_desktop","label":"Max width","min":0,"max":1600,"step":16,"unit":"px","default":1600,"visible_if":"{{ block.settings.limit_width_desktop }}"},{"type":"header","content":"Mobile"},{"type":"select","id":"width_mobile","label":"Width","options":[{"value":"fit","label":"Fit"},{"value":"fill","label":"Fill"},{"value":"custom","label":"Custom"}],"default":"fill"},{"type":"range","id":"width_custom_mobile","label":"Custom width","min":1,"max":100,"step":1,"unit":"%","default":100,"visible_if":"{{ block.settings.width_mobile == 'custom' }}"},{"type":"checkbox","id":"limit_width_mobile","label":"Limit width","default":false},{"type":"range","id":"max_width_mobile","label":"Max width","min":0,"max":1600,"step":16,"unit":"px","default":1600,"visible_if":"{{ block.settings.limit_width_mobile }}"},{"type":"header","content":"Border"},{"type":"select","id":"corner_radius","label":"Corner radius","options":[{"value":"inherit","label":"Inherit"},{"value":"none","label":"None"},{"value":"small","label":"Small"},{"value":"medium","label":"Medium"},{"value":"large","label":"Large"},{"value":"full","label":"Full"}],"default":"inherit"},{"type":"header","content":"Padding"},{"type":"range","id":"padding_top","label":"Top","min":0,"max":100,"step":1,"unit":"px","default":0},{"type":"range","id":"padding_bottom","label":"Bottom","min":0,"max":100,"step":1,"unit":"px","default":0},{"type":"range","id":"padding_left","label":"Left","min":0,"max":100,"step":1,"unit":"px","default":0},{"type":"range","id":"padding_right","label":"Right","min":0,"max":100,"step":1,"unit":"px","default":0},{"type":"checkbox","id":"customize_mobile_padding","label":"Customize mobile padding","default":false},{"type":"range","id":"padding_top_mobile","label":"Top","min":0,"max":100,"step":1,"unit":"px","default":0,"visible_if":"{{ block.settings.customize_mobile_padding }}"},{"type":"range","id":"padding_bottom_mobile","label":"Bottom","min":0,"max":100,"step":1,"unit":"px","default":0,"visible_if":"{{ block.settings.customize_mobile_padding }}"},{"type":"range","id":"padding_left_mobile","label":"Left","min":0,"max":100,"step":1,"unit":"px","default":0,"visible_if":"{{ block.settings.customize_mobile_padding }}"},{"type":"range","id":"padding_right_mobile","label":"Right","min":0,"max":100,"step":1,"unit":"px","default":0,"visible_if":"{{ block.settings.customize_mobile_padding }}"}],"presets":[{"name":"t:blocks.video.name"}]}
{% endschema %}
