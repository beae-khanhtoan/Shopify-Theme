{% doc %}
  Renders responsive video with reduced-motion-safe autoplay behavior.
{% enddoc %}

{% assign video_width = '100%' %}
{% if block.settings.width == 'fit' %}{% assign video_width = 'fit-content' %}{% elsif block.settings.width == 'custom' %}{% assign video_width = block.settings.max_width | append: 'px' %}{% endif %}
{% assign video_source = block.settings.video_url %}

{% if block.settings.video != blank or video_source != blank %}
  <div class="video video--{{ block.settings.aspect_ratio }} video--device-{{ block.settings.device }} video--mobile-first-{{ block.settings.show_video_first_on_mobile }} video--radius-{{ block.settings.corner_radius }}" style="--video-width: {{ video_width }}; --video-padding: {{ block.settings.padding }}px; --play-color: {{ block.settings.play_button_color }}; --background-color: {{ block.settings.background_color }};" {{ block.shopify_attributes }}>
    {% if block.settings.video != blank %}
      {{ block.settings.video | video_tag: autoplay: block.settings.autoplay, loop: block.settings.loop, muted: block.settings.autoplay, controls: true, poster: block.settings.cover_image }}
    {% else %}
      <video {% if block.settings.autoplay %}autoplay muted{% endif %} {% if block.settings.loop %}loop{% endif %} controls playsinline{% if block.settings.cover_image != blank %} poster="{{ block.settings.cover_image | image_url: width: 1600 }}"{% endif %}><source src="{{ video_source }}" type="video/mp4"></video>
    {% endif %}
    {% if block.settings.show_play_button %}<span class="video__play" aria-hidden="true">▶</span>{% endif %}
  </div>
{% endif %}

{% javascript %}
  document.querySelectorAll('.video video[autoplay]').forEach((video) => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      video.autoplay = false;
      video.removeAttribute('autoplay');
      video.pause();
    }
  });
{% endjavascript %}

{% stylesheet %}
  .video { position: relative; width: var(--video-width); max-width: 100%; overflow: hidden; padding: var(--video-padding); background: var(--background-color); }
  .video video { display: block; width: 100%; height: 100%; object-fit: cover; }
  .video--adapt { aspect-ratio: auto; }
  .video--square, .video--portrait, .video--landscape, .video--wide { aspect-ratio: 16 / 9; }
  .video--square { aspect-ratio: 1 / 1; }
  .video--portrait { aspect-ratio: 3 / 4; }
  .video--landscape { aspect-ratio: 4 / 3; }
  .video--radius-inherit { border-radius: inherit; }
  .video--radius-none { border-radius: var(--radius-square); }
  .video--radius-small { border-radius: var(--radius-slight); }
  .video--radius-medium { border-radius: var(--radius-rounded); }
  .video--radius-large { border-radius: var(--radius-extra); }
  .video__play { position: absolute; inset: 50% auto auto 50%; display: grid; width: 3rem; height: 3rem; place-items: center; transform: translate(-50%, -50%); color: var(--play-color); pointer-events: none; }
  @media (max-width: 767.98px) { .video--device-desktop { display: none; } .video--mobile-first-false { order: 2; } }
  @media (min-width: 768px) { .video--device-mobile { display: none; } }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.video.name",
  "settings": [
    { "type": "select", "id": "source", "label": "t:blocks.video.source_type", "options": [{ "value": "uploaded", "label": "Uploaded" }, { "value": "external", "label": "External URL" }], "default": "uploaded" },
    { "type": "video", "id": "video", "label": "t:blocks.video.source", "visible_if": "{{ block.settings.source == 'uploaded' }}" },
    { "type": "url", "id": "video_url", "label": "t:blocks.video.external_url", "visible_if": "{{ block.settings.source == 'external' }}" },
    { "type": "checkbox", "id": "autoplay", "label": "t:blocks.video.autoplay", "default": false },
    { "type": "checkbox", "id": "loop", "label": "t:blocks.video.loop", "default": false },
    { "type": "image_picker", "id": "cover_image", "label": "t:blocks.video.cover" },
    { "type": "select", "id": "aspect_ratio", "label": "t:blocks.video.aspect_ratio", "options": [{ "value": "adapt", "label": "Adapt" }, { "value": "square", "label": "Square" }, { "value": "portrait", "label": "Portrait" }, { "value": "landscape", "label": "Landscape" }, { "value": "wide", "label": "Wide" }], "default": "adapt" },
    { "type": "checkbox", "id": "show_play_button", "label": "t:blocks.video.play_button", "default": true },
    { "type": "checkbox", "id": "show_video_first_on_mobile", "label": "t:blocks.video.mobile_first", "default": true },
    { "type": "color", "id": "play_button_color", "label": "t:blocks.video.play_color", "default": "#FFFFFF" },
    { "type": "color", "id": "background_color", "label": "t:blocks.video.background_color", "default": "#000000" },
    { "type": "select", "id": "device", "label": "t:blocks.image.device", "options": [{ "value": "all", "label": "All devices" }, { "value": "desktop", "label": "Desktop only" }, { "value": "mobile", "label": "Mobile only" }], "default": "all" },
    { "type": "select", "id": "width", "label": "t:blocks.common.width", "options": [{ "value": "fit", "label": "Fit" }, { "value": "fill", "label": "Fill" }, { "value": "custom", "label": "Custom" }], "default": "fill" },
    { "type": "checkbox", "id": "limit_width", "label": "t:blocks.image.limit_width", "default": false },
    { "type": "range", "id": "max_width", "label": "t:blocks.image.max_width", "min": 320, "max": 1600, "step": 20, "unit": "px", "default": 800, "visible_if": "{{ block.settings.width == 'custom' or block.settings.limit_width }}" },
    { "type": "select", "id": "corner_radius", "label": "t:blocks.image.radius", "options": [{ "value": "inherit", "label": "Inherit" }, { "value": "none", "label": "None" }, { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" }], "default": "inherit" },
    { "type": "range", "id": "padding", "label": "t:blocks.common.padding", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 }
  ],
  "presets": [{ "name": "t:blocks.video.name" }]
}
{% endschema %}
