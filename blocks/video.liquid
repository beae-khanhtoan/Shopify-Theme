{% doc %}
  Renders an uploaded or external video with responsive sizing and reduced-motion-safe autoplay.
{% enddoc %}

{% assign video_width_desktop = 'fit-content' %}{% if block.settings.width_desktop == 'fill' %}{% assign video_width_desktop = '100%' %}{% elsif block.settings.width_desktop == 'custom' %}{% assign video_width_desktop = block.settings.width_custom_desktop | append: '%' %}{% endif %}
{% assign video_width_mobile = 'fit-content' %}{% if block.settings.width_mobile == 'fill' %}{% assign video_width_mobile = '100%' %}{% elsif block.settings.width_mobile == 'custom' %}{% assign video_width_mobile = block.settings.width_custom_mobile | append: '%' %}{% endif %}
{% assign video_max_width_desktop = '100%' %}{% if block.settings.limit_width_desktop %}{% assign video_max_width_desktop = block.settings.max_width_desktop | append: 'px' %}{% endif %}
{% assign video_max_width_mobile = '100%' %}{% if block.settings.limit_width_mobile %}{% assign video_max_width_mobile = block.settings.max_width_mobile | append: 'px' %}{% endif %}
{% assign video_ratio = 'auto' %}{% case block.settings.aspect_ratio %}{% when 'square' %}{% assign video_ratio = '1 / 1' %}{% when 'portrait' %}{% assign video_ratio = '3 / 4' %}{% when 'landscape' %}{% assign video_ratio = '4 / 3' %}{% when 'wide' %}{% assign video_ratio = '16 / 9' %}{% when 'custom' %}{% assign video_ratio = block.settings.custom_aspect_ratio | append: ' / 1' %}{% endcase %}
{% assign video_content = block.settings.video %}{% assign external_video = block.settings.external_video_url %}

{% if video_content != blank or external_video != blank %}
  <div class="video video--{{ block.settings.aspect_ratio }}{% if block.settings.show_video_first_mobile %} video--mobile-first{% endif %}" style="--video-width: {{ video_width_desktop }}; --video-width-mobile: {{ video_width_mobile }}; --video-max-width: {{ video_max_width_desktop }}; --video-max-width-mobile: {{ video_max_width_mobile }}; --video-ratio: {{ video_ratio }}; --video-radius: {% if block.settings.corner_radius == 'full' %}999px{% elsif block.settings.corner_radius == 'none' %}0px{% elsif block.settings.corner_radius == 'small' %}var(--radius-slight){% elsif block.settings.corner_radius == 'medium' %}var(--radius-rounded){% elsif block.settings.corner_radius == 'large' %}var(--radius-extra){% else %}inherit{% endif %}; --video-padding-top: {{ block.settings.padding_top }}px; --video-padding-right: {{ block.settings.padding_right }}px; --video-padding-bottom: {{ block.settings.padding_bottom }}px; --video-padding-left: {{ block.settings.padding_left }}px; --video-padding-top-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_top_mobile }}{% else %}{{ block.settings.padding_top }}{% endif %}px; --video-padding-right-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_right_mobile }}{% else %}{{ block.settings.padding_right }}{% endif %}px; --video-padding-bottom-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_bottom_mobile }}{% else %}{{ block.settings.padding_bottom }}{% endif %}px; --video-padding-left-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_left_mobile }}{% else %}{{ block.settings.padding_left }}{% endif %}px; --play-button-size: {{ block.settings.play_button_size_desktop }}px; --play-button-size-mobile: {{ block.settings.play_button_size_mobile }}px; --play-button-background: {{ block.settings.play_button_background }}; --play-button-icon: {{ block.settings.play_button_icon_color }};" {{ block.shopify_attributes }}>
    {% if block.settings.video_source == 'external_url' and external_video != blank %}
      {{ external_video | external_video_tag: image_size: '1600x', autoplay: block.settings.autoplay, loop: block.settings.loop_video, muted: block.settings.autoplay, controls: true }}
    {% elsif video_content != blank %}
      {{ video_content | video_tag: autoplay: block.settings.autoplay, loop: block.settings.loop_video, muted: block.settings.autoplay, controls: true, playsinline: true, poster: block.settings.cover_image }}
    {% endif %}
    {% if block.settings.show_play_button %}<span class="video__play" aria-hidden="true">▶</span>{% endif %}
  </div>
{% else %}
  <div class="video video--placeholder" style="--video-width: {{ video_width_desktop }}; --video-width-mobile: {{ video_width_mobile }}; --video-max-width: {{ video_max_width_desktop }}; --video-max-width-mobile: {{ video_max_width_mobile }}; --video-ratio: {{ video_ratio }}; --video-radius: inherit;" {{ block.shopify_attributes }}>{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}</div>
{% endif %}

{% javascript %}
  document.querySelectorAll('.video video[autoplay]').forEach((video) => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      video.autoplay = false;
      video.removeAttribute('autoplay');
      video.pause();
    }
  });
{% endjavascript %}

{% stylesheet %}
  .video { position: relative; box-sizing: border-box; width: var(--video-width); max-width: var(--video-max-width); aspect-ratio: var(--video-ratio); overflow: hidden; border-radius: var(--video-radius); padding: var(--video-padding-top) var(--video-padding-right) var(--video-padding-bottom) var(--video-padding-left); }
  .video video, .video iframe, .video .placeholder-svg { display: block; width: 100%; height: 100%; object-fit: cover; }
  .video__play { position: absolute; inset: 50% auto auto 50%; display: grid; width: var(--play-button-size); height: var(--play-button-size); place-items: center; transform: translate(-50%, -50%); border-radius: 50%; background: var(--play-button-background); color: var(--play-button-icon); pointer-events: none; }
  @media (max-width: 767.98px) { .video { width: var(--video-width-mobile); max-width: var(--video-max-width-mobile); padding: var(--video-padding-top-mobile) var(--video-padding-right-mobile) var(--video-padding-bottom-mobile) var(--video-padding-left-mobile); }.video__play { width: var(--play-button-size-mobile); height: var(--play-button-size-mobile); } }
{% endstylesheet %}

