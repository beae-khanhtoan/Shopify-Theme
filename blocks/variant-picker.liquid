{% doc %}Variant option controls. Selection is emitted to the parent product form; this block never mutates cart state.{% enddoc %}
{% if product != blank and product.options_with_values != blank %}<div class="commerce-variant-picker" style="--variant-padding-top: {{ block.settings.padding_top }}px; --variant-padding-bottom: {{ block.settings.padding_bottom }}px; --variant-padding-top-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_top_mobile }}{% else %}{{ block.settings.padding_top }}{% endif %}px; --variant-padding-bottom-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_bottom_mobile }}{% else %}{{ block.settings.padding_bottom }}{% endif %}px;" {{ block.shopify_attributes }}>{% for option in product.options_with_values %}<fieldset class="commerce-variant-picker__option"><legend>{{ option.name | escape }}</legend><div class="commerce-variant-picker__values">{% for value in option.values %}<label><input type="radio" name="options[{{ option.name | escape }}]" value="{{ value | escape }}"{% if option.selected_value == value %} checked{% endif %}><span>{{ value | escape }}</span></label>{% endfor %}</div></fieldset>{% endfor %}{% for option in product.options_with_values %}{% if option.name == block.settings.size_chart_option_name and block.settings.size_chart_page != blank %}<a class="commerce-variant-picker__size-chart" href="{{ block.settings.size_chart_page.url }}" data-desktop-layout="{{ block.settings.size_chart_desktop_layout }}" data-mobile-layout="{{ block.settings.size_chart_mobile_layout }}" style="--size-chart-width: {{ block.settings.size_chart_width }}px;">Size chart</a>{% endif %}{% endfor %}</div>{% endif %}
{% stylesheet %}.commerce-variant-picker { display: grid; gap: var(--space-medium); padding-block: var(--variant-padding-top) var(--variant-padding-bottom); }.commerce-variant-picker__option { border: 0; padding: 0; margin: 0; }.commerce-variant-picker__values { display: flex; flex-wrap: wrap; gap: var(--space-small); }.commerce-variant-picker__values label { cursor: pointer; }.commerce-variant-picker__values input { position: absolute; opacity: 0; }.commerce-variant-picker__values input + span { display: inline-block; border: 1px solid currentColor; padding: .5em .75em; }.commerce-variant-picker__values input:checked + span { background: currentColor; color: var(--color-background); }.commerce-variant-picker__size-chart { justify-self: start; max-width: var(--size-chart-width); } @media (max-width: 767.98px) { .commerce-variant-picker { padding-block: var(--variant-padding-top-mobile) var(--variant-padding-bottom-mobile); } }{% endstylesheet %}
{% schema %}{"name":"t:blocks.commerce.variant_picker_name","settings":[{"type":"text","id":"size_chart_option_name","label":"Size chart option name","default":"Size"},{"type":"page","id":"size_chart_page","label":"Size chart page"},{"type":"select","id":"size_chart_desktop_layout","label":"Desktop layout","options":[{"value":"popup","label":"Popup"},{"value":"drawer","label":"Drawer"}],"default":"popup"},{"type":"range","id":"size_chart_width","label":"Size chart width","min":320,"max":800,"step":20,"unit":"px","default":600},{"type":"select","id":"size_chart_mobile_layout","label":"Mobile layout","options":[{"value":"bottom_sheet","label":"Bottom sheet"},{"value":"drawer","label":"Drawer"}],"default":"bottom_sheet"},{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":100,"step":1,"unit":"px","default":0},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":100,"step":1,"unit":"px","default":0},{"type":"checkbox","id":"customize_mobile_padding","label":"Custom mobile padding","default":false},{"type":"range","id":"padding_top_mobile","label":"Mobile top padding","min":0,"max":100,"step":1,"unit":"px","default":0,"visible_if":"{{ block.settings.customize_mobile_padding }}"},{"type":"range","id":"padding_bottom_mobile","label":"Mobile bottom padding","min":0,"max":100,"step":1,"unit":"px","default":0,"visible_if":"{{ block.settings.customize_mobile_padding }}"}],"presets":[{"name":"t:blocks.commerce.variant_picker_name"}]}{% endschema %}
