{% doc %}Structural layout group owning flow, width, gap and alignment only.{% enddoc %}
{% assign group_width = '100%' %}{% if block.settings.width == 'content' %}{% assign group_width = 'fit-content' %}{% elsif block.settings.width == 'custom' %}{% assign group_width = block.settings.max_width | append: 'px' %}{% endif %}
{% assign group_gap = 'var(--space-medium)' %}{% if block.settings.gap == 'none' %}{% assign group_gap = '0px' %}{% elsif block.settings.gap == 'small' %}{% assign group_gap = 'var(--space-small)' %}{% elsif block.settings.gap == 'large' %}{% assign group_gap = 'var(--space-large)' %}{% endif %}
<div class="block-group block-group--{{ block.settings.layout_mode }}{% if block.settings.stack_on_mobile %} block-group--stack-mobile{% endif %}" style="--group-width: {{ group_width }}; --group-gap: {{ group_gap }}; --group-horizontal-align: {{ block.settings.horizontal_alignment }}; --group-vertical-align: {{ block.settings.vertical_alignment }}; --group-text-align: {{ block.settings.text_alignment }};" {{ block.shopify_attributes }}>{% content_for 'blocks' %}</div>
{% stylesheet %}.block-group { box-sizing: border-box; min-width: 0; width: var(--group-width); max-width: 100%; display: flex; gap: var(--group-gap); align-items: var(--group-vertical-align); justify-content: var(--group-horizontal-align); text-align: var(--group-text-align); overflow: hidden; }.block-group--stack { flex-direction: column; }.block-group--row { flex-direction: row; flex-wrap: wrap; }.block-group--grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }.block-group > * { min-width: 0; max-width: 100%; } @media (max-width: 767.98px) { .block-group--stack-mobile { flex-direction: column; }.block-group--grid { grid-template-columns: minmax(0, 1fr); } }{% endstylesheet %}
{% schema %}
{"name":"t:blocks.group.name","blocks":[{"type":"heading"},{"type":"text"},{"type":"eyebrow"},{"type":"button"},{"type":"image"},{"type":"video"},{"type":"icon"},{"type":"header"}],"settings":[{"type":"select","id":"layout_mode","label":"t:blocks.layout.layout_mode","options":[{"value":"stack","label":"Stack"},{"value":"row","label":"Row"},{"value":"grid","label":"Grid"}],"default":"stack"},{"type":"select","id":"width","label":"t:blocks.layout.width","options":[{"value":"auto","label":"Auto"},{"value":"full","label":"Full"},{"value":"content","label":"Content"},{"value":"custom","label":"Custom"}],"default":"full"},{"type":"range","id":"max_width","label":"t:blocks.layout.max_width","min":320,"max":1600,"step":20,"unit":"px","default":800,"visible_if":"{{ block.settings.width == 'custom' }}"},{"type":"select","id":"gap","label":"t:blocks.layout.gap","options":[{"value":"none","label":"None"},{"value":"small","label":"Small"},{"value":"medium","label":"Medium"},{"value":"large","label":"Large"}],"default":"medium"},{"type":"select","id":"horizontal_alignment","label":"t:blocks.layout.horizontal_alignment","options":[{"value":"flex-start","label":"Start"},{"value":"center","label":"Center"},{"value":"flex-end","label":"End"},{"value":"stretch","label":"Stretch"}],"default":"stretch"},{"type":"select","id":"vertical_alignment","label":"t:blocks.layout.vertical_alignment","options":[{"value":"flex-start","label":"Start"},{"value":"center","label":"Center"},{"value":"flex-end","label":"End"},{"value":"stretch","label":"Stretch"}],"default":"stretch"},{"type":"select","id":"text_alignment","label":"t:blocks.layout.text_alignment","options":[{"value":"start","label":"Start"},{"value":"center","label":"Center"},{"value":"end","label":"End"}],"default":"start"},{"type":"checkbox","id":"stack_on_mobile","label":"t:blocks.layout.stack_on_mobile","default":true}],"presets":[{"name":"t:blocks.group.name"}]}
{% endschema %}
