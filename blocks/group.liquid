{% doc %}Structural layout group owning flow, width, gap and alignment only.{% enddoc %}
{% assign group_width = '100%' %}{% if block.settings.width == 'content' %}{% assign group_width = 'fit-content' %}{% elsif block.settings.width == 'custom' %}{% assign group_width = block.settings.max_width | append: 'px' %}{% endif %}
{% assign group_gap = 'var(--space-medium)' %}{% if block.settings.gap == 'none' %}{% assign group_gap = '0px' %}{% elsif block.settings.gap == 'small' %}{% assign group_gap = 'var(--space-small)' %}{% elsif block.settings.gap == 'large' %}{% assign group_gap = 'var(--space-large)' %}{% endif %}
{% assign group_gap_mobile = 'var(--space-medium)' %}{% if block.settings.gap_mobile == 'none' %}{% assign group_gap_mobile = '0px' %}{% elsif block.settings.gap_mobile == 'small' %}{% assign group_gap_mobile = 'var(--space-small)' %}{% elsif block.settings.gap_mobile == 'large' %}{% assign group_gap_mobile = 'var(--space-large)' %}{% endif %}
<div class="block-group block-group--{{ block.settings.layout_mode }}{% if block.settings.stack_on_mobile %} block-group--stack-mobile{% endif %}{% unless block.settings.wrap %} block-group--no-wrap{% endunless %}{% if block.settings.show_background %} block-group--surface{% endif %}" style="--group-width: {{ group_width }}; --group-gap: {{ group_gap }}; --group-gap-mobile: {{ group_gap_mobile }}; --group-horizontal-align: {{ block.settings.horizontal_alignment }}; --group-vertical-align: {{ block.settings.vertical_alignment }}; --group-text-align: {{ block.settings.text_alignment }}; --group-border-thickness: {{ block.settings.border_thickness }}px; --group-radius: {{ block.settings.corner_radius }}px; --group-padding-top: {{ block.settings.padding_top }}px; --group-padding-right: {{ block.settings.padding_right }}px; --group-padding-bottom: {{ block.settings.padding_bottom }}px; --group-padding-left: {{ block.settings.padding_left }}px; --group-padding-top-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_top_mobile }}{% else %}{{ block.settings.padding_top }}{% endif %}px; --group-padding-right-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_right_mobile }}{% else %}{{ block.settings.padding_right }}{% endif %}px; --group-padding-bottom-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_bottom_mobile }}{% else %}{{ block.settings.padding_bottom }}{% endif %}px; --group-padding-left-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_left_mobile }}{% else %}{{ block.settings.padding_left }}{% endif %}px;" {{ block.shopify_attributes }}>{% content_for 'blocks' %}</div>
{% stylesheet %}.block-group { box-sizing: border-box; min-width: 0; width: var(--group-width); max-width: 100%; display: flex; gap: var(--group-gap); align-items: var(--group-vertical-align); justify-content: var(--group-horizontal-align); text-align: var(--group-text-align); padding: var(--group-padding-top) var(--group-padding-right) var(--group-padding-bottom) var(--group-padding-left); border: var(--group-border-thickness) solid transparent; border-radius: var(--group-radius); overflow: clip; }.block-group--surface { background: var(--color-background); border-color: var(--color-border); }.block-group--stack { flex-direction: column; }.block-group--row { flex-direction: row; flex-wrap: wrap; }.block-group--no-wrap { flex-wrap: nowrap; }.block-group--grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }.block-group > * { min-width: 0; max-width: 100%; } @media (max-width: 767.98px) { .block-group { gap: var(--group-gap-mobile); padding: var(--group-padding-top-mobile) var(--group-padding-right-mobile) var(--group-padding-bottom-mobile) var(--group-padding-left-mobile); }.block-group--stack-mobile { flex-direction: column; }.block-group--grid { grid-template-columns: minmax(0, 1fr); } }{% endstylesheet %}
