{% doc %}Pagination controls for the current paginate context, with accessible state labels.{% enddoc %}
{% # theme-check-disable UndefinedObject %}
{% assign last_page_before = paginate.pages | minus: 1 %}{% assign show_first_ellipsis = false %}{% assign show_last_ellipsis = false %}{% if block.settings.show_first_last and block.settings.ellipsis_behavior != 'never' %}{% if block.settings.ellipsis_behavior == 'always' or paginate.current_page > 2 %}{% assign show_first_ellipsis = true %}{% endif %}{% if block.settings.ellipsis_behavior == 'always' or paginate.current_page < last_page_before %}{% assign show_last_ellipsis = true %}{% endif %}{% endif %}{% if paginate != blank and paginate.pages > 1 %}<nav class="navigation-pagination navigation-pagination--{{ block.settings.flow }} navigation-pagination--{{ block.settings.control_variant }} navigation-pagination--{{ block.settings.current_state }} navigation-pagination--ellipsis-{{ block.settings.ellipsis_behavior }}{% if block.settings.mobile_compact_mode %} navigation-pagination--mobile-compact{% endif %}" aria-label="Pagination" style="--pagination-gap: {{ block.settings.gap }}px; --pagination-align: {{ block.settings.alignment }}; --pagination-padding-top: {{ block.settings.padding_top }}px; --pagination-padding-bottom: {{ block.settings.padding_bottom }}px; --pagination-padding-left: {{ block.settings.padding_left }}px; --pagination-padding-right: {{ block.settings.padding_right }}px; --pagination-padding-top-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_top_mobile }}{% else %}{{ block.settings.padding_top }}{% endif %}px; --pagination-padding-bottom-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_bottom_mobile }}{% else %}{{ block.settings.padding_bottom }}{% endif %}px; --pagination-padding-left-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_left_mobile }}{% else %}{{ block.settings.padding_left }}{% endif %}px; --pagination-padding-right-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_right_mobile }}{% else %}{{ block.settings.padding_right }}{% endif %}px;" {{ block.shopify_attributes }}>
  <ol class="navigation-pagination__list" role="list">
    {% if block.settings.show_previous and paginate.previous %}<li><a href="{{ paginate.previous.url }}" rel="prev" aria-label="{{ block.settings.previous_label }}">{{ block.settings.previous_label }}</a></li>{% endif %}
    {% if show_first_ellipsis %}<li><a href="{{ paginate.parts.first.url }}">1</a></li><li aria-hidden="true">…</li>{% endif %}
    {% if block.settings.show_page_numbers %}{% for part in paginate.parts %}{% if part.is_link %}<li><a href="{{ part.url }}">{{ part.title }}</a></li>{% else %}<li><span{% if part.title == paginate.current_page %} aria-current="page"{% endif %}>{{ part.title }}</span></li>{% endif %}{% endfor %}{% endif %}
    {% if show_last_ellipsis %}<li aria-hidden="true">…</li><li><a href="{{ paginate.parts.last.url }}">{{ paginate.pages }}</a></li>{% endif %}
    {% if block.settings.show_next and paginate.next %}<li><a href="{{ paginate.next.url }}" rel="next" aria-label="{{ block.settings.next_label }}">{{ block.settings.next_label }}</a></li>{% endif %}
  </ol>
</nav>{% endif %}
{% # theme-check-enable UndefinedObject %}
{% stylesheet %}.navigation-pagination { width: 100%; padding: var(--pagination-padding-top) var(--pagination-padding-right) var(--pagination-padding-bottom) var(--pagination-padding-left); }.navigation-pagination__list { display: flex; flex-wrap: wrap; justify-content: var(--pagination-align); gap: var(--pagination-gap); margin: 0; padding: 0; list-style: none; }.navigation-pagination--inline .navigation-pagination__list { flex-wrap: nowrap; }.navigation-pagination a,.navigation-pagination span { display: inline-flex; min-width: 2.5rem; min-height: 2.5rem; align-items: center; justify-content: center; padding-inline: .65rem; color: inherit; text-decoration: none; border: 1px solid currentColor; }.navigation-pagination--link a { border-color: transparent; }.navigation-pagination--filled a { background: currentColor; color: var(--color-background); }.navigation-pagination--minimal a { min-width: auto; min-height: auto; border-color: transparent; padding-inline: .25rem; }.navigation-pagination--outline a { background: transparent; }.navigation-pagination--filled span[aria-current="page"],.navigation-pagination--outline span[aria-current="page"] { background: currentColor; color: var(--color-background); }.navigation-pagination--minimal span[aria-current="page"] { border-bottom: 2px solid currentColor; }.navigation-pagination--ellipsis-never li[aria-hidden="true"] { display: none; } @media (max-width: 767.98px) { .navigation-pagination { padding: var(--pagination-padding-top-mobile) var(--pagination-padding-right-mobile) var(--pagination-padding-bottom-mobile) var(--pagination-padding-left-mobile); } .navigation-pagination--mobile-compact .navigation-pagination__list li:not(:first-child):not(:last-child) { display: none; } }{% endstylesheet %}
{% schema %}{"name":"t:blocks.navigation.pagination_name","settings":[{"type":"header","content":"Content"},{"type":"checkbox","id":"show_previous","label":"Previous control","default":true},{"type":"checkbox","id":"show_next","label":"Next control","default":true},{"type":"checkbox","id":"show_page_numbers","label":"Page numbers","default":true},{"type":"checkbox","id":"show_first_last","label":"First / last controls","default":false},{"type":"select","id":"ellipsis_behavior","label":"Ellipsis behavior","options":[{"value":"auto","label":"Auto"},{"value":"always","label":"Always show"},{"value":"never","label":"Hide"}],"default":"auto"},{"type":"header","content":"Labels"},{"type":"text","id":"previous_label","label":"Previous label","default":"Previous"},{"type":"text","id":"next_label","label":"Next label","default":"Next"},{"type":"header","content":"Appearance"},{"type":"select","id":"control_variant","label":"Control variant","options":[{"value":"link","label":"Link"},{"value":"outline","label":"Outline"},{"value":"filled","label":"Filled"}],"default":"link"},{"type":"select","id":"current_state","label":"Current state","options":[{"value":"filled","label":"Filled"},{"value":"outline","label":"Outline"},{"value":"minimal","label":"Minimal"}],"default":"filled"},{"type":"header","content":"Layout"},{"type":"select","id":"alignment","label":"Alignment","options":[{"value":"start","label":"Start"},{"value":"center","label":"Center"},{"value":"end","label":"End"}],"default":"start"},{"type":"select","id":"flow","label":"Flow","options":[{"value":"inline","label":"Inline"},{"value":"wrap","label":"Wrap"}],"default":"wrap"},{"type":"checkbox","id":"mobile_compact_mode","label":"Mobile compact mode","default":true},{"type":"range","id":"gap","label":"Gap","min":0,"max":64,"step":1,"unit":"px","default":8},{"type":"header","content":"Padding"},{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":100,"step":1,"unit":"px","default":0},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":100,"step":1,"unit":"px","default":0},{"type":"range","id":"padding_left","label":"Left padding","min":0,"max":100,"step":1,"unit":"px","default":0},{"type":"range","id":"padding_right","label":"Right padding","min":0,"max":100,"step":1,"unit":"px","default":0},{"type":"checkbox","id":"customize_mobile_padding","label":"Customize mobile padding","default":false},{"type":"range","id":"padding_top_mobile","label":"Mobile top padding","min":0,"max":100,"step":1,"unit":"px","default":0,"visible_if":"{{ block.settings.customize_mobile_padding }}"},{"type":"range","id":"padding_bottom_mobile","label":"Mobile bottom padding","min":0,"max":100,"step":1,"unit":"px","default":0,"visible_if":"{{ block.settings.customize_mobile_padding }}"},{"type":"range","id":"padding_left_mobile","label":"Mobile left padding","min":0,"max":100,"step":1,"unit":"px","default":0,"visible_if":"{{ block.settings.customize_mobile_padding }}"},{"type":"range","id":"padding_right_mobile","label":"Mobile right padding","min":0,"max":100,"step":1,"unit":"px","default":0,"visible_if":"{{ block.settings.customize_mobile_padding }}"}],"presets":[{"name":"t:blocks.navigation.pagination_name"}]}{% endschema %}
