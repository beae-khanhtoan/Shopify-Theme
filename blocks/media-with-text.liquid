{% doc %}Media and text composition with responsive order.{% enddoc %}
<div class="composition-media-text composition-media-text--{{ block.settings.media_position }}" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy' }}{% else %}{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}{% endif %}<div class="composition-media-text__content">{% if block.settings.heading != blank %}<h2>{{ block.settings.heading }}</h2>{% endif %}{{ block.settings.text }}</div></div>
{% stylesheet %}.composition-media-text{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-large);align-items:center}.composition-media-text--right>img{order:2}.composition-media-text img,.composition-media-text svg{display:block;width:100%;height:auto}.composition-media-text__content{min-width:0}@media(max-width:767.98px){.composition-media-text{grid-template-columns:1fr}.composition-media-text--right>img{order:0}}{% endstylesheet %}
{% schema %}{"name":"Media with text","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"heading","label":"Heading","default":"Media with text"},{"type":"richtext","id":"text","label":"Text","default":"<p>Tell your story.</p>"},{"type":"select","id":"media_position","label":"Media position","options":[{"value":"left","label":"Left"},{"value":"right","label":"Right"}],"default":"left"}],"presets":[{"name":"Media with text"}]}{% endschema %}
