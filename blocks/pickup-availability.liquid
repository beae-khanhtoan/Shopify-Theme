{% doc %}Pickup availability placeholder driven by the current product context.{% enddoc %}
{% if product != blank and block.settings.show_pickup %}<div class="commerce-pickup" {{ block.shopify_attributes }}><strong>{{ block.settings.heading }}</strong><span>Pickup availability will be shown for the selected variant.</span></div>{% endif %}
{% stylesheet %}.commerce-pickup { display: grid; gap: .25rem; padding-block: var(--space-small); color: var(--color-muted); }{% endstylesheet %}
{% schema %}{"name":"t:blocks.commerce.pickup_availability_name","settings":[{"type":"checkbox","id":"show_pickup","label":"Show pickup availability","default":true},{"type":"text","id":"heading","label":"Heading","default":"Pickup availability"}],"presets":[{"name":"t:blocks.commerce.pickup_availability_name"}]}{% endschema %}
