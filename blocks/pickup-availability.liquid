{% doc %}Pickup locations for the selected product variant.{% enddoc %}
{% if product != blank %}
  {% assign pickup_variant = product.selected_or_first_available_variant %}
  {% if pickup_variant.store_availabilities != blank %}
    <div class="commerce-pickup commerce-pickup--scheme-{{ block.settings.color_scheme }} commerce-pickup--{{ block.settings.desktop_layout }} commerce-pickup--mobile-{{ block.settings.mobile_layout }} commerce-pickup--message-{{ block.settings.pickup_message_size }} commerce-pickup--message-{{ block.settings.pickup_message_color }} commerce-pickup--shadow-{{ block.settings.shadow }}{% if block.settings.enable_boxed_layout %} commerce-pickup--boxed{% endif %}" style="--pickup-border: {{ block.settings.border_thickness }}px; --pickup-radius: {{ block.settings.corner_radius }}; --pickup-padding-top: {{ block.settings.padding_top }}px; --pickup-padding-bottom: {{ block.settings.padding_bottom }}px; --pickup-padding-top-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_top_mobile }}{% else %}{{ block.settings.padding_top }}{% endif %}px; --pickup-padding-bottom-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_bottom_mobile }}{% else %}{{ block.settings.padding_bottom }}{% endif %}px;" {{ block.shopify_attributes }}>
      {% for availability in pickup_variant.store_availabilities %}
        <div class="commerce-pickup__location commerce-pickup__location--{{ availability.pick_up_enabled }}">
          <strong>{{ availability.location.name }}</strong>
          <span>{{ availability.pick_up_enabled | default: false | replace: 'true', 'Available for pickup' | replace: 'false', 'Unavailable for pickup' }}</span>
        </div>
      {% endfor %}
    </div>
  {% endif %}
{% endif %}
{% stylesheet %}
.commerce-pickup { display: grid; gap: .75rem; padding-block: var(--pickup-padding-top) var(--pickup-padding-bottom); color: var(--color-foreground); }
.commerce-pickup--boxed { border: var(--pickup-border) solid currentColor; border-radius: var(--pickup-radius); padding-inline: 1rem; }
.commerce-pickup__location { display: grid; gap: .2rem; }.commerce-pickup--message-sm { font-size: .875rem; }.commerce-pickup--message-md { font-size: 1rem; }.commerce-pickup--message-lg { font-size: 1.125rem; }.commerce-pickup--message-heading { color: var(--color-foreground); }.commerce-pickup--message-text { color: var(--color-muted); }.commerce-pickup--shadow-small { box-shadow: var(--shadow-small, 0 2px 8px rgb(0 0 0 / .12)); }.commerce-pickup--shadow-medium { box-shadow: var(--shadow-medium, 0 6px 20px rgb(0 0 0 / .16)); }
.commerce-pickup__location--false { color: var(--color-muted); }
@media (max-width: 767.98px) { .commerce-pickup { padding-block: var(--pickup-padding-top-mobile) var(--pickup-padding-bottom-mobile); } }
{% endstylesheet %}
{% schema %}{"name":"t:blocks.commerce.pickup_availability_name","settings":[{"type":"checkbox","id":"enable_boxed_layout","label":"Enable boxed layout","default":false},{"type":"select","id":"desktop_layout","label":"Desktop layout","options":[{"value":"popup","label":"Popup"},{"value":"drawer","label":"Drawer"}],"default":"popup"},{"type":"select","id":"mobile_layout","label":"Mobile layout","options":[{"value":"bottom_sheet","label":"Bottom sheet"},{"value":"drawer","label":"Drawer"}],"default":"bottom_sheet"},{"type":"select","id":"pickup_message_size","label":"Pickup message size","options":[{"value":"sm","label":"Small"},{"value":"md","label":"Medium"},{"value":"lg","label":"Large"}],"default":"md"},{"type":"select","id":"pickup_message_color","label":"Pickup message color","options":[{"value":"heading","label":"Heading"},{"value":"text","label":"Text"}],"default":"text"},{"type":"range","id":"border_thickness","label":"Border thickness","min":0,"max":4,"step":1,"unit":"px","default":1},{"type":"select","id":"corner_radius","label":"Corner radius","options":[{"value":"0px","label":"Square"},{"value":"4px","label":"Small"},{"value":"8px","label":"Medium"},{"value":"16px","label":"Large"}],"default":"0px"},{"type":"select","id":"shadow","label":"Shadow","options":[{"value":"none","label":"None"},{"value":"small","label":"Small"},{"value":"medium","label":"Medium"}],"default":"none"},{"type":"select","id":"color_type","label":"Color type","options":[{"value":"inherit","label":"Inherit"},{"value":"color_scheme","label":"Color scheme"}],"default":"inherit"},{"type":"color_scheme","id":"color_scheme","label":"Color scheme","visible_if":"{{ block.settings.color_type == 'color_scheme' }}"},{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":100,"step":1,"unit":"px","default":0},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":100,"step":1,"unit":"px","default":0},{"type":"checkbox","id":"customize_mobile_padding","label":"Custom mobile padding","default":false},{"type":"range","id":"padding_top_mobile","label":"Mobile top padding","min":0,"max":100,"step":1,"unit":"px","default":0,"visible_if":"{{ block.settings.customize_mobile_padding }}"},{"type":"range","id":"padding_bottom_mobile","label":"Mobile bottom padding","min":0,"max":100,"step":1,"unit":"px","default":0,"visible_if":"{{ block.settings.customize_mobile_padding }}"}],"presets":[{"name":"t:blocks.commerce.pickup_availability_name"}]}{% endschema %}
