{"name":"t:blocks.spacer.name","settings":[{"type":"select","id":"unit_desktop","label":"t:blocks.spacer.unit_desktop","options":[{"value":"pixel","label":"Pixel"},{"value":"percent","label":"Percent"}],"default":"pixel"},{"type":"range","id":"size_desktop","label":"t:blocks.spacer.size_desktop","min":0,"max":400,"step":4,"unit":"px","default":100},{"type":"checkbox","id":"show_on_mobile","label":"t:blocks.spacer.show_on_mobile","default":true},{"type":"select","id":"unit_mobile","label":"t:blocks.spacer.unit_mobile","options":[{"value":"pixel","label":"Pixel"},{"value":"percent","label":"Percent"}],"default":"pixel","visible_if":"{{ block.settings.show_on_mobile }}"},{"type":"range","id":"size_mobile","label":"t:blocks.spacer.size_mobile","min":0,"max":400,"step":4,"unit":"px","default":52,"visible_if":"{{ block.settings.show_on_mobile }}"},{"type":"checkbox","id":"custom_spacing","label":"t:blocks.spacer.custom_spacing","default":false}],"presets":[{"name":"t:blocks.spacer.name"}]}
{% endschema %}
