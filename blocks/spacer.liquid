{% doc %}Flow spacer owning only its own block-size.{% enddoc %}
<div class="block-spacer" style="--spacer-size: {{ block.settings.size_desktop }}{% if block.settings.unit_desktop == 'percent' %}%{% else %}px{% endif %}; --spacer-size-mobile: {{ block.settings.size_mobile }}{% if block.settings.unit_mobile == 'percent' %}%{% else %}px{% endif %};" data-show-on-mobile="{{ block.settings.show_on_mobile }}" {{ block.shopify_attributes }}></div>
{% stylesheet %}.block-spacer { display: block; width: 100%; block-size: var(--spacer-size); min-height: 0; } @media (max-width: 767.98px) { .block-spacer { block-size: var(--spacer-size-mobile); } .block-spacer[data-show-on-mobile='false'] { display: none; } }{% endstylesheet %}
