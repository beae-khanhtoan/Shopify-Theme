{% doc %}Accessible menu or repeatable link list with a bounded two-level hierarchy.{% enddoc %}
{% assign link_list_items = block.settings.menu.links %}
<nav class="navigation-link-list navigation-link-list--{{ block.settings.list_style }} navigation-link-list--mobile-collapse-{{ block.settings.mobile_collapse }} navigation-link-list--mobile-stack-{{ block.settings.mobile_stack }}{% if block.settings.divider %} navigation-link-list--divider{% endif %}" style="--nav-gap: {{ block.settings.gap }}px; --nav-align: {{ block.settings.alignment }}; --nav-active-color: var(--color-{{ block.settings.active_color }}); --nav-columns: {{ block.settings.columns }}; --nav-padding-top: {{ block.settings.padding_top }}px; --nav-padding-bottom: {{ block.settings.padding_bottom }}px; --nav-padding-left: {{ block.settings.padding_left }}px; --nav-padding-right: {{ block.settings.padding_right }}px; --nav-padding-top-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_top_mobile }}{% else %}{{ block.settings.padding_top }}{% endif %}px; --nav-padding-bottom-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_bottom_mobile }}{% else %}{{ block.settings.padding_bottom }}{% endif %}px; --nav-padding-left-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_left_mobile }}{% else %}{{ block.settings.padding_left }}{% endif %}px; --nav-padding-right-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_right_mobile }}{% else %}{{ block.settings.padding_right }}{% endif %}px;" {{ block.shopify_attributes }}>
  {% if block.settings.show_eyebrow %}<span class="navigation-link-list__eyebrow">Navigation</span>{% endif %}
  {% if block.settings.show_title %}<h2 class="navigation-link-list__title">Menu</h2>{% endif %}
  {% if block.settings.source == 'repeatable' %}
    <ul class="navigation-link-list__items" role="list">{% content_for 'blocks' %}</ul>
  {% elsif link_list_items != blank %}
    <ul class="navigation-link-list__items" role="list">
      {% for item in link_list_items %}
        <li class="navigation-link-list__item">
          <a href="{{ item.url }}" class="navigation-link-list__link{% if item.current %} is-current{% endif %}"{% if block.settings.open_in_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}{% if item.current %} aria-current="page"{% endif %}>
            {{ item.title | escape }}{% if block.settings.external_indicator and item.type == 'http_link' %}<span class="navigation-link-list__external" aria-hidden="true">↗</span>{% endif %}
          </a>
          {% if block.settings.nested_levels == 'two' and item.links != blank %}
            <ul class="navigation-link-list__nested" role="list">{% for child in item.links %}<li><a href="{{ child.url }}" class="{% if child.current %}is-current{% endif %}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title | escape }}</a></li>{% endfor %}</ul>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <p class="navigation-link-list__empty">Select a menu to display links.</p>
  {% endif %}
</nav>
{% stylesheet %}
.navigation-link-list { width: 100%; padding: var(--nav-padding-top) var(--nav-padding-right) var(--nav-padding-bottom) var(--nav-padding-left); text-align: var(--nav-align); }
.navigation-link-list__items { display: grid; grid-template-columns: repeat(var(--nav-columns), minmax(0, 1fr)); gap: var(--nav-gap); margin: 0; padding: 0; list-style: none; }
.navigation-link-list--inline .navigation-link-list__items { display: flex; flex-wrap: wrap; justify-content: var(--nav-align); }
.navigation-link-list__nested { margin: .5rem 0 0; padding-inline-start: 1rem; list-style: none; }
.navigation-link-list a { color: inherit; text-decoration: none; }.navigation-link-list a:hover,.navigation-link-list a.is-current { color: var(--nav-active-color); text-decoration: underline; }.navigation-link-list--divider .navigation-link-list__item { border-bottom: 1px solid color-mix(in srgb, currentColor 20%, transparent); padding-block: .5rem; }.navigation-link-list__external { margin-inline-start: .25em; }.navigation-link-list__empty { margin: 0; color: var(--color-muted); }
@media (max-width: 767.98px) { .navigation-link-list { padding: var(--nav-padding-top-mobile) var(--nav-padding-right-mobile) var(--nav-padding-bottom-mobile) var(--nav-padding-left-mobile); }.navigation-link-list__items { grid-template-columns: 1fr; } }
{% endstylesheet %}
{% schema %}{"name":"t:blocks.navigation.link_list_name","blocks":[{"type":"link-item"}],"settings":[{"type":"select","id":"source","label":"Link source","options":[{"value":"menu","label":"Primary menu"},{"value":"repeatable","label":"Repeatable links"}],"default":"menu"},{"type":"link_list","id":"menu","label":"Menu","visible_if":"{{ block.settings.source == 'menu' }}"},{"type":"checkbox","id":"show_title","label":"Show title","default":false},{"type":"checkbox","id":"show_eyebrow","label":"Show eyebrow","default":false},{"type":"select","id":"nested_levels","label":"Nested levels","options":[{"value":"one","label":"1 level"},{"value":"two","label":"2 levels"}],"default":"two"},{"type":"checkbox","id":"open_in_new_tab","label":"Open in new tab","default":false},{"type":"checkbox","id":"external_indicator","label":"External link indicator","default":true},{"type":"checkbox","id":"mobile_collapse","label":"Mobile collapse","default":false},{"type":"select","id":"list_style","label":"List style","options":[{"value":"vertical","label":"Vertical"},{"value":"inline","label":"Inline"}],"default":"vertical"},{"type":"checkbox","id":"divider","label":"Divider","default":false},{"type":"select","id":"active_color","label":"Active color","options":[{"value":"accent","label":"Accent"},{"value":"foreground","label":"Foreground"}],"default":"accent"},{"type":"select","id":"alignment","label":"Alignment","options":[{"value":"start","label":"Start"},{"value":"center","label":"Center"},{"value":"end","label":"End"}],"default":"start"},{"type":"select","id":"columns","label":"Columns","options":[{"value":"1","label":"1 column"},{"value":"2","label":"2 columns"},{"value":"3","label":"3 columns"}],"default":"3"},{"type":"range","id":"gap","label":"Gap","min":0,"max":100,"step":1,"unit":"px","default":24},{"type":"checkbox","id":"mobile_stack","label":"Mobile stack","default":true},{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":100,"step":1,"unit":"px","default":0},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":100,"step":1,"unit":"px","default":0},{"type":"range","id":"padding_left","label":"Left padding","min":0,"max":100,"step":1,"unit":"px","default":0},{"type":"range","id":"padding_right","label":"Right padding","min":0,"max":100,"step":1,"unit":"px","default":0},{"type":"checkbox","id":"customize_mobile_padding","label":"Customize mobile padding","default":false},{"type":"range","id":"padding_top_mobile","label":"Mobile top padding","min":0,"max":100,"step":1,"unit":"px","default":0,"visible_if":"{{ block.settings.customize_mobile_padding }}"},{"type":"range","id":"padding_bottom_mobile","label":"Mobile bottom padding","min":0,"max":100,"step":1,"unit":"px","default":0,"visible_if":"{{ block.settings.customize_mobile_padding }}"},{"type":"range","id":"padding_left_mobile","label":"Mobile left padding","min":0,"max":100,"step":1,"unit":"px","default":0,"visible_if":"{{ block.settings.customize_mobile_padding }}"},{"type":"range","id":"padding_right_mobile","label":"Mobile right padding","min":0,"max":100,"step":1,"unit":"px","default":0,"visible_if":"{{ block.settings.customize_mobile_padding }}"}],"presets":[{"name":"t:blocks.navigation.link_list_name"}]}{% endschema %}
