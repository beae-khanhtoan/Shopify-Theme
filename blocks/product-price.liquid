{% doc %}Localized product price renderer. It never calculates commerce values.{% enddoc %}
{% if product != blank %}
  {% assign current_price = product.selected_or_first_available_variant.price | default: product.price %}
  {% assign compare_price = product.selected_or_first_available_variant.compare_at_price | default: product.compare_at_price_max %}
  <div class="commerce-product-price commerce-product-price--font-{{ block.settings.font }} commerce-product-price--spacing-{{ block.settings.letter_spacing }} commerce-product-price--{{ block.settings.font_size }}" style="--price-sale-color: {{ settings.badge_sale_price }}; --price-padding-top: {{ block.settings.padding_top }}px; --price-padding-bottom: {{ block.settings.padding_bottom }}px; --price-padding-left: {{ block.settings.padding_left }}px; --price-padding-right: {{ block.settings.padding_right }}px; --price-padding-top-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_top_mobile }}{% else %}{{ block.settings.padding_top }}{% endif %}px; --price-padding-bottom-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_bottom_mobile }}{% else %}{{ block.settings.padding_bottom }}{% endif %}px; --price-padding-left-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_left_mobile }}{% else %}{{ block.settings.padding_left }}{% endif %}px; --price-padding-right-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_right_mobile }}{% else %}{{ block.settings.padding_right }}{% endif %}px;" {{ block.shopify_attributes }}>
    <span class="commerce-product-price__current">{{ current_price | money }}</span>
    {% if compare_price > current_price %}<s class="commerce-product-price__compare">{{ compare_price | money }}</s>{% if block.settings.show_sale_badge %}<span class="commerce-product-price__sale">Sale</span>{% endif %}{% endif %}
    {% if block.settings.show_tax_and_shipping_notice %}<small class="commerce-product-price__notice">Tax and shipping calculated at checkout.</small>{% endif %}
  </div>
{% endif %}
{% stylesheet %}.commerce-product-price { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-small); padding: var(--price-padding-top) var(--price-padding-right) var(--price-padding-bottom) var(--price-padding-left); }.commerce-product-price--font-body { font-family: var(--font-body-family); }.commerce-product-price--font-accent { font-family: var(--font-accent-family); }.commerce-product-price--md { font-size: var(--font-body-md); }.commerce-product-price--xl { font-size: var(--font-body-xl); }.commerce-product-price--spacing-wide { letter-spacing: .06em; }.commerce-product-price__current { color: var(--color-foreground); }.commerce-product-price__compare { color: var(--color-muted); }.commerce-product-price__sale { color: var(--price-sale-color, var(--color-sale, var(--color-accent))); }.commerce-product-price__notice { flex-basis: 100%; color: var(--color-muted); } @media (max-width: 767.98px) { .commerce-product-price { padding: var(--price-padding-top-mobile) var(--price-padding-right-mobile) var(--price-padding-bottom-mobile) var(--price-padding-left-mobile); } }{% endstylesheet %}
{% schema %}{"name":"t:blocks.commerce.product_price_name","settings":[{"type":"header","content":"Content"},{"type":"checkbox","id":"show_sale_badge","label":"Show sale badge","default":true},{"type":"checkbox","id":"show_tax_and_shipping_notice","label":"Show tax and shipping notice","default":false},{"type":"header","content":"Typography"},{"type":"select","id":"font","label":"Font","options":[{"value":"body","label":"Body"},{"value":"accent","label":"Accent"}],"default":"body"},{"type":"select","id":"font_size","label":"Font size","options":[{"value":"md","label":"Medium"},{"value":"xl","label":"Extra large"}],"default":"xl"},{"type":"select","id":"letter_spacing","label":"Letter spacing","options":[{"value":"normal","label":"Normal"},{"value":"wide","label":"Wide"}],"default":"normal"},{"type":"header","content":"Padding"},{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":100,"step":1,"unit":"px","default":0},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":100,"step":1,"unit":"px","default":0},{"type":"range","id":"padding_left","label":"Left padding","min":0,"max":100,"step":1,"unit":"px","default":0},{"type":"range","id":"padding_right","label":"Right padding","min":0,"max":100,"step":1,"unit":"px","default":0},{"type":"checkbox","id":"customize_mobile_padding","label":"Custom mobile padding","default":false},{"type":"range","id":"padding_top_mobile","label":"Mobile top padding","min":0,"max":100,"step":1,"unit":"px","default":0,"visible_if":"{{ block.settings.customize_mobile_padding }}"},{"type":"range","id":"padding_bottom_mobile","label":"Mobile bottom padding","min":0,"max":100,"step":1,"unit":"px","default":0,"visible_if":"{{ block.settings.customize_mobile_padding }}"},{"type":"range","id":"padding_left_mobile","label":"Mobile left padding","min":0,"max":100,"step":1,"unit":"px","default":0,"visible_if":"{{ block.settings.customize_mobile_padding }}"},{"type":"range","id":"padding_right_mobile","label":"Mobile right padding","min":0,"max":100,"step":1,"unit":"px","default":0,"visible_if":"{{ block.settings.customize_mobile_padding }}"}],"presets":[{"category":"Block Commerce","name":"t:blocks.commerce.product_price_name"}]}{% endschema %}
