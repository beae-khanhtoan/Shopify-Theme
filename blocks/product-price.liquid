{% doc %}Localized product price renderer. It never calculates commerce values.{% enddoc %}
{% if product != blank %}
  {% assign current_price = product.selected_or_first_available_variant.price | default: product.price %}
  {% assign compare_price = product.selected_or_first_available_variant.compare_at_price | default: product.compare_at_price_max %}
  <div class="commerce-product-price commerce-product-price--font-{{ block.settings.font }} commerce-product-price--spacing-{{ block.settings.letter_spacing }} commerce-product-price--{{ block.settings.font_size }}" style="--price-padding-top: {{ block.settings.padding_top }}px; --price-padding-bottom: {{ block.settings.padding_bottom }}px; --price-padding-top-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_top_mobile }}{% else %}{{ block.settings.padding_top }}{% endif %}px; --price-padding-bottom-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_bottom_mobile }}{% else %}{{ block.settings.padding_bottom }}{% endif %}px;" {{ block.shopify_attributes }}>
    <span class="commerce-product-price__current">{{ current_price | money }}</span>
    {% if compare_price > current_price %}<s class="commerce-product-price__compare">{{ compare_price | money }}</s>{% if block.settings.show_sale_badge %}<span class="commerce-product-price__sale">Sale</span>{% endif %}{% endif %}
    {% if block.settings.show_tax_and_shipping_notice %}<small class="commerce-product-price__notice">Tax and shipping calculated at checkout.</small>{% endif %}
  </div>
{% endif %}
{% stylesheet %}.commerce-product-price { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-small); padding-block: var(--price-padding-top) var(--price-padding-bottom); }.commerce-product-price__current { color: var(--color-foreground); }.commerce-product-price__compare { color: var(--color-muted); }.commerce-product-price__sale { color: var(--color-sale, var(--color-accent)); }.commerce-product-price__notice { flex-basis: 100%; color: var(--color-muted); } @media (max-width: 767.98px) { .commerce-product-price { padding-block: var(--price-padding-top-mobile) var(--price-padding-bottom-mobile); } }{% endstylesheet %}
{% schema %}{"name":"t:blocks.commerce.product_price_name","settings":[{"type":"header","content":"Content"},{"type":"checkbox","id":"show_sale_badge","label":"Show sale badge","default":true},{"type":"checkbox","id":"show_tax_and_shipping_notice","label":"Show tax and shipping notice","default":false},{"type":"header","content":"Typography"},{"type":"select","id":"font","label":"Font","options":[{"value":"body","label":"Body"},{"value":"accent","label":"Accent"}],"default":"body"},{"type":"select","id":"font_size","label":"Font size","options":[{"value":"md","label":"Medium"},{"value":"xl","label":"Extra large"}],"default":"xl"},{"type":"select","id":"letter_spacing","label":"Letter spacing","options":[{"value":"normal","label":"Normal"},{"value":"wide","label":"Wide"}],"default":"normal"},{"type":"header","content":"Padding"},{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":100,"step":1,"unit":"px","default":0},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":100,"step":1,"unit":"px","default":0},{"type":"checkbox","id":"customize_mobile_padding","label":"Custom mobile padding","default":false},{"type":"range","id":"padding_top_mobile","label":"Mobile top padding","min":0,"max":100,"step":1,"unit":"px","default":0,"visible_if":"{{ block.settings.customize_mobile_padding }}"},{"type":"range","id":"padding_bottom_mobile","label":"Mobile bottom padding","min":0,"max":100,"step":1,"unit":"px","default":0,"visible_if":"{{ block.settings.customize_mobile_padding }}"}],"presets":[{"name":"t:blocks.commerce.product_price_name"}]}{% endschema %}
