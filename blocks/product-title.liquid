{% doc %}Product title with independent visual profile and semantic tag.{% enddoc %}
{% if product != blank and product.title != blank %}
  {% assign title_class = 'heading-md' %}{% case block.settings.size %}{% when 'h1' %}{% assign title_class = 'heading-xl' %}{% when 'h2' %}{% assign title_class = 'heading-lg' %}{% when 'h3' %}{% assign title_class = 'heading-md' %}{% when 'h4' %}{% assign title_class = 'heading-sm' %}{% when 'h5' %}{% assign title_class = 'heading-xs' %}{% when 'h6' %}{% assign title_class = 'heading-xs' %}{% endcase %}
  {% assign title_text = product.title %}{% if block.settings.text_case == 'uppercase' %}{% assign title_text = title_text | upcase %}{% elsif block.settings.text_case == 'capitalize' %}{% assign title_text = title_text | capitalize %}{% endif %}
  {% assign title_style = '--title-padding-top: ' | append: block.settings.padding_top | append: 'px; --title-padding-bottom: ' | append: block.settings.padding_bottom | append: 'px;' %}{% if block.settings.customize_mobile_padding %}{% assign title_style = title_style | append: ' --title-padding-top-mobile: ' | append: block.settings.padding_top_mobile | append: 'px; --title-padding-bottom-mobile: ' | append: block.settings.padding_bottom_mobile | append: 'px;' %}{% endif %}
  {% case block.settings.html_tag %}{% when 'p' %}<p class="commerce-product-title {{ title_class }}" style="{{ title_style }}">{{ title_text | escape }}</p>{% when 'h1' %}<h1 class="commerce-product-title {{ title_class }}" style="{{ title_style }}">{{ title_text | escape }}</h1>{% when 'h2' %}<h2 class="commerce-product-title {{ title_class }}" style="{{ title_style }}">{{ title_text | escape }}</h2>{% when 'h3' %}<h3 class="commerce-product-title {{ title_class }}" style="{{ title_style }}">{{ title_text | escape }}</h3>{% when 'h4' %}<h4 class="commerce-product-title {{ title_class }}" style="{{ title_style }}">{{ title_text | escape }}</h4>{% when 'h5' %}<h5 class="commerce-product-title {{ title_class }}" style="{{ title_style }}">{{ title_text | escape }}</h5>{% else %}<h6 class="commerce-product-title {{ title_class }}" style="{{ title_style }}">{{ title_text | escape }}</h6>{% endcase %}
{% endif %}
{% stylesheet %}.commerce-product-title { margin-block: 0; padding-block: var(--title-padding-top) var(--title-padding-bottom); } @media (max-width: 767.98px) { .commerce-product-title { padding-block: var(--title-padding-top-mobile, var(--title-padding-top)) var(--title-padding-bottom-mobile, var(--title-padding-bottom)); } }{% endstylesheet %}
{% schema %}{"name":"t:blocks.commerce.product_title_name","settings":[{"type":"select","id":"size","label":"Heading size","options":[{"value":"h1","label":"Heading 1"},{"value":"h2","label":"Heading 2"},{"value":"h3","label":"Heading 3"},{"value":"h4","label":"Heading 4"},{"value":"h5","label":"Heading 5"},{"value":"h6","label":"Heading 6"}],"default":"h3"},{"type":"select","id":"html_tag","label":"HTML tag","info":"Use headings in order (H1 → H2 → H3) for better SEO and readability. If unsure, choose Paragraph.","options":[{"value":"p","label":"Paragraph"},{"value":"h1","label":"H1"},{"value":"h2","label":"H2"},{"value":"h3","label":"H3"},{"value":"h4","label":"H4"},{"value":"h5","label":"H5"},{"value":"h6","label":"H6"}],"default":"h1"},{"type":"select","id":"text_case","label":"Text case","options":[{"value":"original","label":"Original"},{"value":"uppercase","label":"Uppercase"},{"value":"capitalize","label":"Capitalize"}],"default":"capitalize"},{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":100,"step":1,"unit":"px","default":0},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":100,"step":1,"unit":"px","default":0},{"type":"checkbox","id":"customize_mobile_padding","label":"Custom mobile padding","default":false},{"type":"range","id":"padding_top_mobile","label":"Mobile top padding","min":0,"max":100,"step":1,"unit":"px","default":0,"visible_if":"{{ block.settings.customize_mobile_padding }}"},{"type":"range","id":"padding_bottom_mobile","label":"Mobile bottom padding","min":0,"max":100,"step":1,"unit":"px","default":0,"visible_if":"{{ block.settings.customize_mobile_padding }}"}],"presets":[{"name":"t:blocks.commerce.product_title_name"}]}{% endschema %}
