{% doc %}Product title with independent visual profile and semantic tag.{% enddoc %}
{% if product != blank and product.title != blank %}
  {% assign title_class = 'heading-md' %}{% case block.settings.heading_size %}{% when 'display' %}{% assign title_class = 'heading-display' %}{% when 'xl' %}{% assign title_class = 'heading-xl' %}{% when 'lg' %}{% assign title_class = 'heading-lg' %}{% when 'md' %}{% assign title_class = 'heading-md' %}{% when 'sm' %}{% assign title_class = 'heading-sm' %}{% when 'xs' %}{% assign title_class = 'heading-xs' %}{% when 'custom' %}{% assign title_class = 'commerce-product-title--custom' %}{% endcase %}
  {% assign title_text = product.title %}{% if block.settings.text_case == 'uppercase' %}{% assign title_text = title_text | upcase %}{% elsif block.settings.text_case == 'capitalize' %}{% assign title_text = title_text | capitalize %}{% endif %}
  {% assign title_style = '--title-padding-top: ' | append: block.settings.padding_top | append: 'px; --title-padding-bottom: ' | append: block.settings.padding_bottom | append: 'px; --title-padding-left: ' | append: block.settings.padding_left | append: 'px; --title-padding-right: ' | append: block.settings.padding_right | append: 'px; --title-color: ' | append: block.settings.text_color | append: ';' %}{% if block.settings.heading_size == 'custom' %}{% assign title_style = title_style | append: ' --title-size: ' | append: block.settings.custom_size | append: 'px;' %}{% endif %}{% if block.settings.customize_mobile_padding %}{% assign title_style = title_style | append: ' --title-padding-top-mobile: ' | append: block.settings.padding_top_mobile | append: 'px; --title-padding-bottom-mobile: ' | append: block.settings.padding_bottom_mobile | append: 'px; --title-padding-left-mobile: ' | append: block.settings.padding_left_mobile | append: 'px; --title-padding-right-mobile: ' | append: block.settings.padding_right_mobile | append: 'px;' %}{% endif %}
  {% case block.settings.html_tag %}{% when 'p' %}<p class="commerce-product-title {{ title_class }}" style="{{ title_style }}" {{ block.shopify_attributes }}>{{ title_text | escape }}</p>{% when 'h1' %}<h1 class="commerce-product-title {{ title_class }}" style="{{ title_style }}" {{ block.shopify_attributes }}>{{ title_text | escape }}</h1>{% when 'h2' %}<h2 class="commerce-product-title {{ title_class }}" style="{{ title_style }}" {{ block.shopify_attributes }}>{{ title_text | escape }}</h2>{% when 'h3' %}<h3 class="commerce-product-title {{ title_class }}" style="{{ title_style }}" {{ block.shopify_attributes }}>{{ title_text | escape }}</h3>{% when 'h4' %}<h4 class="commerce-product-title {{ title_class }}" style="{{ title_style }}" {{ block.shopify_attributes }}>{{ title_text | escape }}</h4>{% when 'h5' %}<h5 class="commerce-product-title {{ title_class }}" style="{{ title_style }}" {{ block.shopify_attributes }}>{{ title_text | escape }}</h5>{% else %}<h6 class="commerce-product-title {{ title_class }}" style="{{ title_style }}" {{ block.shopify_attributes }}>{{ title_text | escape }}</h6>{% endcase %}
{% endif %}
{% stylesheet %}.commerce-product-title { margin-block: 0; color: var(--title-color, inherit); padding: var(--title-padding-top) var(--title-padding-right) var(--title-padding-bottom) var(--title-padding-left); }.commerce-product-title--custom { font-size: var(--title-size); line-height: 1.15; } @media (max-width: 767.98px) { .commerce-product-title { padding: var(--title-padding-top-mobile, var(--title-padding-top)) var(--title-padding-right-mobile, var(--title-padding-right)) var(--title-padding-bottom-mobile, var(--title-padding-bottom)) var(--title-padding-left-mobile, var(--title-padding-left)); } }{% endstylesheet %}
{% schema %}{"name":"t:blocks.commerce.product_title_name",
  "settings":[{"type":"header","content":"Typography"},{"type":"select","id":"heading_size","label":"Heading size","options":[{"value":"display","label":"Display"},{"value":"xl","label":"Extra large"},{"value":"lg","label":"Large"},{"value":"md","label":"Medium"},{"value":"sm","label":"Small"},{"value":"xs","label":"Extra small"},{"value":"custom","label":"Custom"}],"default":"md"},{"type":"range","id":"custom_size","label":"Custom size","min":10,"max":120,"step":2,"unit":"px","default":32,"visible_if":"{{ block.settings.heading_size == 'custom' }}"},{"type":"select","id":"html_tag","label":"HTML tag","info":"Use headings in order (H1 → H2 → H3) for better SEO and readability. If unsure, choose Paragraph.","options":[{"value":"p","label":"Paragraph"},{"value":"h1","label":"H1"},{"value":"h2","label":"H2"},{"value":"h3","label":"H3"},{"value":"h4","label":"H4"},{"value":"h5","label":"H5"},{"value":"h6","label":"H6"}],"default":"h1"},{"type":"color","id":"text_color","label":"Text color"},{"type":"select","id":"text_case","label":"Text case","options":[{"value":"original","label":"Original"},{"value":"uppercase","label":"Uppercase"},{"value":"capitalize","label":"Capitalize"}],"default":"capitalize"},{"type":"header","content":"Padding"},{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":100,"step":1,"unit":"px","default":0},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":100,"step":1,"unit":"px","default":0},{"type":"range","id":"padding_left","label":"Left padding","min":0,"max":100,"step":1,"unit":"px","default":0},{"type":"range","id":"padding_right","label":"Right padding","min":0,"max":100,"step":1,"unit":"px","default":0},{"type":"checkbox","id":"customize_mobile_padding","label":"Custom mobile padding","default":false},{"type":"range","id":"padding_top_mobile","label":"Mobile top padding","min":0,"max":100,"step":1,"unit":"px","default":0,"visible_if":"{{ block.settings.customize_mobile_padding }}"},{"type":"range","id":"padding_bottom_mobile","label":"Mobile bottom padding","min":0,"max":100,"step":1,"unit":"px","default":0,"visible_if":"{{ block.settings.customize_mobile_padding }}"},{"type":"range","id":"padding_left_mobile","label":"Mobile left padding","min":0,"max":100,"step":1,"unit":"px","default":0,"visible_if":"{{ block.settings.customize_mobile_padding }}"},{"type":"range","id":"padding_right_mobile","label":"Mobile right padding","min":0,"max":100,"step":1,"unit":"px","default":0,"visible_if":"{{ block.settings.customize_mobile_padding }}"}],"presets":[{"category":"Block Commerce","name":"t:blocks.commerce.product_title_name"}]}{% endschema %}
