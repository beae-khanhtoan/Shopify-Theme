{% doc %}Theme-configured social links with accessible names and no empty URL output.{% enddoc %}
{% assign social_items = 'facebook:Facebook:facebook,instagram:Instagram:instagram,youtube:YouTube:youtube,tiktok:TikTok:tiktok,x:X:x,threads:Threads:threads,linkedin:LinkedIn:linkedin,bluesky:Bluesky:bluesky,snapchat:Snapchat:snapchat,pinterest:Pinterest:pinterest,tumblr:Tumblr:tumblr,vimeo:Vimeo:vimeo' | split: ',' %}
<nav class="navigation-social-links navigation-social-links--{{ block.settings.link_source }} navigation-social-links--{{ block.settings.color_mode }} navigation-social-links--{{ block.settings.display }} navigation-social-links--{{ block.settings.flow }}" aria-label="Social media" style="--social-gap: {{ block.settings.gap }}px; --social-align: {{ block.settings.alignment }}; --social-mobile-align: {{ block.settings.mobile_alignment }}; --social-mobile-wrap: {% if block.settings.mobile_wrap %}wrap{% else %}nowrap{% endif %}; --social-icon-size: {{ block.settings.icon_size }}px; --social-padding-top: {{ block.settings.padding_top }}px; --social-padding-bottom: {{ block.settings.padding_bottom }}px; --social-padding-top-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_top_mobile }}{% else %}{{ block.settings.padding_top }}{% endif %}px; --social-padding-bottom-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_bottom_mobile }}{% else %}{{ block.settings.padding_bottom }}{% endif %}px;" {{ block.shopify_attributes }}>
  {% for item in social_items %}
    {% assign parts = item | split: ':' %}
    {% case parts[0] %}
      {% when 'facebook' %}{% assign social_url = settings.social_facebook %}
      {% when 'instagram' %}{% assign social_url = settings.social_instagram %}
      {% when 'youtube' %}{% assign social_url = settings.social_youtube %}
      {% when 'tiktok' %}{% assign social_url = settings.social_tiktok %}
      {% when 'x' %}{% assign social_url = settings.social_x %}
      {% when 'threads' %}{% assign social_url = settings.social_threads %}
      {% when 'linkedin' %}{% assign social_url = settings.social_linkedin %}
      {% when 'bluesky' %}{% assign social_url = settings.social_bluesky %}
      {% when 'snapchat' %}{% assign social_url = settings.social_snapchat %}
      {% when 'pinterest' %}{% assign social_url = settings.social_pinterest %}
      {% when 'tumblr' %}{% assign social_url = settings.social_tumblr %}
      {% when 'vimeo' %}{% assign social_url = settings.social_vimeo %}
    {% endcase %}
    {% if block.settings.link_source == 'custom' %}{% if parts[0] == 'facebook' %}{% assign social_url = block.settings.custom_facebook_url %}{% elsif parts[0] == 'instagram' %}{% assign social_url = block.settings.custom_instagram_url %}{% endif %}{% endif %}
    {% assign preview_social = false %}{% if social_url == blank and request.design_mode and forloop.index <= 2 %}{% assign social_url = '#' %}{% assign preview_social = true %}{% endif %}
    {% if social_url != blank %}<a class="navigation-social-links__item" href="{{ social_url }}"{% if preview_social %} data-editor-preview="true"{% endif %}{% if block.settings.external_target and preview_social == false %} target="_blank" rel="noopener noreferrer"{% endif %}{% if block.settings.accessible_labels %} aria-label="{{ parts[1] }}"{% endif %}><span class="navigation-social-links__icon" aria-hidden="true">{{ parts[2] | slice: 0, 1 | upcase }}</span>{% if block.settings.display == 'icon_label' %}<span>{{ parts[1] }}</span>{% endif %}</a>{% endif %}
  {% endfor %}
</nav>
{% stylesheet %}.navigation-social-links { display: flex; align-items: center; justify-content: var(--social-align); gap: var(--social-gap); width: 100%; padding-block: var(--social-padding-top) var(--social-padding-bottom); color: currentColor; }.navigation-social-links--grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(7rem, max-content)); }.navigation-social-links--wrap { flex-wrap: wrap; }.navigation-social-links--brand { color: var(--color-accent); }.navigation-social-links--muted { color: var(--color-muted); }.navigation-social-links__item { display: inline-flex; align-items: center; gap: .4rem; color: inherit; text-decoration: none; }.navigation-social-links__icon { display: inline-flex; align-items: center; justify-content: center; width: var(--social-icon-size); height: var(--social-icon-size); border: 1px solid currentColor; border-radius: 50%; font-size: .7em; }.navigation-social-links__item:hover { opacity: .7; } @media (max-width: 767.98px) { .navigation-social-links { justify-content: var(--social-mobile-align); flex-wrap: var(--social-mobile-wrap); padding-block: var(--social-padding-top-mobile) var(--social-padding-bottom-mobile); } }{% endstylesheet %}
{% schema %}{"name":"t:blocks.navigation.social_links_name","settings":[{"type":"header","content":"Source"},{"type":"select","id":"link_source","label":"Link source","options":[{"value":"theme_settings","label":"Theme Settings"},{"value":"custom","label":"Custom links"}],"default":"theme_settings"},{"type":"url","id":"custom_facebook_url","label":"Custom Facebook URL","visible_if":"{{ block.settings.link_source == 'custom' }}"},{"type":"url","id":"custom_instagram_url","label":"Custom Instagram URL","visible_if":"{{ block.settings.link_source == 'custom' }}"},{"type":"header","content":"Appearance"},{"type":"range","id":"icon_size","label":"Icon size","min":16,"max":32,"step":1,"unit":"px","default":20},{"type":"checkbox","id":"accessible_labels","label":"Accessible labels","default":true},{"type":"checkbox","id":"external_target","label":"External target","default":true},{"type":"select","id":"display","label":"Display","options":[{"value":"icon_only","label":"Icon only"},{"value":"icon_label","label":"Icon + label"}],"default":"icon_only"},{"type":"select","id":"color_mode","label":"Color mode","options":[{"value":"current","label":"Current color"},{"value":"brand","label":"Brand colors"},{"value":"muted","label":"Muted"}],"default":"current"},{"type":"header","content":"Layout"},{"type":"select","id":"alignment","label":"Alignment","options":[{"value":"start","label":"Start"},{"value":"center","label":"Center"},{"value":"end","label":"End"}],"default":"start"},{"type":"select","id":"flow","label":"Flow","options":[{"value":"inline","label":"Inline"},{"value":"grid","label":"Grid"},{"value":"wrap","label":"Wrap"}],"default":"inline"},{"type":"range","id":"gap","label":"Gap","min":0,"max":64,"step":1,"unit":"px","default":12},{"type":"select","id":"mobile_alignment","label":"Mobile alignment","options":[{"value":"start","label":"Start"},{"value":"center","label":"Center"},{"value":"end","label":"End"}],"default":"start"},{"type":"checkbox","id":"mobile_wrap","label":"Mobile wrap","default":true},{"type":"header","content":"Padding"},{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":100,"step":1,"unit":"px","default":0},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":100,"step":1,"unit":"px","default":0},{"type":"checkbox","id":"customize_mobile_padding","label":"Customize mobile padding","default":false},{"type":"range","id":"padding_top_mobile","label":"Mobile top padding","min":0,"max":100,"step":1,"unit":"px","default":0,"visible_if":"{{ block.settings.customize_mobile_padding }}"},{"type":"range","id":"padding_bottom_mobile","label":"Mobile bottom padding","min":0,"max":100,"step":1,"unit":"px","default":0,"visible_if":"{{ block.settings.customize_mobile_padding }}"}],"presets":[{"name":"t:blocks.navigation.social_links_name"}]}{% endschema %}
