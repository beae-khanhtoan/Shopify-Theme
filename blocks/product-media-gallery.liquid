{% doc %}Product media gallery from current product context; no external product lookup.{% enddoc %}
{% if product != blank and product.media != blank %}<div class="commerce-media-gallery commerce-media-gallery--{{ block.settings.desktop_layout }} commerce-media-gallery--ratio-{{ block.settings.desktop_media_ratio }} commerce-media-gallery--fit-{{ block.settings.image_fit }}" style="--media-gap: {{ block.settings.media_gap }}px; --gallery-columns: {{ block.settings.grid_columns }};" {{ block.shopify_attributes }}>{% for media in product.media %}{% if media.media_type == 'image' %}<div class="commerce-media-gallery__item"{% if block.settings.image_zoom == 'lightbox' %} tabindex="0" data-lightbox="true"{% endif %}>{{ media | image_url: width: 1200 | image_tag: loading: 'lazy', alt: media.alt | default: product.title }}</div>{% elsif media.media_type == 'video' and block.settings.show_featured_video %}<div class="commerce-media-gallery__item">{{ media | video_tag: controls: true, image_size: '1200x' }}</div>{% endif %}{% endfor %}</div>{% endif %}
{% stylesheet %}.commerce-media-gallery { display: grid; gap: var(--media-gap); min-width: 0; }.commerce-media-gallery--grid { grid-template-columns: repeat(var(--gallery-columns, 2), minmax(0, 1fr)); }.commerce-media-gallery--carousel { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; }.commerce-media-gallery__item { min-width: 0; overflow: hidden; aspect-ratio: 4 / 5; scroll-snap-align: start; }.commerce-media-gallery--ratio-adapt .commerce-media-gallery__item { aspect-ratio: auto; }.commerce-media-gallery--ratio-square .commerce-media-gallery__item { aspect-ratio: 1; }.commerce-media-gallery--fit-contain img,.commerce-media-gallery--fit-contain video { object-fit: contain; }.commerce-media-gallery__item img,.commerce-media-gallery__item video { display: block; width: 100%; height: 100%; object-fit: cover; }{% endstylesheet %}
{% schema %}{"name":"t:blocks.commerce.product_media_gallery_name","settings":[{"type":"checkbox","id":"show_featured_video","label":"Show featured video","default":true},{"type":"select","id":"desktop_layout","label":"Desktop layout","options":[{"value":"grid","label":"Grid"},{"value":"carousel","label":"Carousel"}],"default":"grid"},{"type":"select","id":"image_zoom","label":"Image zoom","options":[{"value":"none","label":"None"},{"value":"lightbox","label":"Open lightbox"}],"default":"none"},{"type":"select","id":"grid_columns","label":"Grid columns","options":[{"value":"1","label":"1 column"},{"value":"2","label":"2 columns"}],"default":"2"},{"type":"checkbox","id":"show_pagination","label":"Show pagination","default":false},{"type":"range","id":"media_gap","label":"Media gap","min":0,"max":64,"step":4,"unit":"px","default":12},{"type":"select","id":"desktop_media_ratio","label":"Desktop media ratio","options":[{"value":"adapt","label":"Adapt"},{"value":"portrait","label":"4:5"},{"value":"square","label":"Square"}],"default":"portrait"},{"type":"select","id":"mobile_media_ratio","label":"Mobile media ratio","options":[{"value":"adapt","label":"Adapt"},{"value":"portrait","label":"4:5"},{"value":"square","label":"Square"}],"default":"portrait"},{"type":"select","id":"image_fit","label":"Image fit","options":[{"value":"cover","label":"Crop to fill"},{"value":"contain","label":"Full image"}],"default":"cover"},{"type":"checkbox","id":"mobile_thumbnails","label":"Mobile thumbnails","default":false},{"type":"range","id":"thumbnail_size","label":"Thumbnail size","min":32,"max":96,"step":4,"unit":"px","default":64,"visible_if":"{{ block.settings.mobile_thumbnails }}"},{"type":"range","id":"thumbnail_gap","label":"Thumbnail gap","min":0,"max":32,"step":4,"unit":"px","default":8,"visible_if":"{{ block.settings.mobile_thumbnails }}"}],"presets":[{"name":"t:blocks.commerce.product_media_gallery_name"}]}{% endschema %}
