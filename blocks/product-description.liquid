{% doc %}Product description from the current product context.{% enddoc %}
{% if product != blank and product.description != blank %}<details class="commerce-product-description commerce-product-description--{{ block.settings.height_limit }} body-{{ block.settings.text_size }}" style="--description-padding-top: {{ block.settings.padding_top }}px; --description-padding-bottom: {{ block.settings.padding_bottom }}px; --description-padding-left: {{ block.settings.padding_left }}px; --description-padding-right: {{ block.settings.padding_right }}px; --description-padding-top-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_top_mobile }}{% else %}{{ block.settings.padding_top }}{% endif %}px; --description-padding-bottom-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_bottom_mobile }}{% else %}{{ block.settings.padding_bottom }}{% endif %}px; --description-padding-left-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_left_mobile }}{% else %}{{ block.settings.padding_left }}{% endif %}px; --description-padding-right-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_right_mobile }}{% else %}{{ block.settings.padding_right }}{% endif %}px;" {{ block.shopify_attributes }}><summary>Product details</summary><div class="commerce-product-description__content">{{ product.description }}</div></details>{% endif %}
{% stylesheet %}.commerce-product-description { padding: var(--description-padding-top) var(--description-padding-right) var(--description-padding-bottom) var(--description-padding-left); }.commerce-product-description summary { cursor: pointer; font-weight: 600; }.commerce-product-description__content { overflow: hidden; }.commerce-product-description--small .commerce-product-description__content { max-height: 10rem; }.commerce-product-description--medium .commerce-product-description__content { max-height: 20rem; }.commerce-product-description--large .commerce-product-description__content { max-height: 32rem; }.commerce-product-description--none .commerce-product-description__content { max-height: none; }.commerce-product-description p:first-child { margin-top: 0; }.commerce-product-description p:last-child { margin-bottom: 0; } @media (max-width: 767.98px) { .commerce-product-description { padding: var(--description-padding-top-mobile) var(--description-padding-right-mobile) var(--description-padding-bottom-mobile) var(--description-padding-left-mobile); } }{% endstylesheet %}
{% schema %}{"name":"t:blocks.commerce.product_description_name","settings":[{"type":"header","content":"Content"},{"type":"select","id":"height_limit","label":"Height limit","options":[{"value":"small","label":"Small"},{"value":"medium","label":"Medium"},{"value":"large","label":"Large"},{"value":"none","label":"No limit"}],"default":"medium"},{"type":"select","id":"text_size","label":"Text size","options":[{"value":"sm","label":"Small"},{"value":"md","label":"Medium"},{"value":"lg","label":"Large"}],"default":"md"},{"type":"header","content":"Padding"},{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":100,"step":1,"unit":"px","default":0},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":100,"step":1,"unit":"px","default":0},{"type":"range","id":"padding_left","label":"Left padding","min":0,"max":100,"step":1,"unit":"px","default":0},{"type":"range","id":"padding_right","label":"Right padding","min":0,"max":100,"step":1,"unit":"px","default":0},{"type":"checkbox","id":"customize_mobile_padding","label":"Custom mobile padding","default":false},{"type":"range","id":"padding_top_mobile","label":"Mobile top padding","min":0,"max":100,"step":1,"unit":"px","default":0,"visible_if":"{{ block.settings.customize_mobile_padding }}"},{"type":"range","id":"padding_bottom_mobile","label":"Mobile bottom padding","min":0,"max":100,"step":1,"unit":"px","default":0,"visible_if":"{{ block.settings.customize_mobile_padding }}"},{"type":"range","id":"padding_left_mobile","label":"Mobile left padding","min":0,"max":100,"step":1,"unit":"px","default":0,"visible_if":"{{ block.settings.customize_mobile_padding }}"},{"type":"range","id":"padding_right_mobile","label":"Mobile right padding","min":0,"max":100,"step":1,"unit":"px","default":0,"visible_if":"{{ block.settings.customize_mobile_padding }}"}],"presets":[{"name":"t:blocks.commerce.product_description_name"}]}{% endschema %}
