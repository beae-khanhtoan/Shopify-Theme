{% doc %}Product description from the current product context.{% enddoc %}
{% if product != blank and product.description != blank %}<div class="commerce-product-description commerce-product-description--{{ block.settings.height_limit }} body-{{ block.settings.text_size }}" {{ block.shopify_attributes }}>{{ product.description }}</div>{% endif %}
{% stylesheet %}.commerce-product-description { overflow: hidden; }.commerce-product-description--small { max-height: 10rem; }.commerce-product-description--medium { max-height: 20rem; }.commerce-product-description--large { max-height: 32rem; }.commerce-product-description p:first-child { margin-top: 0; }.commerce-product-description p:last-child { margin-bottom: 0; }{% endstylesheet %}
{% schema %}{"name":"t:blocks.commerce.product_description_name","settings":[{"type":"select","id":"height_limit","label":"Height limit","options":[{"value":"small","label":"Small"},{"value":"medium","label":"Medium"},{"value":"large","label":"Large"},{"value":"none","label":"No limit"}],"default":"medium"},{"type":"select","id":"text_size","label":"Text size","options":[{"value":"sm","label":"Small"},{"value":"md","label":"Medium"},{"value":"lg","label":"Large"}],"default":"md"},{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":100,"step":1,"unit":"px","default":0},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":100,"step":1,"unit":"px","default":0}],"presets":[{"name":"t:blocks.commerce.product_description_name"}]}{% endschema %}
