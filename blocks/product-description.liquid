{% doc %}Product description from the current product context.{% enddoc %}
{% if product != blank and product.description != blank %}<div class="commerce-product-description commerce-product-description--{{ block.settings.height_limit }} body-{{ block.settings.text_size }}" style="--description-padding-top: {{ block.settings.padding_top }}px; --description-padding-bottom: {{ block.settings.padding_bottom }}px; --description-padding-top-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_top_mobile }}{% else %}{{ block.settings.padding_top }}{% endif %}px; --description-padding-bottom-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_bottom_mobile }}{% else %}{{ block.settings.padding_bottom }}{% endif %}px;" {{ block.shopify_attributes }}>{{ product.description }}</div>{% endif %}
{% stylesheet %}.commerce-product-description { overflow: hidden; padding-block: var(--description-padding-top) var(--description-padding-bottom); }.commerce-product-description--small { max-height: 10rem; }.commerce-product-description--medium { max-height: 20rem; }.commerce-product-description--large { max-height: 32rem; }.commerce-product-description--none { max-height: none; }.commerce-product-description p:first-child { margin-top: 0; }.commerce-product-description p:last-child { margin-bottom: 0; } @media (max-width: 767.98px) { .commerce-product-description { padding-block: var(--description-padding-top-mobile) var(--description-padding-bottom-mobile); } }{% endstylesheet %}
{% schema %}{"name":"t:blocks.commerce.product_description_name","settings":[{"type":"select","id":"height_limit","label":"Height limit","options":[{"value":"small","label":"Small"},{"value":"medium","label":"Medium"},{"value":"large","label":"Large"},{"value":"none","label":"No limit"}],"default":"medium"},{"type":"select","id":"text_size","label":"Text size","options":[{"value":"sm","label":"Small"},{"value":"md","label":"Medium"},{"value":"lg","label":"Large"}],"default":"md"},{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":100,"step":1,"unit":"px","default":0},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":100,"step":1,"unit":"px","default":0},{"type":"checkbox","id":"customize_mobile_padding","label":"Custom mobile padding","default":false},{"type":"range","id":"padding_top_mobile","label":"Mobile top padding","min":0,"max":100,"step":1,"unit":"px","default":0,"visible_if":"{{ block.settings.customize_mobile_padding }}"},{"type":"range","id":"padding_bottom_mobile","label":"Mobile bottom padding","min":0,"max":100,"step":1,"unit":"px","default":0,"visible_if":"{{ block.settings.customize_mobile_padding }}"}],"presets":[{"name":"t:blocks.commerce.product_description_name"}]}{% endschema %}
