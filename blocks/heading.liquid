{% doc %}
  Renders a semantic heading with an independent visual scale.
{% enddoc %}

{% assign heading_class = 'heading-md' %}
{% case block.settings.heading_size %}
  {% when 'xs' %}{% assign heading_class = 'heading-xs' %}
  {% when 'sm' %}{% assign heading_class = 'heading-sm' %}
  {% when 'lg' %}{% assign heading_class = 'heading-lg' %}
  {% when 'xl' %}{% assign heading_class = 'heading-xl' %}
  {% when 'display' %}{% assign heading_class = 'heading-display' %}
  {% when 'custom' %}{% assign heading_class = 'heading-custom' %}
{% endcase %}
{% assign heading_width = 'fit-content' %}
{% if block.settings.width == 'fill' %}{% assign heading_width = '100%' %}{% endif %}
{% assign heading_width_mobile = 'fit-content' %}
{% if block.settings.customize_mobile_width %}{% assign heading_width_mobile = heading_width %}{% if block.settings.width_mobile == 'fill' %}{% assign heading_width_mobile = '100%' %}{% endif %}{% else %}{% assign heading_width_mobile = heading_width %}{% endif %}
{% assign heading_alignment_mobile = block.settings.alignment %}
{% if block.settings.customize_mobile_width and block.settings.customize_mobile_alignment and block.settings.width_mobile == 'fill' %}{% assign heading_alignment_mobile = block.settings.alignment_mobile %}{% endif %}

{% capture heading_style %}--block-width: {{ heading_width }}; --block-width-mobile: {{ heading_width_mobile }}; --block-align: {{ block.settings.alignment }}; --block-align-mobile: {{ heading_alignment_mobile }}; --block-color: {{ block.settings.text_color | default: 'var(--heading-color)' }}; --padding-top: {{ block.settings.padding_top }}px; --padding-bottom: {{ block.settings.padding_bottom }}px; --padding-left: {{ block.settings.padding_left }}px; --padding-right: {{ block.settings.padding_right }}px; --padding-top-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_top_mobile }}{% else %}{{ block.settings.padding_top }}{% endif %}px; --padding-bottom-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_bottom_mobile }}{% else %}{{ block.settings.padding_bottom }}{% endif %}px; --padding-left-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_left_mobile }}{% else %}{{ block.settings.padding_left }}{% endif %}px; --padding-right-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_right_mobile }}{% else %}{{ block.settings.padding_right }}{% endif %}px;{% endcapture %}

{% if block.settings.text != blank %}
  {% case block.settings.html_tag %}
    {% when 'div' %}<div class="heading-text {{ heading_class }}" style="{{ heading_style }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
    {% when 'h1' %}<h1 class="heading-text {{ heading_class }}" style="{{ heading_style }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</h1>
    {% when 'h2' %}<h2 class="heading-text {{ heading_class }}" style="{{ heading_style }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</h2>
    {% when 'h3' %}<h3 class="heading-text {{ heading_class }}" style="{{ heading_style }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</h3>
    {% when 'h4' %}<h4 class="heading-text {{ heading_class }}" style="{{ heading_style }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</h4>
    {% when 'h5' %}<h5 class="heading-text {{ heading_class }}" style="{{ heading_style }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</h5>
    {% else %}<h6 class="heading-text {{ heading_class }}" style="{{ heading_style }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</h6>
  {% endcase %}
{% endif %}

{% stylesheet %}
  .heading-text { width: var(--block-width); margin: 0; padding: var(--padding-top) var(--padding-right) var(--padding-bottom) var(--padding-left); text-align: var(--block-align); color: var(--block-color); }
  .heading-custom { font-size: var(--font-size-heading-custom, var(--font-size-heading-md)); }
  @media (max-width: 767.98px) { .heading-text { width: var(--block-width-mobile); padding: var(--padding-top-mobile) var(--padding-right-mobile) var(--padding-bottom-mobile) var(--padding-left-mobile); text-align: var(--block-align-mobile); } }
{% endstylesheet %}

{% schema %}{
  "name": "t:blocks.heading.name",
  "settings": [
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:blocks.heading.text",
      "default": "<p>Heading</p>"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "display",
          "label": "Display"
        },
        {
          "value": "xl",
          "label": "Extra large"
        },
        {
          "value": "lg",
          "label": "Large"
        },
        {
          "value": "md",
          "label": "Medium"
        },
        {
          "value": "sm",
          "label": "Small"
        },
        {
          "value": "xs",
          "label": "Extra small"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "lg"
    },
    {
      "type": "select",
      "id": "html_tag",
      "label": "HTML tag",
      "info": "Use headings in order (H1 → H2 → H3) for better SEO and readability. If unsure, choose Paragraph.",
      "options": [
        {
          "value": "div",
          "label": "Paragraph"
        },
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ],
      "default": "h2"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:blocks.common.text_color",
      "info": "t:blocks.common.inherited_color"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:blocks.common.width",
      "options": [
        {
          "value": "fit",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        }
      ],
      "default": "fill"
    },
    {
      "type": "checkbox",
      "id": "customize_mobile_width",
      "label": "Customize mobile width",
      "default": false
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:blocks.common.width_mobile",
      "options": [
        {
          "value": "fit",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        }
      ],
      "default": "fill",
      "visible_if": "{{ block.settings.customize_mobile_width }}"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:blocks.common.alignment",
      "options": [
        {
          "value": "start",
          "label": "Start"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "End"
        }
      ],
      "default": "start",
      "visible_if": "{{ block.settings.width == 'fill' }}"
    },
    {
      "type": "checkbox",
      "id": "customize_mobile_alignment",
      "label": "t:blocks.common.customize_mobile_alignment",
      "default": false
    },
    {
      "type": "select",
      "id": "alignment_mobile",
      "label": "t:blocks.common.mobile_alignment",
      "options": [
        {
          "value": "start",
          "label": "Start"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "End"
        }
      ],
      "default": "start",
      "visible_if": "{{ block.settings.customize_mobile_width and block.settings.customize_mobile_alignment and block.settings.width_mobile == 'fill' }}"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:blocks.common.padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:blocks.common.padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "t:blocks.common.padding_left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "t:blocks.common.padding_right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "customize_mobile_padding",
      "label": "t:blocks.common.customize_mobile_padding",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:blocks.common.padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:blocks.common.padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "label": "t:blocks.common.padding_left_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "label": "t:blocks.common.padding_right_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.heading.name"
    }
  ]
}{% endschema %}
