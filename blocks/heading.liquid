{% doc %}
  Renders a semantic heading with an independent visual scale.
{% enddoc %}

{% assign heading_class = 'heading-md' %}
{% case block.settings.heading_size %}
  {% when 'xs' %}{% assign heading_class = 'heading-xs' %}
  {% when 'sm' %}{% assign heading_class = 'heading-sm' %}
  {% when 'lg' %}{% assign heading_class = 'heading-lg' %}
  {% when 'xl' %}{% assign heading_class = 'heading-xl' %}
  {% when 'display' %}{% assign heading_class = 'heading-display' %}
{% endcase %}
{% assign heading_width = 'fit-content' %}
{% if block.settings.width == 'fill' %}{% assign heading_width = '100%' %}{% endif %}
{% assign heading_width_mobile = 'fit-content' %}
{% if block.settings.width_mobile == 'fill' %}{% assign heading_width_mobile = '100%' %}{% endif %}
{% assign heading_alignment_mobile = block.settings.alignment %}
{% if block.settings.customize_mobile_alignment and block.settings.width_mobile == 'fill' %}{% assign heading_alignment_mobile = block.settings.alignment_mobile %}{% endif %}

{% capture heading_style %}--block-width: {{ heading_width }}; --block-width-mobile: {{ heading_width_mobile }}; --block-align: {{ block.settings.alignment }}; --block-align-mobile: {{ heading_alignment_mobile }}; --block-color: {{ block.settings.text_color | default: 'var(--heading-color)' }}; --padding-top: {{ block.settings.padding_top }}px; --padding-bottom: {{ block.settings.padding_bottom }}px; --padding-left: {{ block.settings.padding_left }}px; --padding-right: {{ block.settings.padding_right }}px; --padding-top-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_top_mobile }}{% else %}{{ block.settings.padding_top }}{% endif %}px; --padding-bottom-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_bottom_mobile }}{% else %}{{ block.settings.padding_bottom }}{% endif %}px; --padding-left-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_left_mobile }}{% else %}{{ block.settings.padding_left }}{% endif %}px; --padding-right-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_right_mobile }}{% else %}{{ block.settings.padding_right }}{% endif %}px;{% endcapture %}

{% if block.settings.heading != blank %}
  {% case block.settings.html_tag %}
    {% when 'div' %}<div class="heading-text {{ heading_class }}" style="{{ heading_style }}" {{ block.shopify_attributes }}>{{ block.settings.heading }}</div>
    {% when 'h1' %}<h1 class="heading-text {{ heading_class }}" style="{{ heading_style }}" {{ block.shopify_attributes }}>{{ block.settings.heading }}</h1>
    {% when 'h3' %}<h3 class="heading-text {{ heading_class }}" style="{{ heading_style }}" {{ block.shopify_attributes }}>{{ block.settings.heading }}</h3>
    {% when 'h4' %}<h4 class="heading-text {{ heading_class }}" style="{{ heading_style }}" {{ block.shopify_attributes }}>{{ block.settings.heading }}</h4>
    {% when 'h5' %}<h5 class="heading-text {{ heading_class }}" style="{{ heading_style }}" {{ block.shopify_attributes }}>{{ block.settings.heading }}</h5>
    {% when 'h6' %}<h6 class="heading-text {{ heading_class }}" style="{{ heading_style }}" {{ block.shopify_attributes }}>{{ block.settings.heading }}</h6>
    {% else %}<h2 class="heading-text {{ heading_class }}" style="{{ heading_style }}" {{ block.shopify_attributes }}>{{ block.settings.heading }}</h2>
  {% endcase %}
{% endif %}

{% stylesheet %}
  .heading-text { width: var(--block-width); margin: 0; padding: var(--padding-top) var(--padding-right) var(--padding-bottom) var(--padding-left); text-align: var(--block-align); color: var(--block-color); }
  @media (max-width: 767.98px) { .heading-text { width: var(--block-width-mobile); padding: var(--padding-top-mobile) var(--padding-right-mobile) var(--padding-bottom-mobile) var(--padding-left-mobile); text-align: var(--block-align-mobile); } }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.heading.name",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "t:blocks.heading.text", "default": "Heading" },
    { "type": "select", "id": "heading_size", "label": "t:blocks.heading.visual_scale", "options": [{ "value": "xs", "label": "XS" }, { "value": "sm", "label": "SM" }, { "value": "md", "label": "MD" }, { "value": "lg", "label": "LG" }, { "value": "xl", "label": "XL" }, { "value": "display", "label": "Display" }], "default": "lg" },
    { "type": "select", "id": "html_tag", "label": "t:blocks.heading.level", "info": "t:blocks.heading.level_info", "options": [{ "value": "div", "label": "Text container" }, { "value": "h1", "label": "H1" }, { "value": "h2", "label": "H2" }, { "value": "h3", "label": "H3" }, { "value": "h4", "label": "H4" }, { "value": "h5", "label": "H5" }, { "value": "h6", "label": "H6" }], "default": "h2" },
    { "type": "color", "id": "text_color", "label": "t:blocks.common.text_color", "info": "t:blocks.common.inherited_color" },
    { "type": "select", "id": "width", "label": "t:blocks.common.width", "options": [{ "value": "fit", "label": "Fit" }, { "value": "fill", "label": "Fill" }], "default": "fill" },
    { "type": "select", "id": "width_mobile", "label": "t:blocks.common.width_mobile", "options": [{ "value": "fit", "label": "Fit" }, { "value": "fill", "label": "Fill" }], "default": "fill" },
    { "type": "select", "id": "alignment", "label": "t:blocks.common.alignment", "options": [{ "value": "start", "label": "Start" }, { "value": "center", "label": "Center" }, { "value": "end", "label": "End" }], "default": "start", "visible_if": "{{ block.settings.width == 'fill' }}" },
    { "type": "checkbox", "id": "customize_mobile_alignment", "label": "t:blocks.common.customize_mobile_alignment", "default": false },
    { "type": "select", "id": "alignment_mobile", "label": "t:blocks.common.mobile_alignment", "options": [{ "value": "start", "label": "Start" }, { "value": "center", "label": "Center" }, { "value": "end", "label": "End" }], "default": "start", "visible_if": "{{ block.settings.customize_mobile_alignment and block.settings.width_mobile == 'fill' }}" },
    { "type": "header", "content": "t:blocks.common.padding" },
    { "type": "range", "id": "padding_top", "label": "t:blocks.common.padding_top", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "t:blocks.common.padding_bottom", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_left", "label": "t:blocks.common.padding_left", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_right", "label": "t:blocks.common.padding_right", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 },
    { "type": "checkbox", "id": "customize_mobile_padding", "label": "t:blocks.common.customize_mobile_padding", "default": false },
    { "type": "range", "id": "padding_top_mobile", "label": "t:blocks.common.padding_top_mobile", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0, "visible_if": "{{ block.settings.customize_mobile_padding }}" },
    { "type": "range", "id": "padding_bottom_mobile", "label": "t:blocks.common.padding_bottom_mobile", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0, "visible_if": "{{ block.settings.customize_mobile_padding }}" },
    { "type": "range", "id": "padding_left_mobile", "label": "t:blocks.common.padding_left_mobile", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0, "visible_if": "{{ block.settings.customize_mobile_padding }}" },
    { "type": "range", "id": "padding_right_mobile", "label": "t:blocks.common.padding_right_mobile", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0, "visible_if": "{{ block.settings.customize_mobile_padding }}" }
  ],
  "presets": [{ "name": "t:blocks.heading.name" }]
}
{% endschema %}
