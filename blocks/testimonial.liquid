{% doc %}Customer testimonial content block.{% enddoc %}
<figure class="controlled-testimonial" {{ block.shopify_attributes }}><blockquote>{{ block.settings.quote }}</blockquote><figcaption>{{ block.settings.author }}{% if block.settings.role != blank %}<span>{{ block.settings.role }}</span>{% endif %}</figcaption></figure>
{% stylesheet %}.controlled-testimonial{margin:0;padding:var(--space-large);background:var(--color-background-2);border-radius:var(--radius-rounded)}.controlled-testimonial blockquote{margin:0 0 var(--space-small);font-family:var(--font-accent-family);font-size:1.25em}.controlled-testimonial figcaption{display:grid;gap:.25rem;font-weight:600}.controlled-testimonial figcaption span{font-weight:400;color:var(--color-muted)}{% endstylesheet %}
{% schema %}{"name":"Testimonial","settings":[{"type":"textarea","id":"quote","label":"Quote","default":"A great experience."},{"type":"text","id":"author","label":"Author","default":"Customer"},{"type":"text","id":"role","label":"Role"}],"presets":[{"name":"Testimonial"}]}{% endschema %}
