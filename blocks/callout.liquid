{% doc %}Callout message with optional action.{% enddoc %}
<aside class="controlled-callout controlled-callout--{{ block.settings.tone }}" {{ block.shopify_attributes }}><h2>{{ block.settings.heading }}</h2><p>{{ block.settings.text }}</p>{% if block.settings.link != blank %}<a href="{{ block.settings.link }}">{{ block.settings.link_label }}</a>{% endif %}</aside>
{% stylesheet %}.controlled-callout{padding:var(--space-large);border-inline-start:4px solid var(--color-accent);background:var(--color-background-2)}.controlled-callout h2,.controlled-callout p{margin-block:0 var(--space-small)}{% endstylesheet %}
{% schema %}{"name":"Callout","settings":[{"type":"text","id":"heading","label":"Heading","default":"Good to know"},{"type":"textarea","id":"text","label":"Text","default":"Add an important message."},{"type":"url","id":"link","label":"Link"},{"type":"text","id":"link_label","label":"Link label","default":"Learn more"},{"type":"select","id":"tone","label":"Tone","options":[{"value":"info","label":"Info"},{"value":"success","label":"Success"},{"value":"warning","label":"Warning"}],"default":"info"}],"presets":[{"name":"Callout"}]}{% endschema %}
