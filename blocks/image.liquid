{% doc %}
  Renders responsive media with controlled source, ratio, width and surface settings.
{% enddoc %}

{% assign image_width = 'fit-content' %}
{% if block.settings.width == 'fill' %}{% assign image_width = '100%' %}{% elsif block.settings.width == 'custom' %}{% assign image_width = block.settings.max_width | append: 'px' %}{% endif %}
{% assign image_width_mobile = image_width %}
{% if block.settings.mobile_image != blank %}{% assign mobile_image_source = block.settings.mobile_image %}{% else %}{% assign mobile_image_source = block.settings.image %}{% endif %}

{% if block.settings.image != blank %}
  <div class="image image--{{ block.settings.ratio }} image--device-{{ block.settings.device }} image--radius-{{ block.settings.corner_radius }}" style="--image-width: {{ image_width }}; --image-width-mobile: {{ image_width_mobile }}; --image-padding: {{ block.settings.padding }}px;" {{ block.shopify_attributes }}>
    {% if block.settings.link != blank %}<a class="image__link" href="{{ block.settings.link }}"{% if block.settings.open_in_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>{% endif %}
      <picture>{% if block.settings.mobile_image != blank %}<source media="(max-width: 767.98px)" srcset="{{ mobile_image_source | image_url: width: 1200 }}">{% endif %}{{ block.settings.image | image_url: width: 2000 | image_tag: alt: block.settings.alt, loading: 'lazy' }}</picture>
    {% if block.settings.link != blank %}</a>{% endif %}
  </div>
{% else %}
  <div class="image image--{{ block.settings.ratio }} image--radius-{{ block.settings.corner_radius }}" style="--image-width: {{ image_width }}; --image-width-mobile: {{ image_width_mobile }}; --image-padding: {{ block.settings.padding }}px;" {{ block.shopify_attributes }}>{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}</div>
{% endif %}

{% stylesheet %}
  .image { width: var(--image-width); max-width: 100%; overflow: hidden; padding: var(--image-padding); }
  .image__link, .image picture { display: block; width: 100%; height: 100%; }
  .image img, .image .placeholder-svg { display: block; width: 100%; height: 100%; object-fit: cover; }
  .image--adapt { aspect-ratio: auto; }
  .image--square, .image--portrait, .image--landscape, .image--wide { aspect-ratio: 1 / 1; }
  .image--portrait { aspect-ratio: 3 / 4; }
  .image--landscape { aspect-ratio: 4 / 3; }
  .image--wide { aspect-ratio: 16 / 9; }
  .image--radius-inherit { border-radius: inherit; }
  .image--radius-none { border-radius: var(--radius-square); }
  .image--radius-small { border-radius: var(--radius-slight); }
  .image--radius-medium { border-radius: var(--radius-rounded); }
  .image--radius-large { border-radius: var(--radius-extra); }
  @media (max-width: 767.98px) { .image { width: var(--image-width-mobile); } .image--device-desktop { display: none; } }
  @media (min-width: 768px) { .image--device-mobile { display: none; } }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.image.name",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "t:blocks.image.source" },
    { "type": "image_picker", "id": "mobile_image", "label": "t:blocks.image.mobile_source" },
    { "type": "checkbox", "id": "show_image_first_on_mobile", "label": "t:blocks.image.mobile_first", "default": true },
    { "type": "text", "id": "alt", "label": "t:blocks.image.alt", "default": "Image" },
    { "type": "url", "id": "link", "label": "t:blocks.common.link" },
    { "type": "checkbox", "id": "open_in_new_tab", "label": "t:blocks.common.open_new_tab", "default": false, "visible_if": "{{ block.settings.link != blank }}" },
    { "type": "select", "id": "ratio", "label": "t:blocks.common.ratio", "options": [{ "value": "adapt", "label": "Adapt" }, { "value": "square", "label": "Square" }, { "value": "portrait", "label": "Portrait" }, { "value": "landscape", "label": "Landscape" }, { "value": "wide", "label": "Wide" }], "default": "adapt" },
    { "type": "select", "id": "device", "label": "t:blocks.image.device", "options": [{ "value": "all", "label": "All devices" }, { "value": "desktop", "label": "Desktop only" }, { "value": "mobile", "label": "Mobile only" }], "default": "all" },
    { "type": "select", "id": "width", "label": "t:blocks.common.width", "options": [{ "value": "fit", "label": "Fit" }, { "value": "fill", "label": "Fill" }, { "value": "custom", "label": "Custom" }], "default": "fill" },
    { "type": "checkbox", "id": "limit_width", "label": "t:blocks.image.limit_width", "default": false },
    { "type": "range", "id": "max_width", "label": "t:blocks.image.max_width", "min": 320, "max": 1600, "step": 20, "unit": "px", "default": 800, "visible_if": "{{ block.settings.width == 'custom' or block.settings.limit_width }}" },
    { "type": "select", "id": "corner_radius", "label": "t:blocks.image.radius", "options": [{ "value": "inherit", "label": "Inherit" }, { "value": "none", "label": "None" }, { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" }], "default": "inherit" },
    { "type": "range", "id": "padding", "label": "t:blocks.common.padding", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 }
  ],
  "presets": [{ "name": "t:blocks.image.name" }]
}
{% endschema %}
