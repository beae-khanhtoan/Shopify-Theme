{% doc %}
  Renders an image with an explicit ratio contract and optional link.
{% enddoc %}

{% if block.settings.image != blank %}
  {% if block.settings.link != blank %}<a class="image image--{{ block.settings.ratio }}" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{% endif %}
    {{ block.settings.image | image_url: width: 1600 | image_tag: alt: block.settings.alt, loading: 'lazy' }}
  {% if block.settings.link != blank %}</a>{% endif %}
{% else %}
  <div class="image image--{{ block.settings.ratio }}" {{ block.shopify_attributes }}>
    {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
  </div>
{% endif %}

{% stylesheet %}
  .image { display: block; overflow: hidden; }
  .image img, .image .placeholder-svg { display: block; width: 100%; height: 100%; object-fit: cover; }
  .image--square, .image--portrait, .image--landscape, .image--wide { aspect-ratio: 1 / 1; }
  .image--portrait { aspect-ratio: 3 / 4; }
  .image--landscape { aspect-ratio: 4 / 3; }
  .image--wide { aspect-ratio: 16 / 9; }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.image.name",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "t:blocks.image.source" },
    { "type": "text", "id": "alt", "label": "t:blocks.image.alt", "default": "" },
    { "type": "select", "id": "ratio", "label": "t:blocks.common.ratio", "options": [
      { "value": "adapt", "label": "Adapt" }, { "value": "square", "label": "Square" }, { "value": "portrait", "label": "Portrait" }, { "value": "landscape", "label": "Landscape" }, { "value": "wide", "label": "Wide" }
    ], "default": "adapt" },
    { "type": "url", "id": "link", "label": "t:blocks.common.link" }
  ],
  "presets": [{ "name": "t:blocks.image.name" }]
}
{% endschema %}
