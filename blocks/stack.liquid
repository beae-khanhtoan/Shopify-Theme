{% doc %}Preset vertical composition with controlled gap and alignment.{% enddoc %}
{% assign stack_width = '100%' %}{% if block.settings.width == 'content' %}{% assign stack_width = 'fit-content' %}{% elsif block.settings.width == 'custom' %}{% assign stack_width = block.settings.max_width | append: 'px' %}{% endif %}
<div class="block-stack" style="--stack-width: {{ stack_width }}; --stack-gap: var(--space-{{ block.settings.gap }}); --stack-align: {{ block.settings.alignment }};" {{ block.shopify_attributes }}>{% content_for 'blocks' %}</div>
{% stylesheet %}.block-stack { box-sizing: border-box; display: flex; flex-direction: column; gap: var(--stack-gap); align-items: var(--stack-align); width: var(--stack-width); max-width: 100%; min-width: 0; overflow: hidden; }.block-stack > * { min-width: 0; max-width: 100%; }{% endstylesheet %}
{% schema %}
{"name":"t:blocks.stack.name","blocks":[{"type":"heading"},{"type":"text"},{"type":"eyebrow"},{"type":"button"},{"type":"image"},{"type":"video"},{"type":"icon"},{"type":"header"}],"settings":[{"type":"select","id":"gap","label":"t:blocks.layout.gap","options":[{"value":"small","label":"Small"},{"value":"medium","label":"Medium"},{"value":"large","label":"Large"}],"default":"medium"},{"type":"select","id":"alignment","label":"t:blocks.layout.alignment","options":[{"value":"flex-start","label":"Start"},{"value":"center","label":"Center"},{"value":"flex-end","label":"End"},{"value":"stretch","label":"Stretch"}],"default":"stretch"},{"type":"select","id":"width","label":"t:blocks.layout.width","options":[{"value":"content","label":"Content"},{"value":"full","label":"Full"},{"value":"custom","label":"Custom"}],"default":"full"},{"type":"range","id":"max_width","label":"t:blocks.layout.max_width","min":320,"max":1600,"step":20,"unit":"px","default":800,"visible_if":"{{ block.settings.width == 'custom' }}"}],"presets":[{"category":"Block Layout","name":"t:blocks.stack.name"}]}
{% endschema %}
