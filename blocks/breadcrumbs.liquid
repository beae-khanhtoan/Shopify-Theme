{% doc %}Semantic route breadcrumbs with a safe fallback to the current page title.{% enddoc %}
{% assign crumb_title = page_title | default: 'Page' %}
<nav class="navigation-breadcrumbs navigation-breadcrumbs--{{ block.settings.width }} navigation-breadcrumbs--{{ block.settings.truncation }} navigation-breadcrumbs--{{ block.settings.current_color }} navigation-breadcrumbs--{{ block.settings.mobile_behavior }} navigation-breadcrumbs--{{ block.settings.source }} navigation-breadcrumbs--{{ block.settings.text_role }}" aria-label="Breadcrumb" style="--crumb-gap: {{ block.settings.gap }}px; --crumb-align: {{ block.settings.alignment }}; --crumb-separator: '{% if block.settings.separator == 'slash' %}/{% else %}›{% endif %}'; --crumb-padding-top: {{ block.settings.padding_top }}px; --crumb-padding-bottom: {{ block.settings.padding_bottom }}px; --crumb-padding-top-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_top_mobile }}{% else %}{{ block.settings.padding_top }}{% endif %}px; --crumb-padding-bottom-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_bottom_mobile }}{% else %}{{ block.settings.padding_bottom }}{% endif %}px;" {{ block.shopify_attributes }}>
  <ol class="navigation-breadcrumbs__list">
    <li><a href="{{ routes.root_url }}">Home</a></li>
    {% if collection %}<li><a href="{{ collection.url }}">{{ collection.title | escape }}</a></li>{% endif %}
    {% if product %}<li>{% if collection %}<a href="{{ product.url }}">{{ product.title | escape }}</a>{% else %}<span aria-current="page">{{ product.title | escape }}</span>{% endif %}</li>{% endif %}
    {% if block.settings.show_current_item %}{% if article %}<li><span aria-current="page">{{ article.title | escape }}</span></li>{% elsif page %}<li><span aria-current="page">{{ page.title | escape }}</span></li>{% elsif product == blank and collection == blank %}<li><span aria-current="page">{{ crumb_title | escape }}</span></li>{% endif %}{% endif %}
  </ol>
</nav>
{% stylesheet %}.navigation-breadcrumbs { width: 100%; max-width: var(--content-max-width); padding-block: var(--crumb-padding-top) var(--crumb-padding-bottom); text-align: var(--crumb-align); }.navigation-breadcrumbs--full { max-width: none; }.navigation-breadcrumbs--body { font-family: var(--font-body-family); }.navigation-breadcrumbs--heading { font-family: var(--font-heading-family); color: var(--color-foreground); }.navigation-breadcrumbs__list { display: flex; flex-wrap: wrap; gap: var(--crumb-gap); margin: 0; padding: 0; list-style: none; }.navigation-breadcrumbs__list li:not(:last-child)::after { content: var(--crumb-separator); margin-inline-start: var(--crumb-gap); color: var(--color-muted); }.navigation-breadcrumbs a { color: inherit; }.navigation-breadcrumbs--end_ellipsis li:last-child { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; } @media (max-width: 767.98px) { .navigation-breadcrumbs { padding-block: var(--crumb-padding-top-mobile) var(--crumb-padding-bottom-mobile); } }{% endstylesheet %}
{% schema %}{"name":"t:blocks.navigation.breadcrumbs_name","settings":[{"type":"header","content":"Source"},{"type":"select","id":"source","label":"Route source","options":[{"value":"automatic","label":"Automatic route"},{"value":"manual","label":"Manual override"}],"default":"automatic"},{"type":"header","content":"Content"},{"type":"checkbox","id":"show_current_item","label":"Show current item","default":true},{"type":"header","content":"Appearance"},{"type":"select","id":"text_role","label":"Text role","options":[{"value":"body","label":"Body"},{"value":"heading","label":"Heading"}],"default":"body"},{"type":"select","id":"separator","label":"Separator","options":[{"value":"chevron","label":"Chevron"},{"value":"slash","label":"Slash"}],"default":"chevron"},{"type":"select","id":"current_color","label":"Current color","options":[{"value":"text","label":"Text"},{"value":"heading","label":"Heading"}],"default":"text"},{"type":"select","id":"truncation","label":"Truncation","options":[{"value":"none","label":"None"},{"value":"end_ellipsis","label":"End ellipsis"}],"default":"end_ellipsis"},{"type":"header","content":"Layout"},{"type":"select","id":"width","label":"Width","options":[{"value":"content","label":"Content"},{"value":"full","label":"Full"}],"default":"content"},{"type":"select","id":"mobile_behavior","label":"Mobile behavior","options":[{"value":"truncate","label":"Truncate"}],"default":"truncate"},{"type":"select","id":"alignment","label":"Alignment","options":[{"value":"start","label":"Start"},{"value":"center","label":"Center"},{"value":"end","label":"End"}],"default":"start"},{"type":"range","id":"gap","label":"Gap","min":0,"max":64,"step":1,"unit":"px","default":8},{"type":"header","content":"Padding"},{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":100,"step":1,"unit":"px","default":0},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":100,"step":1,"unit":"px","default":0},{"type":"checkbox","id":"customize_mobile_padding","label":"Customize mobile padding","default":false},{"type":"range","id":"padding_top_mobile","label":"Mobile top padding","min":0,"max":100,"step":1,"unit":"px","default":0,"visible_if":"{{ block.settings.customize_mobile_padding }}"},{"type":"range","id":"padding_bottom_mobile","label":"Mobile bottom padding","min":0,"max":100,"step":1,"unit":"px","default":0,"visible_if":"{{ block.settings.customize_mobile_padding }}"}],"presets":[{"name":"t:blocks.navigation.breadcrumbs_name"}]}{% endschema %}
