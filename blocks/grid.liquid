{% doc %}Responsive grid composition owning columns, gaps and item alignment.{% enddoc %}
<div class="block-grid{% if block.settings.item_height == 'equal' %} block-grid--equal-height{% endif %}" style="--grid-columns: {{ block.settings.columns_desktop }}; --grid-columns-tablet: {{ block.settings.columns_tablet }}; --grid-columns-mobile: {{ block.settings.columns_mobile }}; --grid-column-gap: {{ block.settings.column_gap }}px; --grid-row-gap: {{ block.settings.row_gap }}px; --grid-align: {{ block.settings.alignment }};" {{ block.shopify_attributes }}>{% content_for 'blocks' %}</div>
{% stylesheet %}.block-grid { display: grid; grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr)); column-gap: var(--grid-column-gap); row-gap: var(--grid-row-gap); align-items: var(--grid-align); width: 100%; min-width: 0; overflow: clip; }.block-grid > * { min-width: 0; max-width: 100%; }.block-grid--equal-height > * { height: 100%; } @media (max-width: 1149.98px) { .block-grid { grid-template-columns: repeat(var(--grid-columns-tablet), minmax(0, 1fr)); } } @media (max-width: 767.98px) { .block-grid { grid-template-columns: repeat(var(--grid-columns-mobile), minmax(0, 1fr)); } }{% endstylesheet %}
{% schema %}
{"name":"t:blocks.grid.name","blocks":[{"type":"heading"},{"type":"text"},{"type":"eyebrow"},{"type":"button"},{"type":"image"},{"type":"video"},{"type":"icon"},{"type":"header"}],"settings":[{"type":"range","id":"columns_desktop","label":"t:blocks.layout.columns_desktop","min":1,"max":6,"step":1,"default":3},{"type":"range","id":"columns_tablet","label":"t:blocks.layout.columns_tablet","min":1,"max":4,"step":1,"default":2},{"type":"range","id":"columns_mobile","label":"t:blocks.layout.columns_mobile","min":1,"max":3,"step":1,"default":1},{"type":"range","id":"column_gap","label":"t:blocks.layout.column_gap","min":0,"max":64,"step":4,"unit":"px","default":24},{"type":"range","id":"row_gap","label":"t:blocks.layout.row_gap","min":0,"max":64,"step":4,"unit":"px","default":24},{"type":"select","id":"alignment","label":"t:blocks.layout.alignment","options":[{"value":"stretch","label":"Stretch"},{"value":"start","label":"Start"},{"value":"center","label":"Center"}],"default":"stretch"},{"type":"select","id":"item_height","label":"t:blocks.layout.item_height","options":[{"value":"auto","label":"Auto"},{"value":"equal","label":"Equal"}],"default":"auto"}],"presets":[{"name":"t:blocks.grid.name"}]}
{% endschema %}
