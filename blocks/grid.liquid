{% doc %}Responsive grid composition owning columns, gaps and item alignment.{% enddoc %}
<div class="block-grid{% if block.settings.item_height == 'equal' %} block-grid--equal-height{% endif %}{% if block.settings.show_background %} block-grid--surface{% endif %}" style="--grid-columns: {{ block.settings.columns_desktop }}; --grid-columns-tablet: {{ block.settings.columns_tablet }}; --grid-columns-mobile: {{ block.settings.columns_mobile }}; --grid-column-gap: {{ block.settings.column_gap }}px; --grid-row-gap: {{ block.settings.row_gap }}px; --grid-column-gap-mobile: {{ block.settings.column_gap_mobile }}px; --grid-row-gap-mobile: {{ block.settings.row_gap_mobile }}px; --grid-align: {{ block.settings.alignment }}; --grid-border-thickness: {{ block.settings.border_thickness }}px; --grid-radius: {{ block.settings.corner_radius }}px; --grid-padding-top: {{ block.settings.padding_top }}px; --grid-padding-right: {{ block.settings.padding_right }}px; --grid-padding-bottom: {{ block.settings.padding_bottom }}px; --grid-padding-left: {{ block.settings.padding_left }}px; --grid-padding-top-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_top_mobile }}{% else %}{{ block.settings.padding_top }}{% endif %}px; --grid-padding-right-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_right_mobile }}{% else %}{{ block.settings.padding_right }}{% endif %}px; --grid-padding-bottom-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_bottom_mobile }}{% else %}{{ block.settings.padding_bottom }}{% endif %}px; --grid-padding-left-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_left_mobile }}{% else %}{{ block.settings.padding_left }}{% endif %}px;" {{ block.shopify_attributes }}>{% content_for 'blocks' %}</div>
{% stylesheet %}.block-grid { box-sizing: border-box; display: grid; grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr)); column-gap: var(--grid-column-gap); row-gap: var(--grid-row-gap); align-items: var(--grid-align); width: 100%; min-width: 0; overflow: clip; padding: var(--grid-padding-top) var(--grid-padding-right) var(--grid-padding-bottom) var(--grid-padding-left); border: var(--grid-border-thickness) solid transparent; border-radius: var(--grid-radius); }.block-grid--surface { background: var(--color-background); border-color: var(--color-border); }.block-grid > * { min-width: 0; max-width: 100%; }.block-grid--equal-height > * { height: 100%; } @media (max-width: 1149.98px) { .block-grid { grid-template-columns: repeat(var(--grid-columns-tablet), minmax(0, 1fr)); } } @media (max-width: 767.98px) { .block-grid { grid-template-columns: repeat(var(--grid-columns-mobile), minmax(0, 1fr)); column-gap: var(--grid-column-gap-mobile); row-gap: var(--grid-row-gap-mobile); padding: var(--grid-padding-top-mobile) var(--grid-padding-right-mobile) var(--grid-padding-bottom-mobile) var(--grid-padding-left-mobile); } }{% endstylesheet %}
