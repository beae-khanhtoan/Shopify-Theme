{% doc %}
  Renders up to two fixed CTA slots with a shared responsive layout.
{% enddoc %}

{% assign buttons_justify = 'flex-start' %}{% if block.settings.alignment == 'center' %}{% assign buttons_justify = 'center' %}{% elsif block.settings.alignment == 'end' %}{% assign buttons_justify = 'flex-end' %}{% endif %}
{% assign buttons_width = 'max-content' %}{% if block.settings.width == 'fill' %}{% assign buttons_width = '100%' %}{% endif %}
{% assign buttons_direction_mobile = block.settings.mobile_stacking %}
<div class="micro-buttons micro-buttons--{{ block.settings.direction }} micro-buttons--mobile-{{ buttons_direction_mobile }}" style="--buttons-width: {{ buttons_width }}; --buttons-gap: {{ block.settings.gap }}px; --buttons-gap-mobile: {{ block.settings.gap_mobile }}px; --buttons-justify: {{ buttons_justify }}; --buttons-padding-top: {{ block.settings.padding_top }}px; --buttons-padding-right: {{ block.settings.padding_right }}px; --buttons-padding-bottom: {{ block.settings.padding_bottom }}px; --buttons-padding-left: {{ block.settings.padding_left }}px; --buttons-padding-top-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_top_mobile }}{% else %}{{ block.settings.padding_top }}{% endif %}px; --buttons-padding-right-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_right_mobile }}{% else %}{{ block.settings.padding_right }}{% endif %}px; --buttons-padding-bottom-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_bottom_mobile }}{% else %}{{ block.settings.padding_bottom }}{% endif %}px; --buttons-padding-left-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_left_mobile }}{% else %}{{ block.settings.padding_left }}{% endif %}px;" {{ block.shopify_attributes }}>
  {% if block.settings.button_1_label != blank and block.settings.button_1_link != blank %}<a class="button btn--{{ block.settings.button_1_style }}" href="{{ block.settings.button_1_link }}"{% if block.settings.button_1_open_in_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>{% if block.settings.button_1_show_icon %}<span class="micro-buttons__icon" aria-hidden="true">{{ 'icon-cart.svg' | inline_asset_content }}</span>{% endif %}<span>{{ block.settings.button_1_label | escape }}</span></a>{% endif %}
  {% if block.settings.button_2_label != blank and block.settings.button_2_link != blank %}<a class="button btn--{{ block.settings.button_2_style }}" href="{{ block.settings.button_2_link }}"{% if block.settings.button_2_open_in_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>{% if block.settings.button_2_show_icon %}<span class="micro-buttons__icon" aria-hidden="true">{{ 'icon-cart.svg' | inline_asset_content }}</span>{% endif %}<span>{{ block.settings.button_2_label | escape }}</span></a>{% endif %}
</div>

{% stylesheet %}
  .micro-buttons { box-sizing: border-box; display: flex; flex-direction: row; flex-wrap: wrap; align-items: center; justify-content: var(--buttons-justify); width: var(--buttons-width); max-width: 100%; gap: var(--buttons-gap); padding: var(--buttons-padding-top) var(--buttons-padding-right) var(--buttons-padding-bottom) var(--buttons-padding-left); }
  .micro-buttons--stack { flex-direction: column; align-items: stretch; }
  .micro-buttons .button { display: inline-flex; align-items: center; justify-content: center; gap: .5em; min-height: 2.75rem; border-radius: var(--radius-buttons-inputs); font: inherit; text-decoration: none; cursor: pointer; }
  .micro-buttons__icon { display: inline-flex; width: 1em; height: 1em; }
  .micro-buttons__icon svg { width: 100%; height: 100%; stroke-width: var(--icon-stroke-width); }
  .micro-buttons .btn--primary { background: var(--color-button); color: var(--color-button-label); }
  .micro-buttons .btn--secondary { background: var(--color-secondary-button); color: var(--color-secondary-button-label); }
  .micro-buttons .btn--tertiary { border: 0; background: transparent; color: var(--color-tertiary-button-label); text-decoration: underline; text-decoration-thickness: var(--button-tertiary-underline-thickness, 1px); text-underline-offset: var(--button-tertiary-underline-offset, .2em); }
  .micro-buttons .btn--tertiary:hover { background: transparent; color: var(--color-tertiary-button-label); }
  @media (max-width: 767.98px) { .micro-buttons { gap: var(--buttons-gap-mobile); padding: var(--buttons-padding-top-mobile) var(--buttons-padding-right-mobile) var(--buttons-padding-bottom-mobile) var(--buttons-padding-left-mobile); }.micro-buttons--mobile-stack { flex-direction: column; align-items: stretch; }.micro-buttons--mobile-row { flex-direction: row; } }
{% endstylesheet %}

{% schema %}
{"name":"Buttons","settings":[{"type":"header","content":"Button 1"},{"type":"text","id":"button_1_label","label":"Label","default":"Primary action"},{"type":"url","id":"button_1_link","label":"Link"},{"type":"checkbox","id":"button_1_open_in_new_tab","label":"Open link in new tab","default":false,"visible_if":"{{ block.settings.button_1_link != blank }}"},{"type":"select","id":"button_1_style","label":"Style","options":[{"value":"primary","label":"Primary"},{"value":"secondary","label":"Secondary"},{"value":"tertiary","label":"Tertiary"}],"default":"primary"},{"type":"checkbox","id":"button_1_show_icon","label":"Show icon","default":false},{"type":"header","content":"Button 2"},{"type":"text","id":"button_2_label","label":"Label","default":"Secondary action"},{"type":"url","id":"button_2_link","label":"Link"},{"type":"checkbox","id":"button_2_open_in_new_tab","label":"Open link in new tab","default":false,"visible_if":"{{ block.settings.button_2_link != blank }}"},{"type":"select","id":"button_2_style","label":"Style","options":[{"value":"primary","label":"Primary"},{"value":"secondary","label":"Secondary"},{"value":"tertiary","label":"Tertiary"}],"default":"secondary"},{"type":"checkbox","id":"button_2_show_icon","label":"Show icon","default":false},{"type":"header","content":"Layout"},{"type":"select","id":"direction","label":"Direction","options":[{"value":"row","label":"Row"},{"value":"stack","label":"Stack"}],"default":"row"},{"type":"range","id":"gap","label":"Desktop gap","min":0,"max":64,"step":1,"unit":"px","default":12},{"type":"range","id":"gap_mobile","label":"Mobile gap","min":0,"max":64,"step":1,"unit":"px","default":12},{"type":"select","id":"width","label":"Width","options":[{"value":"fit","label":"Fit"},{"value":"fill","label":"Fill"}],"default":"fit"},{"type":"select","id":"alignment","label":"Alignment","options":[{"value":"start","label":"Start"},{"value":"center","label":"Center"},{"value":"end","label":"End"}],"default":"start","visible_if":"{{ block.settings.width == 'fill' }}"},{"type":"select","id":"mobile_stacking","label":"Mobile stacking","options":[{"value":"row","label":"Row"},{"value":"stack","label":"Stack"}],"default":"stack"},{"type":"header","content":"Padding"},{"type":"range","id":"padding_top","label":"Top","min":0,"max":100,"step":1,"unit":"px","default":0},{"type":"range","id":"padding_bottom","label":"Bottom","min":0,"max":100,"step":1,"unit":"px","default":0},{"type":"range","id":"padding_left","label":"Left","min":0,"max":100,"step":1,"unit":"px","default":0},{"type":"range","id":"padding_right","label":"Right","min":0,"max":100,"step":1,"unit":"px","default":0},{"type":"checkbox","id":"customize_mobile_padding","label":"Customize mobile padding","default":false},{"type":"range","id":"padding_top_mobile","label":"Top","min":0,"max":100,"step":1,"unit":"px","default":0,"visible_if":"{{ block.settings.customize_mobile_padding }}"},{"type":"range","id":"padding_bottom_mobile","label":"Bottom","min":0,"max":100,"step":1,"unit":"px","default":0,"visible_if":"{{ block.settings.customize_mobile_padding }}"},{"type":"range","id":"padding_left_mobile","label":"Left","min":0,"max":100,"step":1,"unit":"px","default":0,"visible_if":"{{ block.settings.customize_mobile_padding }}"},{"type":"range","id":"padding_right_mobile","label":"Right","min":0,"max":100,"step":1,"unit":"px","default":0,"visible_if":"{{ block.settings.customize_mobile_padding }}"}],"presets":[{"category":"Block Basic","name":"Buttons"}]}
{% endschema %}
