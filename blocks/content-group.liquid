{% doc %}Flexible content group with bounded child composition.{% enddoc %}
<div class="composition-content-group composition-content-group--{{ block.settings.layout }}" style="--content-gap: {{ block.settings.gap }}px;" {{ block.shopify_attributes }}>{% content_for 'blocks' %}</div>
{% stylesheet %}.composition-content-group{display:flex;gap:var(--content-gap);width:100%;min-width:0}.composition-content-group--stack{flex-direction:column}.composition-content-group--row{flex-wrap:wrap}.composition-content-group>*{min-width:0;max-width:100%}{% endstylesheet %}
{% schema %}{"name":"Content group","blocks":[{"type":"heading"},{"type":"text"},{"type":"eyebrow"},{"type":"button"},{"type":"image"},{"type":"icon"}],"settings":[{"type":"select","id":"layout","label":"Layout","options":[{"value":"stack","label":"Stack"},{"value":"row","label":"Row"}],"default":"stack"},{"type":"range","id":"gap","label":"Gap","min":0,"max":64,"step":4,"unit":"px","default":16}],"presets":[{"name":"Content group"}]}{% endschema %}
