{% doc %}Commerce badges derived from current product state.{% enddoc %}
{% if product != blank %}<div class="commerce-product-badges" {{ block.shopify_attributes }}>{% if block.settings.show_sale and product.compare_at_price_max > product.price %}<span class="commerce-product-badge">Sale</span>{% endif %}{% if block.settings.show_sold_out and product.available == false %}<span class="commerce-product-badge">Sold out</span>{% endif %}</div>{% endif %}
{% stylesheet %}.commerce-product-badges { display: flex; flex-wrap: wrap; gap: var(--space-small); }.commerce-product-badge { padding: .25em .5em; background: var(--color-foreground); color: var(--color-background); font-size: .75em; }{% endstylesheet %}
{% schema %}{"name":"t:blocks.commerce.product_badges_name","settings":[{"type":"checkbox","id":"show_sale","label":"Show sale badge","default":true},{"type":"checkbox","id":"show_sold_out","label":"Show sold out badge","default":true}],"presets":[{"name":"t:blocks.commerce.product_badges_name"}]}{% endschema %}
