<main class="cart-page page-width" data-section-id="{{ section.id }}"><h1>{{ section.settings.heading | escape }}</h1>
{% if cart.item_count == 0 %}<p>{{ section.settings.empty_message | escape }}</p><a class="button" href="{{ section.settings.continue_url | default: routes.all_products_collection_url }}">{{ section.settings.continue_label | escape }}</a>
{% else %}<form action="{{ routes.cart_url }}" method="post" id="CartForm-{{ section.id }}"><div class="cart-lines">{% for item in cart.items %}<article class="cart-line"><a href="{{ item.url }}">{% if item.image %}{{ item.image | image_url: width: 160 | image_tag: alt: item.image.alt, loading: 'lazy' }}{% endif %}</a><div><h2><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h2>{% unless item.product.has_only_default_variant %}<p>{{ item.variant.title | escape }}</p>{% endunless %}<label for="CartQuantity-{{ item.index }}">Quantity</label><input id="CartQuantity-{{ item.index }}" name="updates[]" type="number" min="0" value="{{ item.quantity }}"><a href="{{ item.url_to_remove }}">Remove</a></div><strong>{{ item.final_line_price | money }}</strong></article>{% endfor %}</div>{% if section.settings.show_note %}<label for="CartNote-{{ section.id }}">Order note</label><textarea id="CartNote-{{ section.id }}" name="note">{{ cart.note }}</textarea>{% endif %}<div class="cart-summary"><p>Total <strong>{{ cart.total_price | money }}</strong></p><button type="submit" name="update" class="button button--secondary">Update cart</button><button type="submit" name="checkout" class="button">Checkout</button></div></form>{% endif %}</main>
{% stylesheet %}.cart-page{max-width:var(--page-width);margin:3rem auto;padding:0 var(--page-margin)}.cart-lines{display:grid;gap:1rem}.cart-line{display:grid;grid-template-columns:6rem 1fr auto;gap:1rem;align-items:start;padding:1rem 0;border-bottom:var(--border-width) solid var(--border-color)}.cart-line img{width:6rem;height:6rem;object-fit:cover}.cart-line h2{margin:0;font-size:1rem}.cart-line a{color:inherit}.cart-line input,.cart-page textarea{max-width:10rem;display:block;margin:.35rem 0 1rem}.cart-summary{text-align:right;margin-top:1.5rem}.cart-summary .button{margin-left:.5rem}@media(max-width:749px){.cart-page{padding:0 var(--page-margin-mobile)}.cart-line{grid-template-columns:4rem 1fr}.cart-line img{width:4rem;height:4rem}.cart-line strong{grid-column:2}.cart-summary{text-align:left}.cart-summary .button{margin:.5rem .5rem 0 0}}{% endstylesheet %}
{% schema %}{"name":"Cart","settings":[{"type":"text","id":"heading","label":"Heading","default":"Your cart"},{"type":"text","id":"empty_message","label":"Empty message","default":"Your cart is empty."},{"type":"text","id":"continue_label","label":"Continue shopping label","default":"Continue shopping"},{"type":"url","id":"continue_url","label":"Continue shopping link"},{"type":"checkbox","id":"show_note","label":"Show order note","default":true}]}{% endschema %}
