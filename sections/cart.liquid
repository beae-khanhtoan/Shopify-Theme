<main id="Cart-{{ section.id }}" class="cart-page" data-section-id="{{ section.id }}">
  {% render 'cart-surface', presentation: 'page', section_id: section.id, heading: section.settings.heading, empty_message: section.settings.empty_message, continue_label: section.settings.continue_label, continue_url: section.settings.continue_url, show_note: section.settings.show_note, close_label: 'Close cart', quantity_label: section.settings.quantity_label, note_label: section.settings.note_label, savings_label: section.settings.savings_label, total_label: section.settings.total_label, taxes_included_label: section.settings.taxes_included_label, view_cart_label: 'View cart' %}
</main>

{% stylesheet %}
  .cart-page { max-width: var(--page-width); margin: 3rem auto; padding: 0 var(--page-margin); }
  .cart-page__heading { margin: 0 0 2rem; }
  .cart-lines { display: grid; gap: 1rem; }
  .cart-line { display: grid; grid-template-columns: 6rem minmax(0, 1fr) auto; gap: 1rem; align-items: start; padding: 1rem 0; border-bottom: var(--border-width) solid var(--border-color); }
  .cart-line__image { width: 6rem; height: 6rem; object-fit: cover; }
  .cart-line__title { margin: 0; font-size: 1rem; }
  .cart-line a { color: inherit; }
  .cart-line__quantity { display: grid; gap: .35rem; max-width: 7rem; margin-top: 1rem; }
  .cart-line__quantity input { width: 100%; }
  .cart-line__price { white-space: nowrap; }
  .cart-line__price { display: grid; justify-items: end; gap: .25rem; }
  .cart-line__variant, .cart-line__property, .cart-summary__tax { margin-top: .35rem; color: var(--accent-color); font-size: var(--font-body-sm); }
  .cart-line__remove { display: inline-block; margin-top: .5rem; }
  .cart-page__note { display: grid; gap: .35rem; max-width: 32rem; margin-top: 1.5rem; }
  .cart-summary { display: grid; justify-items: end; gap: 1rem; margin-top: 1.5rem; }
  .cart-summary p { margin: 0; }
  .cart-summary__actions { display: flex; flex-wrap: wrap; gap: .5rem; }
  @media (max-width: 749px) { .cart-page { padding: 0 var(--page-margin-mobile); } .cart-line { grid-template-columns: 4rem minmax(0, 1fr); } .cart-line__image { width: 4rem; height: 4rem; } .cart-line__price { grid-column: 2; } .cart-summary { justify-items: start; } }
{% endstylesheet %}

{% schema %}
{ "name": "Cart", "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Your cart" }, { "type": "text", "id": "empty_message", "label": "Empty message", "default": "Your cart is empty." }, { "type": "text", "id": "continue_label", "label": "Continue shopping label", "default": "Continue shopping" }, { "type": "url", "id": "continue_url", "label": "Continue shopping link" }, { "type": "checkbox", "id": "show_note", "label": "Show order note", "default": true }, { "type": "text", "id": "quantity_label", "label": "Quantity label", "default": "Quantity" }, { "type": "text", "id": "note_label", "label": "Order note label", "default": "Order note" }, { "type": "text", "id": "savings_label", "label": "Savings label", "default": "Savings" }, { "type": "text", "id": "total_label", "label": "Total label", "default": "Total" }, { "type": "text", "id": "taxes_included_label", "label": "Taxes included label", "default": "Taxes included" } ] }
{% endschema %}
