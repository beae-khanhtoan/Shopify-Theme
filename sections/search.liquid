<main class="search-page page-width" data-section-id="{{ section.id }}">
  <h1>{{ section.settings.heading | escape }}</h1>
  {% render 'predictive-search-form', id: section.id, value: search.terms, placeholder: section.settings.placeholder, submit_label: section.settings.submit_label, predictive_enabled: section.settings.predictive_enabled, min_chars: section.settings.min_chars, predictive_limit: section.settings.predictive_limit, debounce: section.settings.debounce, products_label: section.settings.products_label, collections_label: section.settings.collections_label, pages_label: section.settings.pages_label, articles_label: section.settings.articles_label %}
  {% if search.performed %}
    <h2>{{ 'search.results_for_html' | t: terms: search.terms, count: search.results_count }}</h2>
    {% paginate search.results by section.settings.results_per_page %}
      <div class="search-results">
        {% for result in search.results %}
          <article class="search-result">
            <a href="{{ result.url }}">{% if result.image %}{{ result.image | image_url: width: 480 | image_tag: alt: result.image.alt, loading: 'lazy' }}{% endif %}<h3>{{ result.title | escape }}</h3></a>
            {% if result.price %}<p>{{ result.price | money }}</p>{% endif %}
          </article>
        {% else %}
          <p>{{ section.settings.no_results | escape }}</p>
        {% endfor %}
      </div>
      {{ paginate | default_pagination }}
    {% endpaginate %}
  {% endif %}
</main>
{% stylesheet %}
  .search-page{max-width:var(--page-width);margin:3rem auto;padding:0 var(--page-margin)}.search-form{display:flex;gap:.5rem;max-width:48rem}.search-form input{flex:1;min-width:0;padding:.75rem}.predictive-search{position:relative;display:block}.search-predictive{position:absolute;z-index:3;top:calc(100% + .5rem);left:0;width:min(100%,48rem);max-height:min(60vh,32rem);overflow:auto;padding:1rem;border:var(--border-width) solid var(--border-color);background:var(--color-background);box-shadow:var(--overlay-shadow)}.search-predictive section+section{margin-top:1rem}.search-predictive h3{margin:0 0 .5rem;font-size:var(--font-body-sm)}.search-predictive ul{display:grid;gap:.35rem;margin:0;padding:0;list-style:none}.search-predictive a{display:block;padding:.45rem;color:inherit;text-decoration:none}.search-predictive a:focus,.search-predictive a:hover{background:var(--color-secondary-button)}.search-results{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1.5rem}.search-results img{width:100%;height:auto}.search-results h3{font-size:1rem}.search-results a{color:inherit;text-decoration:none}
  @media(max-width:749px){.search-page{padding:0 var(--page-margin-mobile)}.search-results{grid-template-columns:repeat(2,minmax(0,1fr))}}
{% endstylesheet %}
{% schema %}
{"name":"Search","settings":[{"type":"text","id":"heading","label":"Heading","default":"Search"},{"type":"text","id":"placeholder","label":"Placeholder","default":"Search products"},{"type":"text","id":"submit_label","label":"Submit label","default":"Search"},{"type":"textarea","id":"no_results","label":"No results message","default":"No results found."},{"type":"range","id":"results_per_page","label":"Results per page","min":4,"max":48,"step":4,"default":20},{"type":"checkbox","id":"predictive_enabled","label":"Enable predictive search","default":true},{"type":"range","id":"min_chars","label":"Minimum characters","min":1,"max":4,"step":1,"default":2},{"type":"range","id":"predictive_limit","label":"Predictive result limit","min":4,"max":10,"step":1,"default":6},{"type":"range","id":"debounce","label":"Predictive search delay","min":100,"max":600,"step":50,"unit":"ms","default":250},{"type":"text","id":"products_label","label":"Products label","default":"Products"},{"type":"text","id":"collections_label","label":"Collections label","default":"Collections"},{"type":"text","id":"pages_label","label":"Pages label","default":"Pages"},{"type":"text","id":"articles_label","label":"Articles label","default":"Articles"}]}
{% endschema %}
