<footer class="site-footer" data-section-id="{{ section.id }}">
  <div class="site-footer__grid">
    {% if section.settings.menu != blank %}<div class="site-footer__column"><h2>{{ section.settings.menu_heading | escape }}</h2>{% render 'global-navigation', menu: section.settings.menu, label: section.settings.menu_heading, presentation: 'footer', max_depth: 1 %}</div>{% endif %}
    {% if section.settings.show_social %}<div class="site-footer__column"><h2>{{ section.settings.social_heading | escape }}</h2>{% render 'social-links' %}</div>{% endif %}
    {% if section.settings.show_newsletter %}<div class="site-footer__column"><h2>{{ section.settings.newsletter_heading | escape }}</h2><p>{{ section.settings.newsletter_text | escape }}</p>{% form 'customer', id: 'FooterNewsletter', class: 'site-footer__form' %}<input type="hidden" name="contact[tags]" value="newsletter"><label class="visually-hidden" for="FooterEmail-{{ section.id }}">Email address</label><input id="FooterEmail-{{ section.id }}" type="email" name="contact[email]" value="{{ form.email }}" autocomplete="email" required placeholder="Email address"> <button type="submit" class="button">Subscribe</button>{% if form.posted_successfully? %}<p role="status">Thanks for subscribing.</p>{% elsif form.errors %}<p role="alert">{{ form.errors | default_errors }}</p>{% endif %}{% endform %}</div>{% endif %}
  </div>
  <div class="site-footer__bottom"><span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }}</span><span>{{ powered_by_link }}</span>{% if section.settings.show_payment_icons %}<span class="site-footer__payment">{% for type in shop.enabled_payment_types %}{{ type | payment_type_svg_tag }}{% endfor %}</span>{% endif %}</div>
</footer>
{% stylesheet %}
  .site-footer { margin-top: 4rem; padding: 3rem var(--page-margin) 1.5rem; color: var(--color-foreground); background: var(--color-background); border-top: var(--border-width) solid var(--border-color); }
  .site-footer__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; }
  .site-footer h2 { margin: 0 0 1rem; font: inherit; font-family: var(--font-heading-family); }
  .site-footer a { color: inherit; text-decoration: none; }
  .site-footer .global-navigation ul, .site-footer .social-links { display: grid; gap: .5rem; margin: 0; padding: 0; list-style: none; }
  .site-footer__form { display: flex; flex-wrap: wrap; gap: .5rem; }
  .site-footer__form input { min-width: 12rem; max-width: 100%; }
  .site-footer__bottom { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; margin-top: 3rem; padding-top: 1rem; border-top: var(--border-width) solid var(--border-color); }
  .site-footer__payment { display: flex; flex-wrap: wrap; gap: .5rem; margin-left: auto; }
  .site-footer__payment svg { width: 2.5rem; height: auto; }
  @media (max-width: 749px) { .site-footer { padding: 2rem var(--page-margin-mobile) 1rem; } .site-footer__grid { grid-template-columns: 1fr; gap: 1.5rem; } .site-footer__bottom { margin-top: 2rem; } .site-footer__payment { margin-left: 0; } }
{% endstylesheet %}
{% schema %}
{ "name": "Footer", "settings": [
  { "type": "link_list", "id": "menu", "label": "Footer menu" },
  { "type": "text", "id": "menu_heading", "label": "Menu heading", "default": "Explore" },
  { "type": "checkbox", "id": "show_social", "label": "Show social links", "default": true },
  { "type": "text", "id": "social_heading", "label": "Social heading", "default": "Follow us" },
  { "type": "checkbox", "id": "show_newsletter", "label": "Show newsletter", "default": true },
  { "type": "text", "id": "newsletter_heading", "label": "Newsletter heading", "default": "Stay in the loop" },
  { "type": "textarea", "id": "newsletter_text", "label": "Newsletter text", "default": "Get the latest updates and offers." },
  { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true }
] }
{% endschema %}
