<footer class="site-footer" data-section-id="{{ section.id }}" style="--footer-columns:{{ section.settings.columns_desktop }};--footer-gap:{{ section.settings.column_gap }}px;--footer-padding-top:{{ section.settings.padding_top }}px;--footer-padding-bottom:{{ section.settings.padding_bottom }}px">
  <div class="site-footer__grid">
    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'menu' %}{% if block.settings.menu != blank %}<div class="site-footer__column" {{ block.shopify_attributes }}><h2>{{ block.settings.heading | escape }}</h2>{% render 'global-navigation', menu: block.settings.menu, label: block.settings.heading, presentation: 'footer', max_depth: 1, id_prefix: block.id %}</div>{% endif %}
        {% when 'text' %}<div class="site-footer__column" {{ block.shopify_attributes }}><h2>{{ block.settings.heading | escape }}</h2><div class="site-footer__richtext">{{ block.settings.text }}</div></div>
        {% when 'social' %}<div class="site-footer__column" {{ block.shopify_attributes }}><h2>{{ block.settings.heading | escape }}</h2>{% render 'social-links' %}</div>
        {% when 'newsletter' %}<div class="site-footer__column site-footer__newsletter" {{ block.shopify_attributes }}><h2>{{ block.settings.heading | escape }}</h2><p>{{ block.settings.text | escape }}</p>{% form 'customer', id: 'FooterNewsletter', class: 'site-footer__form' %}<input type="hidden" name="contact[tags]" value="newsletter"><label class="visually-hidden" for="FooterEmail-{{ block.id }}">{{ block.settings.email_label | escape }}</label><input id="FooterEmail-{{ block.id }}" type="email" name="contact[email]" value="{{ form.email }}" autocomplete="email" required placeholder="{{ block.settings.email_label | escape }}"><button type="submit" class="button">{{ block.settings.button_label | escape }}</button>{% if form.posted_successfully? %}<p class="site-footer__form-status" role="status">{{ block.settings.success_message | escape }}</p>{% elsif form.errors %}<div class="site-footer__form-status" role="alert">{{ form.errors | default_errors }}</div>{% endif %}{% endform %}</div>
      {% endcase %}
    {% endfor %}
  </div>
  <div class="site-footer__bottom"><span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }}</span>{% if section.settings.show_policies %}<nav class="site-footer__policies" aria-label="{{ section.settings.policies_label | escape }}">{% for policy in shop.policies %}{% if policy != blank %}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{% endif %}{% endfor %}</nav>{% endif %}{% if section.settings.show_payment_icons and shop.enabled_payment_types != empty %}<div class="site-footer__payment" aria-label="{{ section.settings.payment_label | escape }}">{% for type in shop.enabled_payment_types %}{{ type | payment_type_svg_tag }}{% endfor %}</div>{% endif %}</div>
</footer>
{% stylesheet %}
  .site-footer{margin-top:4rem;padding:var(--footer-padding-top) var(--page-margin) var(--footer-padding-bottom);color:var(--color-foreground);background:var(--color-background);border-top:var(--border-width) solid var(--border-color)}.site-footer__grid{display:grid;grid-template-columns:repeat(var(--footer-columns),minmax(0,1fr));gap:var(--footer-gap);max-width:var(--page-width);margin-inline:auto}.site-footer h2{margin:0 0 1rem;font:inherit;font-family:var(--font-heading-family)}.site-footer a{color:inherit}.site-footer .global-navigation__list,.site-footer .social-links{display:grid;gap:.5rem;margin:0;padding:0;list-style:none}.site-footer .global-navigation a{text-decoration:none}.site-footer__richtext{display:grid;gap:.75rem}.site-footer__form{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:.5rem}.site-footer__form input{min-width:0;padding:.75rem}.site-footer__form-status{grid-column:1/-1}.site-footer__bottom{display:flex;flex-wrap:wrap;align-items:center;gap:1rem;max-width:var(--page-width);margin:3rem auto 0;padding-top:1rem;border-top:var(--border-width) solid var(--border-color)}.site-footer__policies{display:flex;flex-wrap:wrap;gap:.75rem}.site-footer__payment{display:flex;flex-wrap:wrap;gap:.5rem;margin-left:auto}.site-footer__payment svg{width:2.5rem;height:auto}@media(max-width:749px){.site-footer{padding-right:var(--page-margin-mobile);padding-left:var(--page-margin-mobile)}.site-footer__grid{grid-template-columns:1fr;gap:2rem}.site-footer__bottom{margin-top:2rem}.site-footer__payment{margin-left:0}.site-footer__form{grid-template-columns:1fr}.site-footer__form .button{width:100%}}
{% endstylesheet %}
{% schema %}
{"name":"Footer","max_blocks":8,"blocks":[{"type":"menu","name":"Menu column","limit":4,"settings":[{"type":"text","id":"heading","label":"Heading","default":"Explore"},{"type":"link_list","id":"menu","label":"Menu"}]},{"type":"text","name":"Text column","limit":2,"settings":[{"type":"text","id":"heading","label":"Heading","default":"About"},{"type":"richtext","id":"text","label":"Text","default":"<p>Share store details, values, or contact information.</p>"}]},{"type":"social","name":"Social links","limit":1,"settings":[{"type":"text","id":"heading","label":"Heading","default":"Follow us"}]},{"type":"newsletter","name":"Newsletter","limit":1,"settings":[{"type":"text","id":"heading","label":"Heading","default":"Stay in the loop"},{"type":"textarea","id":"text","label":"Text","default":"Get the latest updates and offers."},{"type":"text","id":"email_label","label":"Email label","default":"Email address"},{"type":"text","id":"button_label","label":"Button label","default":"Subscribe"},{"type":"text","id":"success_message","label":"Success message","default":"Thanks for subscribing."}]}],"settings":[{"type":"range","id":"columns_desktop","label":"Desktop columns","min":2,"max":4,"step":1,"default":3},{"type":"range","id":"column_gap","label":"Column gap","min":16,"max":64,"step":4,"unit":"px","default":32},{"type":"range","id":"padding_top","label":"Padding top","min":24,"max":96,"step":4,"unit":"px","default":48},{"type":"range","id":"padding_bottom","label":"Padding bottom","min":16,"max":64,"step":4,"unit":"px","default":24},{"type":"checkbox","id":"show_policies","label":"Show policy links","default":true},{"type":"text","id":"policies_label","label":"Policies label","default":"Store policies"},{"type":"checkbox","id":"show_payment_icons","label":"Show payment icons","default":true},{"type":"text","id":"payment_label","label":"Payment methods label","default":"Accepted payment methods"}]}
{% endschema %}
