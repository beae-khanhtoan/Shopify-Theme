<div class="custom-section full-width" {{ section.shopify_attributes }}>
  {% if section.settings.background_image %}
    <div class="custom-section__background">
      {{ section.settings.background_image | image_url: width: 2000 | image_tag }}
    </div>
  {% endif %}

  <div class="custom-section__content">
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .custom-section {
    position: relative;
    overflow: hidden;
    width: 100%;
  }
  .custom-section__background {
    position: absolute;
    width: 100%;
    height: 100%;
    z-index: -1;
    overflow: hidden;
  }
  .custom-section__background img {
    position: absolute;
    width: 100%;
    height: auto;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }
  .custom-section__content {
    display: grid;
    grid-template-columns: var(--content-grid);
  }
  .custom-section__content > * {
    grid-column: 2;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.custom_section",
  "blocks": [
    { "type": "heading" }, { "type": "text" }, { "type": "eyebrow" }, { "type": "button" },
    { "type": "image" }, { "type": "video" }, { "type": "icon" }, { "type": "header" },
    { "type": "group" }, { "type": "stack" }, { "type": "grid" }, { "type": "columns" },
    { "type": "spacer" }, { "type": "divider" }, { "type": "product-card" },
    { "type": "product-price" }, { "type": "product-media-gallery" }, { "type": "product-title" },
    { "type": "product-description" }, { "type": "product-inventory" }, { "type": "buy-buttons" },
    { "type": "pickup-availability" }, { "type": "product-badges" }, { "type": "variant-picker" },
    { "type": "link-list" }, { "type": "link-item" }, { "type": "breadcrumbs" },
    { "type": "pagination" }, { "type": "search" }, { "type": "social-links" }, { "type": "share" },
    { "type": "content-group" }, { "type": "media-with-text" }, { "type": "split-content" },
    { "type": "card" }, { "type": "feature-list" }, { "type": "feature-item" },
    { "type": "testimonial" }, { "type": "callout" }, { "type": "newsletter" },
    { "type": "accordion" }, { "type": "faq-item" }, { "type": "collection-card" },
    { "type": "product-info" }, { "type": "product-form" }, { "type": "cart-item" },
    { "type": "filter-group" }, { "type": "buttons" }, { "type": "group-layout" }
  ],
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:labels.background"
    }
  ],
  "presets": [
    {
      "name": "t:general.custom_section"
    }
  ]
}
{% endschema %}
