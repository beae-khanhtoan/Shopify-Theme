{% unless template.name == 'search' %}
  <search-drawer class="search-drawer-host" data-section-id="{{ section.id }}">
    <dialog class="search-drawer" id="SearchDrawer-{{ section.id }}" data-search-dialog scroll-lock aria-labelledby="SearchDrawerTitle-{{ section.id }}">
      <div class="search-drawer__panel">
        <header class="search-drawer__header"><h2 id="SearchDrawerTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2><button class="search-drawer__close" type="button" aria-label="{{ section.settings.close_label | escape }}" data-search-close>×</button></header>
        {% render 'predictive-search-form', id: section.id, value: '', placeholder: section.settings.placeholder, submit_label: section.settings.submit_label, predictive_enabled: true, min_chars: section.settings.min_chars, predictive_limit: section.settings.predictive_limit, debounce: section.settings.debounce, products_label: section.settings.products_label, collections_label: section.settings.collections_label, pages_label: section.settings.pages_label, articles_label: section.settings.articles_label %}
      </div>
    </dialog>
  </search-drawer>
{% endunless %}
{% stylesheet %}
  .search-drawer-host{display:contents}.search-drawer{width:min(100% - 2rem,42rem);height:100dvh;max-height:none;margin:0 0 0 auto;padding:0;border:0;border-left:var(--overlay-border-width) solid var(--border-color);border-radius:var(--overlay-radius) 0 0 var(--overlay-radius);color:var(--overlay-foreground);background:var(--overlay-background);box-shadow:var(--overlay-shadow)}.search-drawer[open]{display:block}.search-drawer::backdrop{background:rgb(0 0 0 / var(--overlay-opacity));backdrop-filter:var(--overlay-backdrop-blur)}.search-drawer__panel{min-height:100%;padding:var(--drawer-padding-desktop)}.search-drawer__header{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-bottom:1.5rem;padding-bottom:1rem;border-bottom:var(--border-width) solid var(--border-color)}.search-drawer__header h2{margin:0;font-size:var(--overlay-title-size)}.search-drawer__close{display:inline-grid;width:2.75rem;height:2.75rem;place-items:center;padding:0;border:0;background:transparent;color:inherit;font-size:1.5rem}.search-drawer .search-form{display:grid;grid-template-columns:minmax(0,1fr) auto}.search-drawer .search-form input{min-width:0;padding:.75rem}.search-drawer .search-predictive{position:static;width:100%;max-height:calc(100dvh - 12rem);margin-top:.5rem;box-shadow:none}
  @media(max-width:749px){.search-drawer{width:100%;border-radius:0}.search-drawer__panel{padding:var(--drawer-padding-mobile)}}
  @media(prefers-reduced-motion:no-preference){.search-drawer{translate:100% 0;transition:translate var(--motion-duration) var(--motion-ease)}.search-drawer[open]{translate:0 0}}
{% endstylesheet %}
{% schema %}
{"name":"Search drawer","settings":[{"type":"text","id":"heading","label":"Heading","default":"Search"},{"type":"text","id":"close_label","label":"Close label","default":"Close search"},{"type":"text","id":"placeholder","label":"Placeholder","default":"Search products"},{"type":"text","id":"submit_label","label":"Submit label","default":"Search"},{"type":"range","id":"min_chars","label":"Minimum characters","min":1,"max":4,"step":1,"default":2},{"type":"range","id":"predictive_limit","label":"Predictive result limit","min":4,"max":10,"step":1,"default":6},{"type":"range","id":"debounce","label":"Predictive search delay","min":100,"max":600,"step":50,"unit":"ms","default":250},{"type":"text","id":"products_label","label":"Products label","default":"Products"},{"type":"text","id":"collections_label","label":"Collections label","default":"Collections"},{"type":"text","id":"pages_label","label":"Pages label","default":"Pages"},{"type":"text","id":"articles_label","label":"Articles label","default":"Articles"}]}
{% endschema %}
