{% style %}
  {% # Loads all font variantions with display: swap %}
  {{ settings.type_primary_font | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {{ settings.type_heading_font | font_face: font_display: 'swap' }}
  {{ settings.type_heading_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ settings.type_accent_font | font_face: font_display: 'swap' }}

  {% assign color_scheme = settings.color_schemes.first %}

  :root {
    --font-primary--family: {{ settings.type_primary_font.family }}, {{ settings.type_primary_font.fallback_families }};
    --font-primary--style: {{ settings.type_primary_font.style }};
    --font-primary--weight: {{ settings.type_primary_font.weight }};
    --font-heading--family: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
    --font-accent--family: {{ settings.type_accent_font.family }}, {{ settings.type_accent_font.fallback_families }};
    --font-body-size: {{ settings.body_font_size }}px;
    --font-body-family: var(--font-primary--family);
    --font-heading-family: var(--font-heading--family);
    --font-accent-family: var(--font-accent--family);
    --font-card-title-family: {% if settings.card_title_font_role == 'body' %}var(--font-body-family){% elsif settings.card_title_font_role == 'accent' %}var(--font-accent-family){% else %}var(--font-heading-family){% endif %};
    --font-card-price-family: {% if settings.card_price_font_role == 'heading' %}var(--font-heading-family){% elsif settings.card_price_font_role == 'accent' %}var(--font-accent-family){% else %}var(--font-body-family){% endif %};
    --font-body-line-height: {% case settings.body_line_height %}{% when 'loose' %}1.8{% when 'normal' %}1.5{% else %}1.65{% endcase %};
    --font-body-letter-spacing: {% case settings.body_letter_spacing %}{% when 'tight' %}-0.01em{% when 'relaxed' %}0.02em{% else %}0{% endcase %};
    --body-case: {{ settings.body_text_case }};
    --font-heading-line-height: {% case settings.heading_line_height %}{% when 'relaxed' %}1.3{% when 'normal' %}1.2{% else %}1.05{% endcase %};
    --font-heading-letter-spacing: {% case settings.heading_letter_spacing %}{% when 'tight' %}-0.02em{% when 'relaxed' %}0.02em{% else %}0{% endcase %};
    --heading-case: {{ settings.heading_case }};
    --accent-text-case: {{ settings.accent_text_case }};
    --font-heading-display: {{ settings.heading_display_size }}px;
    --font-heading-display-mobile: {{ settings.heading_display_size_mobile }}px;
    --font-heading-xl: calc(var(--font-heading-display) * 0.75);
    --font-heading-xl-mobile: calc(var(--font-heading-display-mobile) * 0.818);
    --font-heading-lg: calc(var(--font-heading-display) * 0.625);
    --font-heading-lg-mobile: calc(var(--font-heading-display-mobile) * 0.727);
    --font-heading-md: calc(var(--font-heading-display) * 0.5);
    --font-heading-md-mobile: calc(var(--font-heading-display-mobile) * 0.636);
    --font-heading-sm: calc(var(--font-heading-display) * 0.406);
    --font-heading-sm-mobile: calc(var(--font-heading-display-mobile) * 0.5);
    --font-heading-xs: calc(var(--font-heading-display) * 0.3125);
    --font-heading-xs-mobile: calc(var(--font-heading-display-mobile) * 0.409);
    --font-body-xs: calc(var(--font-body-size) * 0.714);
    --font-body-sm: calc(var(--font-body-size) * 0.857);
    --font-body-md: var(--font-body-size);
    --font-body-lg: calc(var(--font-body-size) * 1.143);
    --font-body-xl: calc(var(--font-body-size) * 1.286);
    --font-body-xxl: calc(var(--font-body-size) * 1.429);
    --font-body-default-size: {% case settings.body_text_size %}{% when 'xs' %}var(--font-body-xs){% when 'sm' %}var(--font-body-sm){% when 'lg' %}var(--font-body-lg){% when 'xl' %}var(--font-body-xl){% when 'xxl' %}var(--font-body-xxl){% else %}var(--font-body-md){% endcase %};
    --font-eyebrow-size: {{ settings.eyebrow_font_size }}px;
    --font-eyebrow-line-height: {% case settings.eyebrow_line_height %}{% when 'relaxed' %}1.3{% when 'normal' %}1.2{% else %}1.05{% endcase %};
    --font-eyebrow-letter-spacing: {% case settings.eyebrow_letter_spacing %}{% when 'extra-loose' %}0.12em{% when 'loose' %}0.08em{% when 'relaxed' %}0.04em{% else %}0{% endcase %};
    --font-eyebrow-text-transform: {% if settings.eyebrow_text_case == 'uppercase' %}uppercase{% else %}none{% endif %};
    --font-button-size: {{ settings.button_font_size }}px;
    --font-button-line-height: {% if settings.button_line_height == 'tight' %}1.05{% else %}1.2{% endif %};
    --font-button-letter-spacing: {% case settings.button_letter_spacing %}{% when 'loose' %}0.08em{% when 'relaxed' %}0.04em{% else %}0{% endcase %};
    --font-button-text-transform: {% if settings.button_text_case == 'uppercase' %}uppercase{% else %}none{% endif %};
    --font-badge-size: {{ settings.badge_font_size }}px;
    --font-badge-line-height: {% if settings.badge_line_height == 'tight' %}1.05{% else %}1.2{% endif %};
    --font-badge-letter-spacing: {% case settings.badge_letter_spacing %}{% when 'loose' %}0.08em{% when 'relaxed' %}0.04em{% else %}0{% endcase %};
    --font-badge-text-transform: {% if settings.badge_text_case == 'uppercase' %}uppercase{% else %}none{% endif %};
    --font-card-title-size: {{ settings.card_title_font_size }}px;
    --font-card-title-line-height: {% case settings.card_title_line_height %}{% when 'tight' %}1.05{% when 'relaxed' %}1.3{% when 'loose' %}1.8{% else %}1.2{% endcase %};
    --font-card-title-letter-spacing: {% case settings.card_title_letter_spacing %}{% when 'tight' %}-0.02em{% when 'relaxed' %}0.02em{% when 'loose' %}0.08em{% else %}0{% endcase %};
    --font-card-title-text-transform: {% case settings.card_title_text_case %}{% when 'uppercase' %}uppercase{% when 'capitalize' %}capitalize{% else %}none{% endcase %};
    --font-card-price-size: {{ settings.card_price_font_size }}px;
    --font-card-price-line-height: {% case settings.card_price_line_height %}{% when 'tight' %}1.05{% when 'relaxed' %}1.3{% else %}1.2{% endcase %};
    --font-card-price-letter-spacing: {% case settings.card_price_letter_spacing %}{% when 'tight' %}-0.02em{% when 'relaxed' %}0.02em{% else %}0{% endcase %};
    --page-width: {{ settings.page_width }};
    --page-margin: {{ settings.page_margin }}px;
    --section-spacing: {{ settings.section_spacing }}px;
    --content-gap: {{ settings.content_gap }}px;
    --content-gap-mobile: {{ settings.content_gap_mobile }}px;
    --radius-0: 0px;
    --radius-xs: {{ settings.radius_xs }}px;
    --radius-sm: {{ settings.radius_sm }}px;
    --radius-md: {{ settings.radius_md }}px;
    --radius-lg: {{ settings.radius_lg }}px;
    --radius-pill: 999px;
    --style-border-radius-small: var(--radius-sm);
    --style-border-radius-medium: var(--radius-md);
    --style-border-radius-large: var(--radius-lg);
    --style-border-radius-inputs: var(--radius-sm);
    --border-width: {{ settings.border_width }}px;
    --button-height: {{ settings.button_height }}px;
    --button-height-mobile: {{ settings.button_height_mobile }}px;
    --button-padding-inline: {{ settings.button_padding_inline }}px;
    --button-border-width: {{ settings.button_border_width }}px;
    --button-icon-size: {{ settings.button_icon_size }}px;
    --swatch-size: {{ settings.swatch_size }}px;
    --swatch-size-mobile: {{ settings.swatch_size_mobile }}px;
    --input-height: {{ settings.input_height }}px;
    --input-height-mobile: {{ settings.input_height_mobile }}px;
    --input-border-width: {{ settings.input_border_width }}px;
    --variant-height: {{ settings.variant_height }}px;
    --variant-height-mobile: {{ settings.variant_height_mobile }}px;
    --variant-group-gap: {{ settings.variant_group_gap }}px;
    --overlay-opacity: {{ settings.overlay_opacity | divided_by: 100.0 }};
    --overlay-padding: {{ settings.overlay_padding }}px;
    --overlay-radius: {% case settings.overlay_radius %}{% when 'sm' %}var(--radius-sm){% when 'md' %}var(--radius-md){% else %}var(--radius-lg){% endcase %};
    --overlay-backdrop-blur: {% case settings.overlay_blur %}{% when 'strong' %}blur(12px){% when 'light' %}blur(4px){% else %}none{% endcase %};
    --icon-stroke-width: {{ settings.icon_stroke_width }};
    --motion-duration: {% if settings.enable_motion and settings.motion_mode != 'none' %}{% case settings.motion_duration_scale %}{% when 'instant' %}0ms{% when 'fast' %}120ms{% when 'slow' %}320ms{% else %}180ms{% endcase %}{% else %}0ms{% endif %};
    --motion-ease: {% if settings.motion_easing == 'emphasized' %}cubic-bezier(0.2, 0.8, 0.2, 1){% else %}cubic-bezier(0.2, 0, 0, 1){% endif %};
    --input-background: {% if settings.input_style == 'filled' %}color-mix(in srgb, var(--color-foreground) 5%, var(--color-background)){% else %}transparent{% endif %};
    --input-shadow: {% if settings.input_shadows %}0 1px 4px color-mix(in srgb, var(--color-shadow) 12%, transparent){% else %}none{% endif %};

    {% if color_scheme %}
      --color-background: {{ color_scheme.settings.background }};
      --color-background-gradient: {{ color_scheme.settings.background_gradient }};
      --color-foreground: {{ color_scheme.settings.text }};
      --background-color: {{ color_scheme.settings.background }};
      --heading-color: {{ color_scheme.settings.heading }};
      --heading-highlight-color: {{ color_scheme.settings.heading_highlight }};
      --body-color: {{ color_scheme.settings.text }};
      --accent-color: {{ color_scheme.settings.accent }};
      --border-color: {{ color_scheme.settings.border }};
      --shadow-color: {{ color_scheme.settings.shadow }};
      --sale-price-color: {{ color_scheme.settings.sale_price }};
      --color-button: {{ color_scheme.settings.button }};
      --color-button-label: {{ color_scheme.settings.button_label }};
      --color-button-hover: {{ color_scheme.settings.button_hover }};
      --color-secondary-button: {{ color_scheme.settings.secondary_button }};
      --color-secondary-button-label: {{ color_scheme.settings.secondary_button_label }};
      --color-secondary-button-hover: {{ color_scheme.settings.secondary_button_hover }};
      --color-tertiary-button-label: {{ color_scheme.settings.tertiary_button_label }};
      --color-tertiary-button-border: {{ color_scheme.settings.tertiary_button_border }};
      --color-tertiary-button-hover: {{ color_scheme.settings.tertiary_button_hover }};
      --color-success: {{ color_scheme.settings.success }};
      --color-warning: {{ color_scheme.settings.warning }};
      --color-error: {{ color_scheme.settings.error }};
      --color-sold-out: {{ color_scheme.settings.sold_out }};
      --color-shadow: {{ color_scheme.settings.shadow }};
    {% else %}
      --color-background: #ffffff;
      --color-foreground: #171717;
      --background-color: #ffffff;
      --heading-color: #171717;
      --heading-highlight-color: #171717;
      --body-color: #171717;
      --accent-color: #555555;
      --border-color: #d6d6d6;
      --shadow-color: #171717;
      --sale-price-color: #b42318;
      --color-button: #171717;
      --color-button-label: #ffffff;
      --color-button-hover: #333333;
      --color-secondary-button: #f4f4f4;
      --color-secondary-button-label: #171717;
      --color-secondary-button-hover: #e7e7e7;
      --color-tertiary-button-label: #171717;
      --color-tertiary-button-border: #171717;
      --color-tertiary-button-hover: #f4f4f4;
      --color-success: #067647;
      --color-warning: #b54708;
      --color-error: #b42318;
      --color-sold-out: #667085;
      --color-shadow: #171717;
    {% endif %}
  }
{% endstyle %}
