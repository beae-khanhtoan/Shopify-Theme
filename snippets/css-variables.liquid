{% style %}
  {% # Loads all font variantions with display: swap %}
  {{ settings.type_primary_font | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {{ settings.type_heading_font | font_face: font_display: 'swap' }}
  {{ settings.type_heading_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ settings.type_accent_font | font_face: font_display: 'swap' }}

  {% assign color_scheme = settings.color_schemes.first %}
  {% assign overlay_scheme = settings.color_schemes[settings.overlay_color_scheme] %}

  :root {
    --font-primary--family: {{ settings.type_primary_font.family }}, {{ settings.type_primary_font.fallback_families }};
    --font-primary--style: {{ settings.type_primary_font.style }};
    --font-primary--weight: {{ settings.type_primary_font.weight }};
    --font-heading--family: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
    --font-accent--family: {{ settings.type_accent_font.family }}, {{ settings.type_accent_font.fallback_families }};
    --font-body-size: {{ settings.body_font_size }}px;
    --font-body-family: var(--font-primary--family);
    --font-heading-family: var(--font-heading--family);
    --font-accent-family: var(--font-accent--family);
    --font-body-line-height: {% case settings.body_line_height %}{% when 'loose' %}1.8{% when 'normal' %}1.5{% else %}1.65{% endcase %};
    --font-body-letter-spacing: 0;
    --body-case: none;
    --font-heading-line-height: var(--font-heading-display-line-height);
    --heading-case: var(--font-heading-display-case);
    --font-heading-letter-spacing: {% case settings.heading_letter_spacing %}{% when 'tight' %}-0.02em{% when 'relaxed' %}0.02em{% else %}0{% endcase %};
    --font-heading-display: {{ settings.heading_display_size }}px;
    --font-heading-display-mobile: {{ settings.heading_display_size_mobile }}px;
    --font-heading-display-line-height: {% case settings.heading_display_line_height %}{% when 'relaxed' %}1.3{% when 'normal' %}1.2{% else %}1.05{% endcase %};
    --font-heading-display-case: {{ settings.heading_display_case }};
    --font-heading-xl: {{ settings.heading_xl_size }}px;
    --font-heading-xl-mobile: {{ settings.heading_xl_size_mobile }}px;
    --font-heading-xl-line-height: {% case settings.heading_xl_line_height %}{% when 'relaxed' %}1.3{% when 'normal' %}1.2{% else %}1.05{% endcase %};
    --font-heading-xl-case: {{ settings.heading_xl_case }};
    --font-heading-lg: {{ settings.heading_lg_size }}px;
    --font-heading-lg-mobile: {{ settings.heading_lg_size_mobile }}px;
    --font-heading-lg-line-height: {% case settings.heading_lg_line_height %}{% when 'relaxed' %}1.3{% when 'normal' %}1.2{% else %}1.05{% endcase %};
    --font-heading-lg-case: {{ settings.heading_lg_case }};
    --font-heading-md: {{ settings.heading_md_size }}px;
    --font-heading-md-mobile: {{ settings.heading_md_size_mobile }}px;
    --font-heading-md-line-height: {% case settings.heading_md_line_height %}{% when 'relaxed' %}1.3{% when 'normal' %}1.2{% else %}1.05{% endcase %};
    --font-heading-md-case: {{ settings.heading_md_case }};
    --font-heading-sm: {{ settings.heading_sm_size }}px;
    --font-heading-sm-mobile: {{ settings.heading_sm_size_mobile }}px;
    --font-heading-sm-line-height: {% case settings.heading_sm_line_height %}{% when 'relaxed' %}1.3{% when 'normal' %}1.2{% else %}1.05{% endcase %};
    --font-heading-sm-case: {{ settings.heading_sm_case }};
    --font-heading-xs: {{ settings.heading_xs_size }}px;
    --font-heading-xs-mobile: {{ settings.heading_xs_size_mobile }}px;
    --font-heading-xs-line-height: {% case settings.heading_xs_line_height %}{% when 'relaxed' %}1.3{% when 'normal' %}1.2{% else %}1.05{% endcase %};
    --font-heading-xs-case: {{ settings.heading_xs_case }};
    --font-body-xs: calc(var(--font-body-size) * 0.714);
    --font-body-sm: calc(var(--font-body-size) * 0.857);
    --font-body-md: var(--font-body-size);
    --font-body-lg: calc(var(--font-body-size) * 1.143);
    --font-body-xl: calc(var(--font-body-size) * 1.286);
    --font-body-xxl: calc(var(--font-body-size) * 1.429);
    --font-body-default-size: var(--font-body-md);
    --font-eyebrow-size: {{ settings.eyebrow_font_size }}px;
    --font-eyebrow-line-height: {% case settings.eyebrow_line_height %}{% when 'relaxed' %}1.3{% when 'normal' %}1.2{% else %}1.05{% endcase %};
    --font-eyebrow-letter-spacing: {% case settings.eyebrow_letter_spacing %}{% when 'extra-loose' %}0.12em{% when 'loose' %}0.08em{% when 'relaxed' %}0.04em{% else %}0{% endcase %};
    --font-eyebrow-text-transform: {% if settings.eyebrow_text_case == 'uppercase' %}uppercase{% else %}none{% endif %};
    --accent-text-case: var(--font-eyebrow-text-transform);
    --font-button-size: var(--font-body-size);
    --font-button-line-height: var(--font-body-line-height);
    --font-button-letter-spacing: 0;
    --font-button-text-transform: none;
    --font-badge-size: var(--font-body-xs);
    --font-badge-line-height: 1.2;
    --font-badge-letter-spacing: 0;
    --font-badge-text-transform: var(--font-eyebrow-text-transform);
    --font-card-title-family: var(--font-heading-family);
    --font-card-title-size: var(--font-body-md);
    --font-card-title-line-height: 1.2;
    --font-card-title-letter-spacing: 0;
    --font-card-title-text-transform: none;
    --font-card-price-family: var(--font-body-family);
    --font-card-price-size: var(--font-body-md);
    --font-card-price-line-height: 1.2;
    --font-card-price-letter-spacing: 0;
    --page-width: {{ settings.page_width }}px;
    --page-margin-min: {{ settings.page_margin_min }}px;
    --page-margin-desktop: {{ settings.page_margin_desktop }}px;
    --page-margin-tablet: {{ settings.page_margin_tablet }}px;
    --page-margin-mobile: {{ settings.page_margin_mobile }}px;
    --page-margin: max(var(--page-margin-min), var(--page-margin-desktop));
    --section-spacing: 64px;
    --content-gap: 24px;
    --content-gap-mobile: 16px;
    --radius-square: 0px;
    --radius-slight: 4px;
    --radius-rounded: 8px;
    --radius-extra: 16px;
    --radius-pill: 999px;
    --radius-buttons-inputs: {% case settings.radius_buttons_inputs %}{% when 'slightly_rounded' %}var(--radius-slight){% when 'rounded' %}var(--radius-rounded){% when 'pill' %}var(--radius-pill){% else %}var(--radius-square){% endcase %};
    --radius-badges-subheadings: {% case settings.radius_badges_subheadings %}{% when 'slightly_rounded' %}var(--radius-slight){% when 'rounded' %}var(--radius-rounded){% when 'pill' %}var(--radius-pill){% else %}var(--radius-square){% endcase %};
    --radius-variant-pickers: {% case settings.radius_variant_pickers %}{% when 'slightly_rounded' %}var(--radius-slight){% when 'rounded' %}var(--radius-rounded){% when 'pill' %}var(--radius-pill){% else %}var(--radius-square){% endcase %};
    --radius-swatches: {% case settings.radius_swatches %}{% when 'slightly_rounded' %}var(--radius-slight){% when 'rounded' %}var(--radius-rounded){% when 'pill' %}var(--radius-pill){% else %}var(--radius-square){% endcase %};
    --radius-navigation: {% case settings.radius_navigation %}{% when 'slightly_rounded' %}var(--radius-slight){% when 'rounded' %}var(--radius-rounded){% when 'pill' %}var(--radius-pill){% else %}var(--radius-square){% endcase %};
    --radius-media-containers: {% case settings.radius_media_containers %}{% when 'slightly_rounded' %}var(--radius-slight){% when 'rounded' %}var(--radius-rounded){% when 'extra_rounded' %}var(--radius-extra){% else %}var(--radius-square){% endcase %};
    --radius-tags: {% case settings.radius_tags %}{% when 'slightly_rounded' %}var(--radius-slight){% when 'rounded' %}var(--radius-rounded){% when 'pill' %}var(--radius-pill){% else %}var(--radius-square){% endcase %};
    --radius-drawers: {% case settings.radius_drawers %}{% when 'slightly_rounded' %}var(--radius-slight){% when 'rounded' %}var(--radius-rounded){% when 'extra_rounded' %}var(--radius-extra){% else %}var(--radius-square){% endcase %};
    --radius-bottom-sheets: {% case settings.radius_bottom_sheets %}{% when 'slightly_rounded' %}var(--radius-slight){% when 'rounded' %}var(--radius-rounded){% when 'extra_rounded' %}var(--radius-extra){% else %}var(--radius-square){% endcase %};
    --style-border-radius-small: var(--radius-slight);
    --style-border-radius-medium: var(--radius-media-containers);
    --style-border-radius-large: var(--radius-extra);
    --style-border-radius-inputs: var(--radius-buttons-inputs);
    --border-width: 1px;
    --button-height: {{ settings.button_height_desktop }}px;
    --button-height-mobile: {{ settings.button_height_mobile }}px;
    --button-padding-inline-desktop: {{ settings.button_padding_inline_desktop }}px;
    --button-padding-inline-mobile: {{ settings.button_padding_inline_mobile }}px;
    --button-padding-inline: var(--button-padding-inline-desktop);
    --button-disabled-opacity: {{ settings.button_disabled_opacity | divided_by: 100.0 }};
    --button-font-size: {{ settings.button_font_size }};
    --button-letter-spacing: {% case settings.button_letter_spacing %}{% when 'extra-loose' %}0.12em{% when 'loose' %}0.08em{% when 'relaxed' %}0.04em{% else %}0{% endcase %};
    --button-primary-font-family: {% if settings.button_primary_font == 'heading' %}var(--font-heading-family){% else %}var(--font-body-family){% endif %};
    --button-secondary-font-family: {% if settings.button_secondary_font == 'heading' %}var(--font-heading-family){% else %}var(--font-body-family){% endif %};
    --button-tertiary-font-family: {% if settings.button_tertiary_font == 'heading' %}var(--font-heading-family){% else %}var(--font-body-family){% endif %};
    --button-primary-text-transform: {% if settings.button_primary_text_case == 'uppercase' %}uppercase{% else %}none{% endif %};
    --button-secondary-text-transform: {% if settings.button_secondary_text_case == 'uppercase' %}uppercase{% else %}none{% endif %};
    --button-tertiary-text-transform: {% if settings.button_tertiary_text_case == 'uppercase' %}uppercase{% else %}none{% endif %};
    --button-tertiary-text-decoration: {% if settings.button_tertiary_show_underline %}underline{% else %}none{% endif %};
    --button-radius: var(--radius-buttons-inputs);
    --button-primary-border-width: {{ settings.button_primary_border_width }}px;
    --button-secondary-border-width: {{ settings.button_secondary_border_width }}px;
    --button-border-width: var(--button-primary-border-width);
    --button-tertiary-underline-offset: {{ settings.button_tertiary_underline_offset }}px;
    --swatch-size: {{ settings.swatch_size }}px;
    --swatch-size-mobile: {{ settings.swatch_size_mobile }}px;
    --input-height: {{ settings.input_height_desktop }}px;
    --input-height-mobile: {{ settings.input_height_mobile }}px;
    --input-radius: var(--radius-buttons-inputs);
    --input-border-width: {{ settings.input_border_width }}px;
    --input-background-color: {{ settings.input_background_color }};
    --variant-height: {{ settings.variant_height_desktop }}px;
    --variant-height-mobile: {{ settings.variant_height_mobile }}px;
    --variant-radius: var(--radius-variant-pickers);
    --variant-border-width: var(--input-border-width);
    --variant-group-gap: {{ settings.variant_group_gap }}px;
    --variant-label-spacing: {{ settings.variant_label_spacing }}px;
    --variant-item-gap: {{ settings.variant_item_gap }}px;
    --variant-gap: var(--variant-item-gap);
    --variant-selected-background: var(--color-button);
    --variant-selected-color: var(--color-button-label);
    --variant-unavailable-opacity: 0.5;
    --variant-unavailable-display: inline-flex;
    --variant-sold-out-display: inline-flex;
    --variant-focus-shadow: none;
    --overlay-opacity: 0.4;
    --overlay-backdrop-blur: blur({{ settings.overlay_backdrop_blur }}px);
    --overlay-border-width: {{ settings.overlay_border_width }}px;
    --overlay-radius: var(--radius-drawers);
    --bottom-sheet-radius: var(--radius-bottom-sheets);
    --overlay-shadow: {% case settings.overlay_shadow %}{% when 'extra_small' %}0 1px 2px rgb(0 0 0 / 0.08){% when 'small' %}0 2px 8px rgb(0 0 0 / 0.1){% when 'medium' %}0 4px 16px rgb(0 0 0 / 0.12){% when 'large' %}0 8px 24px rgb(0 0 0 / 0.16){% else %}none{% endcase %};
    --drawer-padding-desktop: {% if settings.drawer_padding_desktop %}24px{% else %}0px{% endif %};
    --drawer-padding-mobile: {% if settings.drawer_padding_mobile %}16px{% else %}0px{% endif %};
    --overlay-title-size: {% case settings.overlay_title_size %}{% when 'heading_3' %}var(--font-heading-lg){% when 'heading_5' %}var(--font-heading-sm){% when 'heading_6' %}var(--font-heading-xs){% else %}var(--font-heading-md){% endcase %};
    --overlay-background: {{ overlay_scheme.settings.background | default: color_scheme.settings.background }};
    --overlay-foreground: {{ overlay_scheme.settings.text | default: color_scheme.settings.text }};
    --icon-thickness: {{ settings.icon_thickness | divided_by: 100.0 }};
    --icon-stroke-width: calc(1.5 * var(--icon-thickness));
    --motion-duration: {% if settings.enable_block_animations %}180ms{% else %}0ms{% endif %};
    --motion-ease: cubic-bezier(0.2, 0, 0, 1);
    --motion-image-zoom: {% if settings.enable_image_zoom_on_hover %}1.04{% else %}1{% endif %};
    --input-background: {% if settings.input_style == 'solid' %}var(--input-background-color){% else %}transparent{% endif %};
    --input-shadow: none;
    --input-label-font-family: {% if settings.input_label_font_role == 'heading' %}var(--font-heading-family){% elsif settings.input_label_font_role == 'accent' %}var(--font-accent-family){% else %}var(--font-body-family){% endif %};
    --input-font-family: {% if settings.input_font_role == 'heading' %}var(--font-heading-family){% elsif settings.input_font_role == 'accent' %}var(--font-accent-family){% else %}var(--font-body-family){% endif %};
    --input-helper-font-family: {% if settings.input_helper_font_role == 'heading' %}var(--font-heading-family){% elsif settings.input_helper_font_role == 'accent' %}var(--font-accent-family){% else %}var(--font-body-family){% endif %};
    --input-error-font-family: {% if settings.input_error_font_role == 'heading' %}var(--font-heading-family){% elsif settings.input_error_font_role == 'accent' %}var(--font-accent-family){% else %}var(--font-body-family){% endif %};
    --swatch-style: {% case settings.swatch_style %}{% when 'image' %}image{% when 'button' %}button{% else %}color{% endcase %};
    --swatch-selected-style: {% case settings.swatch_selected_style %}{% when 'border' %}border{% when 'fill' %}fill{% else %}ring{% endcase %};
    --pcard-content-spacing: {{ settings.product_content_spacing }}px;
    --pcard-content-gap: {{ settings.product_content_gap }}px;
    --pcard-info-gap: {{ settings.product_info_gap }}px;
    --pcard-border-width: {{ settings.product_card_border_width }}px;
    --pcard-shadow: {% case settings.product_card_shadow %}{% when 'strong' %}0 8px 24px rgb(0 0 0 / 0.16){% when 'medium' %}0 4px 16px rgb(0 0 0 / 0.12){% when 'subtle' %}0 2px 8px rgb(0 0 0 / 0.08){% else %}none{% endcase %};
    --pcard-title-font-family: {% if settings.product_title_font == 'body' %}var(--font-body-family){% else %}var(--font-heading-family){% endif %};
    --pcard-title-size: {{ settings.product_title_size }}px;
    --pcard-title-size-mobile: {{ settings.product_title_size_mobile }}px;
    --pcard-title-lines: {% if settings.product_title_line_limit == 'no_limit' %}none{% else %}{{ settings.product_title_line_limit }}{% endif %};
    --pcard-alignment: {{ settings.product_card_alignment }};
    --pcard-image-ratio: {{ settings.product_card_image_ratio }};
    --pcard-swatch-position: {{ settings.product_swatch_position }};
    --pcard-swatch-limit: {{ settings.product_swatch_limit }};
    --pcard-swatch-gap: {{ settings.product_swatch_gap }}px;
    --pcard-swatch-size: {{ settings.product_swatch_width_desktop }}px;
    --pcard-swatch-size-mobile: {{ settings.product_swatch_width_mobile }}px;
    --pcard-swatch-style: {% if settings.product_swatch_style == 'inherit' %}var(--swatch-style){% else %}{{ settings.product_swatch_style }}{% endif %};
    --pcard-swatch-selected-style: {% if settings.product_swatch_selected_style == 'inherit' %}var(--swatch-selected-style){% else %}{{ settings.product_swatch_selected_style }}{% endif %};
    --pcard-quick-add-display: {% if settings.product_enable_quick_add %}inline-flex{% else %}none{% endif %};
    --pcard-quick-add-mobile-display: {% if settings.product_enable_quick_add_mobile %}inline-flex{% else %}none{% endif %};
    --pcard-quick-add-button-width: {% if settings.product_quick_add_full_width %}100%{% else %}auto{% endif %};
    --pcard-quick-view-display: {% if settings.product_enable_quick_view %}inline-flex{% else %}none{% endif %};
    --pcard-quick-view-mobile-display: {% if settings.product_enable_quick_view_mobile %}inline-flex{% else %}none{% endif %};
    --pcard-sale-badge-display: {% if settings.product_show_sale_badge %}inline-flex{% else %}none{% endif %};
    --pcard-sold-out-badge-display: {% if settings.product_show_sold_out_badge %}inline-flex{% else %}none{% endif %};
    --badge-radius: {% case settings.badge_radius_style %}{% when 'rounded' %}var(--radius-md){% when 'pill' %}var(--radius-pill){% else %}0px{% endcase %};
    --badge-sale-price: {{ settings.badge_sale_price }};
    --badge-sale-background: {{ settings.badge_sale_background }};
    --badge-sale-color: {{ settings.badge_sale_text }};
    --badge-sold-out-background: {{ settings.badge_sold_out_background }};
    --badge-sold-out-color: {{ settings.badge_sold_out_text }};
    --badge-custom-background: {{ settings.badge_custom_background }};
    --badge-custom-color: {{ settings.badge_custom_text }};

    {% if color_scheme %}
      --color-background: {{ color_scheme.settings.background }};
      --color-background-gradient: {{ color_scheme.settings.background_gradient }};
      --color-foreground: {{ color_scheme.settings.text }};
      --background-color: {{ color_scheme.settings.background }};
      --heading-color: {{ color_scheme.settings.heading }};
      --heading-highlight-color: {{ color_scheme.settings.heading_highlight }};
      --body-color: {{ color_scheme.settings.text }};
      --accent-color: {{ color_scheme.settings.accent }};
      --border-color: {{ color_scheme.settings.border }};
      --shadow-color: {{ color_scheme.settings.shadow }};
      --sale-price-color: {{ color_scheme.settings.sale_price }};
      --color-button: {{ color_scheme.settings.button }};
      --color-button-label: {{ color_scheme.settings.button_label }};
      --color-button-hover: {{ color_scheme.settings.button_hover }};
      --color-secondary-button: {{ color_scheme.settings.secondary_button }};
      --color-secondary-button-label: {{ color_scheme.settings.secondary_button_label }};
      --color-secondary-button-hover: {{ color_scheme.settings.secondary_button_hover }};
      --color-tertiary-button-label: {{ color_scheme.settings.tertiary_button_label }};
      --color-tertiary-button-border: {{ color_scheme.settings.tertiary_button_border }};
      --color-tertiary-button-hover: {{ color_scheme.settings.tertiary_button_hover }};
      --color-success: {{ color_scheme.settings.success }};
      --color-warning: {{ color_scheme.settings.warning }};
      --color-error: {{ color_scheme.settings.error }};
      --color-sold-out: {{ color_scheme.settings.sold_out }};
      --color-shadow: {{ color_scheme.settings.shadow }};
    {% else %}
      --color-background: #ffffff;
      --color-foreground: #171717;
      --background-color: #ffffff;
      --heading-color: #171717;
      --heading-highlight-color: #171717;
      --body-color: #171717;
      --accent-color: #555555;
      --border-color: #d6d6d6;
      --shadow-color: #171717;
      --sale-price-color: #b42318;
      --color-button: #171717;
      --color-button-label: #ffffff;
      --color-button-hover: #333333;
      --color-secondary-button: #f4f4f4;
      --color-secondary-button-label: #171717;
      --color-secondary-button-hover: #e7e7e7;
      --color-tertiary-button-label: #171717;
      --color-tertiary-button-border: #171717;
      --color-tertiary-button-hover: #f4f4f4;
      --color-success: #067647;
      --color-warning: #b54708;
      --color-error: #b42318;
      --color-sold-out: #667085;
      --color-shadow: #171717;
    {% endif %}
  }
{% endstyle %}
