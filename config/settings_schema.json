    "name": "Variant pickers",
    "settings": [
      { "type": "select", "id": "variant_picker_style", "label": "Variant picker style", "options": [{ "value": "buttons", "label": "Buttons" }, { "value": "dropdown", "label": "Dropdown" }], "default": "buttons" },
