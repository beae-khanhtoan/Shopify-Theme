[
  {
    "name": "theme_info",
    "theme_name": "Shopify Theme Base",
    "theme_version": "0.3.0",
    "theme_author": "BEAE",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "Logo & Favicons",
    "settings": [
      { "type": "image_picker", "id": "logo", "label": "Default logo" },
      { "type": "image_picker", "id": "logo_transparent", "label": "Logo for transparent or overlay backgrounds" },
      { "type": "range", "id": "logo_width", "min": 80, "max": 320, "step": 4, "unit": "px", "label": "Logo width desktop", "default": 160 },
      { "type": "range", "id": "logo_width_mobile", "min": 64, "max": 220, "step": 4, "unit": "px", "label": "Logo width mobile", "default": 120 },
      { "type": "image_picker", "id": "favicon", "label": "Favicon" }
    ]
  },
  {
    "name": "Colors / Scheme colors",
    "settings": [
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "definition": [
          { "type": "color", "id": "background", "label": "Background", "default": "#FFFFFF" },
          { "type": "color_background", "id": "background_gradient", "label": "Background gradient" },
          { "type": "color", "id": "heading", "label": "Heading", "default": "#171717" },
          { "type": "color", "id": "heading_highlight", "label": "Heading highlight", "default": "#171717" },
          { "type": "color", "id": "text", "label": "Body text", "default": "#171717" },
          { "type": "color", "id": "accent", "label": "Accent and eyebrow", "default": "#555555" },
          { "type": "color", "id": "border", "label": "Border", "default": "#D6D6D6" },
          { "type": "color", "id": "shadow", "label": "Shadow", "default": "#171717" },
          { "type": "color", "id": "sale_price", "label": "Sale price", "default": "#B42318" },
          { "type": "color", "id": "button", "label": "Primary button", "default": "#171717" },
          { "type": "color", "id": "button_label", "label": "Primary button label", "default": "#FFFFFF" },
          { "type": "color", "id": "button_hover", "label": "Primary button hover", "default": "#333333" },
          { "type": "color", "id": "secondary_button", "label": "Secondary button", "default": "#F4F4F4" },
          { "type": "color", "id": "secondary_button_label", "label": "Secondary button label", "default": "#171717" },
          { "type": "color", "id": "secondary_button_hover", "label": "Secondary button hover", "default": "#E7E7E7" },
          { "type": "color", "id": "tertiary_button_label", "label": "Tertiary button label", "default": "#171717" },
          { "type": "color", "id": "tertiary_button_border", "label": "Tertiary button border", "default": "#171717" },
          { "type": "color", "id": "tertiary_button_hover", "label": "Tertiary button hover", "default": "#F4F4F4" },
          { "type": "color", "id": "success", "label": "Success", "default": "#067647" },
          { "type": "color", "id": "warning", "label": "Warning", "default": "#B54708" },
          { "type": "color", "id": "error", "label": "Error", "default": "#B42318" },
          { "type": "color", "id": "sold_out", "label": "Sold out", "default": "#667085" }
        ],
        "role": {
          "text": "text",
          "background": { "solid": "background", "gradient": "background_gradient" },
          "links": "accent",
          "icons": "text",
          "primary_button": "button",
          "on_primary_button": "button_label",
          "primary_button_border": "button",
          "secondary_button": "secondary_button",
          "on_secondary_button": "secondary_button_label",
          "secondary_button_border": "border"
        }
      },
      { "type": "checkbox", "id": "enable_gradients", "label": "Enable background gradients", "default": true }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      { "type": "range", "id": "page_width", "min": 960, "max": 1920, "step": 40, "unit": "px", "label": "Page width", "default": 1600 },
      { "type": "range", "id": "page_margin_min", "min": 0, "max": 64, "step": 2, "unit": "px", "label": "Minimum page margin", "default": 16 },
      { "type": "range", "id": "page_margin_desktop", "min": 16, "max": 96, "step": 2, "unit": "px", "label": "Desktop page margin", "default": 48 },
      { "type": "range", "id": "page_margin_tablet", "min": 12, "max": 64, "step": 2, "unit": "px", "label": "Tablet page margin", "default": 30 },
      { "type": "range", "id": "page_margin_mobile", "min": 8, "max": 40, "step": 2, "unit": "px", "label": "Mobile page margin", "default": 16 }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      { "type": "header", "content": "Fonts" },
      { "type": "font_picker", "id": "type_heading_font", "label": "Heading", "default": "work_sans_n4" },
      { "type": "font_picker", "id": "type_primary_font", "label": "Body", "default": "work_sans_n4" },
      { "type": "font_picker", "id": "type_accent_font", "label": "Accent", "default": "work_sans_n4" },
      { "type": "header", "content": "Paragraph" },
      { "type": "range", "id": "body_font_size", "min": 14, "max": 20, "step": 1, "unit": "px", "label": "Base size", "default": 14 },
      { "type": "select", "id": "body_line_height", "label": "Line height", "options": [{ "value": "normal", "label": "Normal" }, { "value": "relaxed", "label": "Relaxed" }, { "value": "loose", "label": "Loose" }], "default": "loose" },
      { "type": "header", "content": "Headings" },
      { "type": "select", "id": "heading_letter_spacing", "label": "Letter spacing", "options": [{ "value": "tight", "label": "Tight" }, { "value": "normal", "label": "Normal" }, { "value": "relaxed", "label": "Relaxed" }], "default": "normal" },
      { "type": "header", "content": "H1 (display)" },
      { "type": "range", "id": "heading_display_size", "min": 40, "max": 96, "step": 2, "unit": "px", "label": "Font size (desktop)", "default": 72 },
      { "type": "range", "id": "heading_display_size_mobile", "min": 28, "max": 64, "step": 2, "unit": "px", "label": "Font size (mobile)", "default": 44 },
      { "type": "select", "id": "heading_display_line_height", "label": "Line height", "options": [{ "value": "tight", "label": "Tight" }, { "value": "normal", "label": "Normal" }, { "value": "relaxed", "label": "Relaxed" }], "default": "tight" },
      { "type": "select", "id": "heading_display_case", "label": "Text case", "options": [{ "value": "none", "label": "Original" }, { "value": "uppercase", "label": "Uppercase" }, { "value": "capitalize", "label": "Capitalize" }], "default": "none" },
      { "type": "header", "content": "H2 (xl)" },
      { "type": "range", "id": "heading_xl_size", "min": 32, "max": 72, "step": 2, "unit": "px", "label": "Font size (desktop)", "default": 48 },
      { "type": "range", "id": "heading_xl_size_mobile", "min": 26, "max": 56, "step": 2, "unit": "px", "label": "Font size (mobile)", "default": 32 },
      { "type": "select", "id": "heading_xl_line_height", "label": "Line height", "options": [{ "value": "tight", "label": "Tight" }, { "value": "normal", "label": "Normal" }, { "value": "relaxed", "label": "Relaxed" }], "default": "tight" },
      { "type": "select", "id": "heading_xl_case", "label": "Text case", "options": [{ "value": "none", "label": "Original" }, { "value": "uppercase", "label": "Uppercase" }, { "value": "capitalize", "label": "Capitalize" }], "default": "none" },
      { "type": "header", "content": "H3 (lg)" },
      { "type": "range", "id": "heading_lg_size", "min": 28, "max": 56, "step": 2, "unit": "px", "label": "Font size (desktop)", "default": 40 },
      { "type": "range", "id": "heading_lg_size_mobile", "min": 24, "max": 44, "step": 2, "unit": "px", "label": "Font size (mobile)", "default": 28 },
      { "type": "select", "id": "heading_lg_line_height", "label": "Line height", "options": [{ "value": "tight", "label": "Tight" }, { "value": "normal", "label": "Normal" }, { "value": "relaxed", "label": "Relaxed" }], "default": "tight" },
      { "type": "select", "id": "heading_lg_case", "label": "Text case", "options": [{ "value": "none", "label": "Original" }, { "value": "uppercase", "label": "Uppercase" }, { "value": "capitalize", "label": "Capitalize" }], "default": "none" },
      { "type": "header", "content": "H4 (md)" },
      { "type": "range", "id": "heading_md_size", "min": 24, "max": 44, "step": 2, "unit": "px", "label": "Font size (desktop)", "default": 32 },
      { "type": "range", "id": "heading_md_size_mobile", "min": 22, "max": 36, "step": 2, "unit": "px", "label": "Font size (mobile)", "default": 24 },
      { "type": "select", "id": "heading_md_line_height", "label": "Line height", "options": [{ "value": "tight", "label": "Tight" }, { "value": "normal", "label": "Normal" }, { "value": "relaxed", "label": "Relaxed" }], "default": "tight" },
      { "type": "select", "id": "heading_md_case", "label": "Text case", "options": [{ "value": "none", "label": "Original" }, { "value": "uppercase", "label": "Uppercase" }, { "value": "capitalize", "label": "Capitalize" }], "default": "none" },
      { "type": "header", "content": "H5 (sm)" },
      { "type": "range", "id": "heading_sm_size", "min": 20, "max": 36, "step": 2, "unit": "px", "label": "Font size (desktop)", "default": 24 },
      { "type": "range", "id": "heading_sm_size_mobile", "min": 18, "max": 30, "step": 2, "unit": "px", "label": "Font size (mobile)", "default": 20 },
      { "type": "select", "id": "heading_sm_line_height", "label": "Line height", "options": [{ "value": "tight", "label": "Tight" }, { "value": "normal", "label": "Normal" }, { "value": "relaxed", "label": "Relaxed" }], "default": "tight" },
      { "type": "select", "id": "heading_sm_case", "label": "Text case", "options": [{ "value": "none", "label": "Original" }, { "value": "uppercase", "label": "Uppercase" }, { "value": "capitalize", "label": "Capitalize" }], "default": "none" },
      { "type": "header", "content": "H6 (xs)" },
      { "type": "range", "id": "heading_xs_size", "min": 16, "max": 28, "step": 2, "unit": "px", "label": "Font size (desktop)", "default": 20 },
      { "type": "range", "id": "heading_xs_size_mobile", "min": 16, "max": 24, "step": 2, "unit": "px", "label": "Font size (mobile)", "default": 18 },
      { "type": "select", "id": "heading_xs_line_height", "label": "Line height", "options": [{ "value": "tight", "label": "Tight" }, { "value": "normal", "label": "Normal" }, { "value": "relaxed", "label": "Relaxed" }], "default": "tight" },
      { "type": "select", "id": "heading_xs_case", "label": "Text case", "options": [{ "value": "none", "label": "Original" }, { "value": "uppercase", "label": "Uppercase" }, { "value": "capitalize", "label": "Capitalize" }], "default": "none" },
      { "type": "header", "content": "Eyebrow" },
      { "type": "range", "id": "eyebrow_font_size", "min": 10, "max": 18, "step": 1, "unit": "px", "label": "Font size", "default": 14 },
      { "type": "select", "id": "eyebrow_line_height", "label": "Line height", "options": [{ "value": "tight", "label": "Tight" }, { "value": "normal", "label": "Normal" }, { "value": "relaxed", "label": "Relaxed" }], "default": "tight" },
      { "type": "select", "id": "eyebrow_letter_spacing", "label": "Letter spacing", "options": [{ "value": "normal", "label": "Normal" }, { "value": "relaxed", "label": "Relaxed" }, { "value": "loose", "label": "Loose" }, { "value": "extra-loose", "label": "Extra loose" }], "default": "extra-loose" },
      { "type": "select", "id": "eyebrow_text_case", "label": "Text case", "options": [{ "value": "none", "label": "Original" }, { "value": "uppercase", "label": "Uppercase" }], "default": "uppercase" }
    ]
  },
  {
    "name": "Button",
    "settings": [
      { "type": "select", "id": "button_radius_style", "label": "Corner radius", "options": [{ "value": "square", "label": "Square" }, { "value": "rounded", "label": "Rounded" }, { "value": "pill", "label": "Pill" }], "default": "square" },
      { "type": "range", "id": "button_height_desktop", "min": 40, "max": 64, "step": 2, "unit": "px", "label": "Desktop height", "default": 48 },
      { "type": "range", "id": "button_height_mobile", "min": 40, "max": 56, "step": 2, "unit": "px", "label": "Button height mobile", "default": 44 },
      { "type": "range", "id": "button_padding_inline_desktop", "min": 12, "max": 32, "step": 2, "unit": "px", "label": "Desktop and tablet horizontal padding", "default": 28 },
      { "type": "range", "id": "button_padding_inline_mobile", "min": 12, "max": 32, "step": 2, "unit": "px", "label": "Mobile horizontal padding", "default": 24 },
      { "type": "range", "id": "button_disabled_opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "label": "Disabled opacity", "default": 60 },
      { "type": "select", "id": "button_font_size", "label": "Font size", "options": [{ "value": "10px", "label": "10px" }, { "value": "12px", "label": "12px" }, { "value": "14px", "label": "14px" }, { "value": "16px", "label": "16px" }, { "value": "18px", "label": "18px" }], "default": "12px" },
      { "type": "select", "id": "button_letter_spacing", "label": "Letter spacing", "options": [{ "value": "normal", "label": "Normal" }, { "value": "relaxed", "label": "Relaxed" }, { "value": "loose", "label": "Loose" }, { "value": "extra-loose", "label": "Extra loose" }], "default": "extra-loose" },
      { "type": "header", "content": "Primary button" },
      { "type": "select", "id": "button_primary_font", "label": "Font", "options": [{ "value": "body", "label": "Body font" }, { "value": "heading", "label": "Heading font" }], "default": "body" },
      { "type": "select", "id": "button_primary_text_case", "label": "Text case", "options": [{ "value": "original", "label": "Original" }, { "value": "uppercase", "label": "Uppercase" }], "default": "uppercase" },
      { "type": "range", "id": "button_primary_border_width", "min": 0, "max": 3, "step": 1, "unit": "px", "label": "Border thickness", "default": 1 },
      { "type": "header", "content": "Secondary button" },
      { "type": "select", "id": "button_secondary_font", "label": "Font", "options": [{ "value": "body", "label": "Body font" }, { "value": "heading", "label": "Heading font" }], "default": "body" },
      { "type": "select", "id": "button_secondary_text_case", "label": "Text case", "options": [{ "value": "original", "label": "Original" }, { "value": "uppercase", "label": "Uppercase" }], "default": "uppercase" },
      { "type": "range", "id": "button_secondary_border_width", "min": 0, "max": 3, "step": 1, "unit": "px", "label": "Border thickness", "default": 1 },
      { "type": "header", "content": "Tertiary button" },
      { "type": "select", "id": "button_tertiary_font", "label": "Font", "options": [{ "value": "body", "label": "Body font" }, { "value": "heading", "label": "Heading font" }], "default": "body" },
      { "type": "select", "id": "button_tertiary_text_case", "label": "Text case", "options": [{ "value": "original", "label": "Original" }, { "value": "uppercase", "label": "Uppercase" }], "default": "uppercase" },
      { "type": "checkbox", "id": "button_tertiary_show_underline", "label": "Show underline", "default": true },
      { "type": "range", "id": "button_tertiary_underline_offset", "min": 0, "max": 8, "step": 1, "unit": "px", "label": "Underline offset", "default": 3 }
    ]
  },
  {
    "name": "Form",
    "settings": [
      { "type": "select", "id": "input_style", "label": "Input style", "options": [{ "value": "solid", "label": "Solid" }, { "value": "outline", "label": "Outline" }], "default": "outline" },
      { "type": "range", "id": "input_height_desktop", "min": 40, "max": 64, "step": 2, "unit": "px", "label": "Desktop height", "default": 48 },
      { "type": "range", "id": "input_height_mobile", "min": 40, "max": 56, "step": 2, "unit": "px", "label": "Mobile height", "default": 44 },
      { "type": "range", "id": "input_radius", "min": 0, "max": 32, "step": 1, "unit": "px", "label": "Border radius", "default": 8 },
      { "type": "range", "id": "input_border_width", "min": 0, "max": 3, "step": 1, "unit": "px", "label": "Input border width", "default": 1 },
      { "type": "color", "id": "input_background_color", "label": "Background color", "default": "#FFFFFF" },
      { "type": "header", "content": "Typography" },
      { "type": "select", "id": "input_label_font_role", "label": "Label", "options": [{ "value": "body", "label": "Body text" }, { "value": "heading", "label": "Heading text" }, { "value": "accent", "label": "Accent text" }], "default": "body" },
      { "type": "select", "id": "input_font_role", "label": "Input", "options": [{ "value": "body", "label": "Body text" }, { "value": "heading", "label": "Heading text" }, { "value": "accent", "label": "Accent text" }], "default": "body" },
      { "type": "select", "id": "input_helper_font_role", "label": "Helper text", "options": [{ "value": "body", "label": "Body text" }, { "value": "heading", "label": "Heading text" }, { "value": "accent", "label": "Accent text" }], "default": "body" },
      { "type": "select", "id": "input_error_font_role", "label": "Error text", "options": [{ "value": "body", "label": "Body text" }, { "value": "heading", "label": "Heading text" }, { "value": "accent", "label": "Accent text" }], "default": "body" }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      { "type": "select", "id": "product_card_style", "label": "Product card style", "options": [{ "value": "standard", "label": "Standard" }, { "value": "card", "label": "Card" }], "default": "standard" },
      { "type": "select", "id": "product_card_image_ratio", "label": "Product image ratio", "options": [{ "value": "adapt", "label": "Adapt" }, { "value": "square", "label": "Square" }, { "value": "portrait", "label": "Portrait" }], "default": "adapt" },
      { "type": "range", "id": "product_title_lines", "min": 1, "max": 4, "step": 1, "unit": "ln", "label": "Product title lines", "default": 2 },
